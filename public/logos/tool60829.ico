:\"Fast\",\"turbo\":\"Turbo\",\"hd\":\"HD\",\"low\":\"Low\",\"medium\":\"Medium\",\"high\":\"High\",\"small\":\"Small\",\"large\":\"Large\",\"single\":\"Single\",\"multi\":\"Multi\",\"general\":\"General\",\"anime\":\"Anime\",\"animate\":\"Animate\",\"replace\":\"Replace\",\"face-image\":\"Face Image\",\"target-face-index\":\"Target Face Index\",\"mask-image\":\"Mask Image\",\"optional-views\":\"Optional Views\",\"back\":\"Back\",\"left\":\"Left\",\"right\":\"Right\",\"front-image\":\"Front Image\",\"back-image\":\"Back Image\",\"left-image\":\"Left Image\",\"right-image\":\"Right Image\",\"generate-type\":\"Generate Type\",\"polygon-type\":\"Polygon Type\",\"topology\":\"Topology\",\"symmetry\":\"Symmetry\",\"polycount\":\"Polycount\",\"remesh\":\"Remesh\",\"pbr-materials\":\"PBR Materials\",\"ta-pose\":\"T/A Pose\",\"texture\":\"Texture\",\"art-style\":\"Art Style\",\"face-count\":\"Face Count\",\"material\":\"Material\",\"quality-and-mesh\":\"Quality \u0026 Mesh\",\"image-prompt-placeholder\":\"A serene landscape with mountains and a lake at sunset...\",\"video-prompt-placeholder\":\"Describe the video you want to generate...\",\"tts-placeholder\":\"Enter text to convert to speech...\",\"tts-long-placeholder\":\"Enter text to convert to speech (supports 600+ languages)...\",\"music-prompt-placeholder\":\"Describe the music you want to generate...\",\"lyrics-placeholder\":\"Enter lyrics (use ## for accompaniment sections)...\",\"lyrics-ace-placeholder\":\"Use [inst] for instrumental...\",\"tags-placeholder\":\"pop, rock, electronic, ambient...\",\"style-prompt-placeholder\":\"e.g. 'R\u0026B Neo-Soul: warm tenor, Rhodes piano, smooth groove, late-night vibe'\",\"style-instruction-placeholder\":\"e.g. 'speak slowly and gently' (optional)\",\"voice-description-placeholder\":\"e.g. 'a warm female voice with a gentle tone'\",\"voice-description-optional-placeholder\":\"e.g. 'a warm female voice with a gentle tone' (optional — auto if empty)\",\"reference-text-placeholder\":\"Transcript of reference audio (optional, improves accuracy)\",\"reference-audio-hint\":\"3–10 seconds recommended\",\"reference-song-hint\":\"MP3, 6 seconds – 6 minutes\",\"prompt-optional-placeholder\":\"Optional — describe the desired output...\",\"sketch-prompt-placeholder\":\"Describe what the sketch represents...\",\"three-d-prompt-placeholder\":\"Describe the 3D model you want to create...\",\"optimize-prompt\":\"Optimize prompt\",\"optimize-text\":\"Optimize text\",\"image-empty-title\":\"No images generated yet\",\"image-empty-description\":\"Enter a prompt and click Generate to create your first AI image\",\"video-empty-title\":\"No videos generated yet\",\"video-empty-description\":\"Enter a prompt and click Generate to create your first AI video\",\"avatar-empty-title\":\"No avatars generated yet\",\"avatar-empty-description\":\"Upload media files and click Generate to create your first avatar video\",\"audio-empty-title\":\"No audio generated yet\",\"audio-empty-description\":\"Enter text or a prompt and click Generate to create audio\",\"three-d-empty-title\":\"No 3D models generated yet\",\"three-d-empty-description\":\"Upload an image or enter a prompt and click Generate to create a 3D model\",\"image-generator-title\":\"Image Generator\",\"video-generator-title\":\"Video Generator\",\"avatar-generator-title\":\"Avatar Generator\",\"audio-generator-title\":\"Audio Generator\",\"three-d-generator-title\":\"3D Generator\",\"add-shot\":\"+ Add Shot\",\"add-element\":\"+ Add Element\",\"shot\":\"Shot\",\"remove\":\"Remove\",\"multi-prompt-shots\":\"Multi-Prompt Shots\",\"multi-prompt-hint\":\"Optional — add shots for multi-segment video generation\",\"element-references\":\"Element References\",\"elements-hint\":\"Optional — paste element IDs for character/object references (max 3)\",\"element-id\":\"Element ID\",\"shot-placeholder\":\"Describe this shot...\",\"sora-duration\":\"Duration (seconds)\",\"seconds-range\":\"{min}–{max} seconds\",\"wan27-edit-duration-same\":\"Same as input\",\"wan27-edit-video-limit\":\"Video duration must not exceed 10 seconds\",\"ktx27-edit-ref-images-hint\":\"Optional — reference images for style/content guidance\",\"kling-o3-ref-images-hint\":\"Optional — reference images for element, scene, or style\",\"kling-o3-ref-video-hint\":\"Optional — reference video for motion/style\",\"last-image-hint\":\"Optional — defines the ending frame\",\"end-image-hint\":\"Optional — sets the final frame of the video\",\"audio-guide-hint\":\"Optional — audio to guide generation\",\"spicy-image-hint\":\"Required — the image to animate\",\"start-image-hint\":\"Optional — animates the image into a video (switches to image-to-video)\",\"seedance2-ref-images-hint\":\"Optional — guide visual style, characters, or scene\",\"seedance2-ref-videos-hint\":\"Optional — total length must not exceed 15 seconds\",\"seedance2-ref-audios-hint\":\"Optional — audio references for sound guidance\",\"z-image-ref-hint\":\"Optional — guides the generation style\",\"infinite-talk-image-hint\":\"The face/person image to animate\",\"infinite-talk-video-hint\":\"The video to lip-sync\",\"infinite-talk-audio-hint\":\"The driving audio (speech or singing)\",\"infinite-talk-mask-hint\":\"Optional — draw or upload a mask to specify which person to animate\",\"kling-motion-ref-hint\":\"Motion reference video (3–30s)\",\"swap-width-height\":\"Swap width and height\",\"range\":\"Range\",\"model\":\"Model\",\"all-tools\":\"All Tools\",\"all-apps\":\"All Apps\",\"settings\":\"Settings\",\"prompt\":\"Prompt\",\"negative-prompt\":\"Negative Prompt\",\"things-to-avoid\":\"Things to avoid...\",\"reference-images\":\"Reference Images\",\"reference-image\":\"Reference Image\",\"reference-video\":\"Reference Video\",\"start-image\":\"Start Image\",\"end-image\":\"End Image\",\"aspect-ratio\":\"Aspect Ratio\",\"resolution\":\"Resolution\",\"format\":\"Format\",\"output-format\":\"Output Format\",\"target-resolution\":\"Target Resolution\",\"size\":\"Size\",\"seed\":\"Seed\",\"quality\":\"Quality\",\"duration\":\"Duration\",\"strength\":\"Strength\",\"speed\":\"Speed\",\"pitch\":\"Pitch\",\"voice\":\"Voice\",\"language\":\"Language\",\"text\":\"Text\",\"lyrics\":\"Lyrics\",\"emotion\":\"Emotion\",\"mode\":\"Mode\",\"image-search\":\"Image Search\",\"web-search\":\"Web Search\",\"input-fidelity\":\"Input Fidelity\",\"input-fidelity-hint\":\"Higher preserves more detail from input images\",\"strength-hint\":\"How much to deviate from the reference image\",\"let-model-decide\":\"Let model decide\",\"standard\":\"Standard\",\"pro\":\"Pro\",\"edit-mode-hint\":\"Using edit mode — images guide the generation\",\"edit-mode-optional\":\"Optional — add images to enable edit mode\",\"delete-confirm\":\"Are you sure you want to delete this?\",\"cancel\":\"Cancel\",\"delete\":\"Delete\",\"deleted-successfully\":\"Deleted successfully\",\"delete-failed\":\"Failed to delete\",\"view-details\":\"View details\",\"apps\":\"Apps\",\"type\":\"Type\",\"what-should-character-say\":\"What should your character say?\",\"additional-details-optional\":\"Additional details (optional)\",\"generate-video-label\":\"Generate Video\",\"generate-image-label\":\"Generate Image\",\"loading-model\":\"Loading Model...\",\"nsfw-content\":\"NSFW content\",\"share-your-work\":\"Share your work\",\"copy\":\"Copy\",\"copied-to-clipboard\":\"Copied to clipboard\",\"share-submitted\":\"Your submission has been received. You can check its status in Shared Requests under Run History.\",\"share-submit-failed\":\"Failed to submit your request. Please try again later.\",\"clear\":\"Clear\",\"apply\":\"Apply\",\"expand\":\"Expand\",\"edit-your-input-text\":\"Edit your input text\",\"select-all\":\"Select all\",\"deselect-all\":\"Deselect all\",\"n-selected\":\"{count} selected\",\"download-progress\":\"Downloading {current}/{total}\",\"confirm-download-many\":\"Download {count} files? Some browsers may throttle large batches.\",\"select-multiple\":\"Select multiple\",\"share-public-link\":\"Public link\",\"share-feature-title\":\"Submit as example\",\"share-feature-desc\":\"Apply to have your work showcased as an example for this model.\",\"avatar-model-longcat-avatar-1-5-name\":\"LongCat Avatar 1.5\",\"avatar-model-longcat-avatar-1-5-desc\":\"Convert one photo plus audio into a talking or singing avatar video, up to 64 seconds at 480p / 720p.\",\"avatar-model-pixverse-motion-mimic-name\":\"PixVerse Motion Mimic\",\"avatar-model-pixverse-motion-mimic-desc\":\"PixVerse's motion transfer model — animate a still image by mimicking motion from a reference video. Outputs 360p / 540p / 720p.\"},\"HuggingFace\":{\"title\":\"Create a Hugging Face Repository\",\"access-token\":\"Access Token\",\"access-token-placeholder\":\"Enter your access token\",\"repository\":\"Repository\",\"repository-placeholder\":\"Enter your repository\",\"description\":\"Description\",\"description-placeholder\":\"Enter your description\",\"instance-prompt\":\"Instance Prompt\",\"instance-prompt-placeholder\":\"Enter your instance prompt\",\"instance-prompt-helper\":\"The prompt to trigger the model to generate an image.\",\"access\":\"Access\",\"access-placeholder\":\"Select your access\",\"public\":\"Public\",\"private\":\"Private\",\"created-success\":\"Hugging Face Repository created successfully\",\"created-success-subtitle\":\"Your LoRA is now available on Hugging Face.\",\"view-repository\":\"View Repository\",\"cancel\":\"Cancel\",\"create-repository\":\"Create Repository\",\"creating\":\"Creating...\",\"fill-all-fields\":\"Please fill in all fields\",\"create-success\":\"Create repository successfully\",\"create-failed\":\"Create repository failed\"},\"Uploader\":{\"drag-drop-or-upload\":\"Drag \u0026 drop or click to upload\",\"hint-drag-drop\":\"Hint: You can drag and drop a file or click to upload\",\"drop-file-here\":\"Drop file here\",\"add-item\":\"Add Item\",\"upload-failed\":\"Upload failed\",\"please-login-to-upload\":\"Please login to upload files\",\"please-login-to-record\":\"Please login to record audio\",\"min-items-error\":\"You need at least {count} items\",\"max-items-error\":\"You can only add up to {count} items\",\"pick-from-library\":\"Pick from library\",\"upload-from-device\":\"Upload from device\",\"remove\":\"Remove\",\"cancel-upload\":\"Cancel upload\",\"upload-cancelled\":\"Upload cancelled\"},\"GeneratorNav\":{\"home\":\"Home\",\"dashboard\":\"Dashboard\",\"image\":\"Image\",\"video\":\"Video\",\"avatar\":\"Avatar\",\"audio\":\"Audio\",\"three-d\":\"3D\",\"tools\":\"Tools\",\"apps\":\"Apps\"},\"ToolClient\":{\"image_upscaler\":{\"empty_title\":\"No upscaled images yet\",\"empty_description\":\"Upload an image and click Generate to upscale it\"},\"video_upscaler\":{\"empty_title\":\"No upscaled videos yet\",\"empty_description\":\"Upload a video and click Generate to upscale it\"},\"image_watermark_remover\":{\"empty_title\":\"No results yet\",\"empty_description\":\"Upload an image and click Generate to remove watermarks\"},\"video_watermark_remover\":{\"empty_title\":\"No results yet\",\"empty_description\":\"Upload a video and click Generate to remove watermarks\",\"video_supports_10_min_hint\":\"Supports videos up to 10 minutes\"},\"image_face_swap\":{\"empty_title\":\"No results yet\",\"empty_description\":\"Upload an image and a face reference to swap faces\",\"target_image\":\"Target Image\",\"image_face_to_replace_hint\":\"Image containing the face you want to replace\",\"face_reference\":\"Face Reference\",\"face_to_swap_in_hint\":\"Image containing the face to swap in\",\"target_face_index\":\"Target Face Index\"},\"video_face_swap\":{\"empty_title\":\"No results yet\",\"empty_description\":\"Upload a video and a face reference to swap faces\",\"target_video\":\"Target Video\",\"video_face_to_replace_hint\":\"Video containing the face you want to replace\",\"face_reference\":\"Face Reference\",\"face_to_swap_in_hint\":\"Image containing the face to swap i