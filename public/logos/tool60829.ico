ck upload\",\"invalid-url\":\"Please paste a valid http(s) URL\",\"url-fetch-failed\":\"Couldn't fetch that URL. Drag the file directly instead.\",\"search-placeholder\":\"Search by name\",\"sort-created-at\":\"Date created\",\"sort-file-name\":\"File name\",\"sort-file-size\":\"File size\",\"sort-asc\":\"Ascending\",\"sort-desc\":\"Descending\",\"loading\":\"Loading…\",\"empty\":\"You haven't uploaded any assets yet.\",\"load-failed\":\"Failed to load your assets. Please try again.\",\"upload-success\":\"Upload successful.\",\"upload-failed\":\"Upload failed. Please try again.\",\"unsupported-file-type\":\"Only image, video, and audio files are accepted.\",\"file-too-large\":\"File size exceeds the {max} MB limit.\",\"max-assets-reached\":\"You have reached the limit of {max} assets. Please delete some before uploading new ones.\",\"delete-aria-label\":\"Delete asset\",\"delete-confirm-title\":\"Delete this asset?\",\"delete-confirm-description\":\"This action cannot be undone. The file will be permanently removed from your library.\",\"delete-success\":\"Deleted successfully.\",\"delete-failed\":\"Failed to delete. Please try again.\",\"deleting\":\"Deleting…\",\"delete\":\"Delete\",\"cancel\":\"Cancel\",\"usage-summary\":\"{used} of {max} assets\",\"limits\":\"Max {max} MB per file\",\"rename-aria-label\":\"Rename\",\"rename-save-aria\":\"Save new name\",\"rename-cancel-aria\":\"Cancel rename\",\"rename-success\":\"Renamed successfully.\",\"rename-failed\":\"Rename failed.\",\"rename-extension-mismatch\":\"The file extension cannot be changed.\",\"tab-recent\":\"Recent\",\"tab-all\":\"All\",\"tab-image\":\"Images\",\"tab-video\":\"Videos\",\"tab-audio\":\"Audio\",\"empty-in-tab\":\"No assets of this type. Try a different tab or upload one.\",\"empty-recent\":\"No recently used assets yet. Pick one in an upload field to see it here.\",\"sort-disabled-while-searching\":\"Sort is disabled while searching — results are ranked by relevance.\",\"sort-disabled-on-recent\":\"Sort is disabled on Recent — items are ordered by most recently used.\",\"clear-recents\":\"Clear\",\"clear-recents-confirm-title\":\"Clear recently used?\",\"clear-recents-confirm-description\":\"This only removes the local list of recently picked assets on this device. Your uploaded files are not affected.\",\"recents-cleared\":\"Recently used cleared.\",\"policy-title\":\"About your asset library\",\"policy-allowed-types\":\"Allowed file types: image, video, and audio only. Up to {max} MB per file and {count} files per account.\",\"policy-paid-only\":\"Asset upload requires a paid account. Top up at least once to unlock this feature.\",\"policy-retention\":\"Your uploaded files are saved while you're using your account. If you don't sign in or visit for 180 days, they're deleted.\",\"policy-storage\":\"Uploaded files are stored on our CDN and served from URLs we control. They're only used as input to AI models you run.\",\"policy-deletion\":\"You can delete any asset at any time. The file is removed from our storage immediately; cached copies on the CDN may take up to a day to expire.\",\"policy-privacy\":\"Your assets are private to your account. Other users — even within the same organization — cannot see or list them.\",\"cancel-upload\":\"Cancel upload\",\"upload-cancelled\":\"Upload cancelled\"},\"EarlyAccess\":{\"title\":\"Request Early Access\",\"description\":\"This model is in early access. Please submit an early access application to use it.\",\"first-name-placeholder\":\"First name\",\"last-name-placeholder\":\"Last name\",\"company-name-placeholder\":\"Company name\",\"phone-number-placeholder\":\"Phone number\",\"country-placeholder\":\"Country\",\"company-size-placeholder\":\"Company size\",\"message-placeholder\":\"Tell us about your project and requirements...\",\"first-name-required\":\"First name is required\",\"first-name-min-length\":\"First name must be at least 2 characters\",\"last-name-required\":\"Last name is required\",\"last-name-min-length\":\"Last name must be at least 2 characters\",\"company-name-required\":\"Company name is required\",\"phone-number-required\":\"Phone number is required\",\"country-required\":\"Please select your country\",\"company-size-required\":\"Please select your company size\",\"message-required\":\"Message is required\",\"message-min-length\":\"Message must be at least 10 characters\",\"submit-success\":\"Request submitted. Our team will reach out soon.\",\"submit-failed\":\"Failed to submit request. Please try again.\",\"submit\":\"Submit\",\"submitting\":\"Submitting\"},\"Studio\":{\"your-generation-will-appear-here\":\"Your past 7 day’s generations will appear here.\",\"your-generations-will-be-saved-for-7-days\":\"Your generations are stored for 7 days only. Make sure to download and save them before they expire.\",\"nano-banan2-is-coming\":\"Nano Banana Pro is available now.\",\"prompt-has-been-set-to-the-input-field\":\"Prompt has been set to the input field\",\"experience-now\":\"Experience Now\"},\"Home\":{\"ultimate-ai-media-generation-platform\":\"Ultimate AI Media \u003cbr\u003e\u003c/br\u003e Generation Platform\",\"wave-speed-ai-accelerates-ai-image-and-video-generation\":\"WaveSpeedAI accelerates AI Image and Video generation for you to build, create, and scale faster.\",\"explore-models\":\"Explore Models\",\"api-doc\":\"View Documentation\",\"featured-models\":\"Featured Models\",\"get-any-tool-you-want\":\"Get any tool you want\",\"fast\":\"Fast\",\"blazing-fast-image-and-video-generation-to-maximize-your-productivity\":\"Blazing fast image and video generation to maximize your productivity.\",\"vast\":\"Vast\",\"integrate-all-cutting-edge-sota-ai-models-in-one-api\":\"Integrate all cutting edge SOTA AI models in one API.\",\"efficient\":\"Efficient\",\"best-prices-without-any-sacrifice-for-quality-and-reliability\":\"Best prices without any sacrifice for quality and reliability\",\"multimodal-ai-tools\":\"Multimodal AI Tools\",\"unlock-image-video-and-voice-generation-from-text-image-or-audio-all-in-one-place\":\"Unlock image, video, and voice generation from text, image, or audio — all in one place.\",\"explore-more\":\"Explore More\",\"latest-ai-models\":\"Latest AI Models\",\"try-the-newest-multimodal-models-before-anyone-else\":\"Try the newest multimodal models before anyone else.\",\"latest\":\"Latest\",\"apis-for-scale\":\"APIs for Scale\",\"integrate-powerful-image-and-video-generation-into-your-app-or-platform-via-wave-speed-apis\":\"Integrate powerful image and video generation into your app or platform via WaveSpeed APIs.\",\"run-api\":\"Run API\",\"what-people-are-saying\":\"What people are saying\",\"unlock-your-potential\":\"Unlock Your AI Potential Today\",\"start-building\":\"Start Building\",\"built-for-developers\":\"Built For Developers\",\"built-for-developers-desc\":\"Integrate any model with a single API call. Node, Python, or cURL — ship in minutes, not days.\",\"api-docs\":\"Documentation\",\"quickstart\":\"Quickstart\",\"and-for-creators\":\"And For Creators\",\"and-for-creators-desc\":\"WaveSpeed Desktop brings the full power of AI media generation to your desktop — no code, no setup, just create.\",\"download-app\":\"Download App\",\"try-studio\":\"Try Studio\",\"engineered-for-velocity\":\"Engineered for Velocity\",\"engineered-for-velocity-desc\":\"WaveSpeedAI is the ultimate AI media generation platform — easy to use, affordable, scalable, and fast.\",\"vast-model-library\":\"Vast Model Library\",\"vast-model-library-desc\":\"Access 1000+ image, video, audio, and LLM models from one unified platform with a single API key.\",\"blazing-fast-inference\":\"Blazing Fast Inference\",\"blazing-fast-inference-desc\":\"Optimized GPU clusters deliver sub-second image generation and up to 4x faster video rendering than alternatives.\",\"built-for-scale\":\"Built for Scale\",\"built-for-scale-desc\":\"From a single image to millions of requests — enterprise-grade infrastructure that grows with you, with 99.99% uptime.\",\"security\":\"Security\",\"security-desc\":\"SOC 2 Type II compliant with end-to-end encryption and private VPC deployment options.\",\"explore-all-models\":\"Explore All 1000+ models\",\"video-super-resolution-upscaler\":\"Video Super-Resolution Upscaler\",\"all-in-one-video-creation-and-editing\":\"All-in-one Video Creation and Editing\",\"video-effects\":\"Video Effects\",\"photo-effects\":\"Photo Effects\",\"view-all\":\"View all\",\"try-it\":\"Try it\"},\"HeroSlideshow\":{\"explore-models\":\"Explore Models\",\"documentation\":\"Documentation\",\"try-model\":\"Try Model\",\"explore-collection\":\"Explore Collection\",\"try-in-generator\":\"Try in AI Generator\",\"badge-new-model\":\"New Model\",\"slide-1-title\":\"Ultimate AI Media\\nGeneration Platform\",\"slide-1-description\":\"With \u003cbold\u003e1000+ top-tier\u003c/bold\u003e models, WaveSpeedAI is the most powerful platform for AI image and video generation — built to help you create faster and scale without limits.\",\"slide-2-title\":\"GPT Image 2\",\"slide-2-description\":\"A \\\"thinking\\\" image model that better understands prompts and produces highly consistent, text-accurate, production-ready visuals.\",\"slide-3-title\":\"Seedance 2.0\",\"slide-3-description\":\"Cinematic video generation with native audio, director-level control, and exceptional motion stability.\",\"slide-4-title\":\"Nano Banana 2\",\"slide-4-description\":\"Fast, high-quality image generation with strong consistency and real-world awareness.\",\"slide-5-title\":\"Vidu Q3 Pro\",\"slide-5-description\":\"Vidu Q3 Image-to-Video Pro generates high-resolution videos (720p/1080p/2K/4K) from images with exceptional visual fidelity and diverse motion. Ready-to-use REST inference API, best performance, no coldstarts, affordable pricing.\"},\"Tools\":{\"page-title\":\"AI Image \u0026 Video Tools\",\"page-subtitle\":\"Upscale to 4K, remove watermarks, enhance — professional results in seconds, free to start.\",\"faq-heading\":\"Frequently Asked Questions\",\"faq-1-q\":\"What tools are available?\",\"faq-1-a\":\"We offer image and video upscalers (up to 8K), watermark removers for images and videos, and more — all powered by AI.\",\"faq-2-q\":\"Are the tools free to use?\",\"faq-2-a\":\"Yes! You get free credits on signup. Most tools cost just a few cents per use — no subscription required.\",\"faq-3-q\":\"Do the tools add watermarks to my output?\",\"faq-3-a\":\"No. All output is clean and watermark-free. What you generate is yours to use.\",\"faq-4-q\":\"Can I use these tools via API?\",\"faq-4-a\":\"Yes! Every tool has a REST API endpoint. Integrate upscaling, watermark removal, and more into your own apps with a few lines of code.\",\"explore-models-card-title\":\"Explore 1,000+ AI Models\",\"explore-models-card-desc\":\"Browse our full catalog of state-of-the-art AI models — image, video, 3D, audio, LLM, and more.\",\"build-api-card-title\":\"Build with the API\",\"build-api-card-desc\":\"Integrate AI tools into your own apps. RESTful API with client libraries — no cold starts, pay per use.\",\"ready-heading\":\"Ready to Get Started?\",\"ready-subtitle\":\"Try any tool for free. No credit card required.\",\"image-upscaler-name\":\"Image Upscaler\",\"image-upscaler-desc\":\"Upscale images to 2K, 4K, or 8K resolution with AI enhancement — improve detail and clarity.\",\"video-upscaler-name\":\"Video Upscaler\",\"video-upscaler-desc\":\"Upscale videos to 4K with AI — crisp footage, seamless motion dynamics, and frame consistency.\",\"image-watermark-remover-name\":\"Image Watermark Remover\",\"image-watermark-remover-desc\":\"Remove text and logo watermarks from images while preserving texture and background.\",\"video-watermark-remover-name\":\"Video Watermark Remover\",\"video-watermark-remover-desc\":\"Remove watermarks, logos, and captions from videos up to 10 minutes while preserving quality.\",\"image-face-swap-name\":\"Image Face Swap\",\"image-face-swap-desc\":\"Instantly swap faces in photos with AI. No watermark, multi-face targeting.\",\"video-face-swap-name\":\"Video Face Swap\",\"video-face-swap-desc\":\"Swap faces in any video — seamless, unlimited face replacements with AI.\",\"image-background-remover-name\":\"Image Background Remover\",\"image-background-remover-desc\":\"Remove image backgrounds instantly — high-quality transparent PNGs for e-commerce and design.\",\"video-background-remover-name\":\"Video Background Remover\",\"video-background-remover-desc\":\"Remove or replace video backgrounds with AI — clean matting and natural compositing.\",\"image-eraser-name\":\"Image Eraser\",\"image-eraser-desc\":\"Remove objects, people, or text from images — AI reconstructs the background naturally.\",\"video-eraser-name\":\"Video Eraser\",\"video-eraser-desc\":\"Remove unwanted objects or people from videos while preserving quality — up to 10 minutes.\",\"video-fps-increaser-name\":\"Video FPS Increaser\",\"video-fps-increaser-desc\":\"Double your video frame rate with AI for smoother motion and better playback quality.\",\"flashvsr-name\":\"FlashVSR Video Upscaler\",\"flashvsr-desc\":\"Fast, high-quality video upscaler — boost resolution and restore clarity for low-res or blurry footage.\"},\"Apps\":{\"page-title\":\"AI Apps\",\"page-subtitle\":\"Ready-to-use AI experiences — try-on, music videos, photo effects, and more.\",\"faq-heading\":\"Frequently Asked Questions\",\"see-all\":\"See all\",\"section-results\":\"Results\",\"no-results\":\"No results found for “{query}”\",\"section-professional\":\"Professional\",\"section-professional-desc\":\"Camera effects, transitions, and professional post-production tools\",\"section-enhance-style\":\"Enhance \u0026 Style\",\"section-enhance-style-desc\":\"Fashion, lighting, and visual enhancement tools\",\"section-face-identity\":\"Face \u0026 Identity\",\"section-face-identity-desc\":\"Character swap, face swap, and identity transformation tools\",\"section-video-editing\":\"Video Editing\",\"section-video-editing-desc\":\"Creative video effects, transitions, and editing tools\",\"section-ads\":\"Ads \u0026 Products\",\"section-ads-desc\":\"Create professional video and image ads instantly\",\"section-games-characters\":\"Games \u0026 Characters\",\"section-games-characters-desc\":\"Gaming styles, 3D figures, pixel art, and character transformations\",\"section-trending\":\"Trending Templates\",\"section-trending-desc\":\"Viral effects, meme styles, and creative transformations\",\"section-extras\":\"Extras\",\"section-extras-desc\":\"More creative tools to explore\",\"hero-title\":\"AI Tools for \u003chighlight\u003eCreators \u0026 Marketers\u003c/highlight\u003e\",\"hero-subtitle\":\"One-click AI effects that transform any content into professional ads, viral trends, or artistic masterpieces.\",\"search-placeholder\":\"Search\",\"tab-all\":\"All\",\"virtual-try-on-name\":\"Virtual Try-On\",\"virtual-try-on-desc\":\"See how any outfit looks on you — upload a photo and clothing images for AI fitting.\",\"ai-kissing-name\":\"AI Kissing Video\",\"ai-kissing-desc\":\"Turn one or two photos into a romantic kissing video.\",\"ai-twerk-name\":\"AI Twerk Video\",\"ai-twerk-desc\":\"Turn any photo into a fun twerking dance video.\",\"ai-instagram-model-name\":\"AI Instagram Model\",\"ai-instagram-model-desc\":\"Generate Instagram-style photos — 10 style presets from influencer to cyberpunk.\",\"ai-dancing-name\":\"AI Dancing Video\",\"ai-dancing-desc\":\"Turn any photo into a dancing video with a reference dance clip.\",\"ai-music-video-name\":\"AI Music Video\",\"ai-music-video-desc\":\"Audio + photo → full music video with cinematic angles and lip sync.\",\"ai-video-editor-name\":\"AI Video Editor\",\"ai-video-editor-desc\":\"Select timeline segments, preview reference images, then render an AI-edited video.\",\"ai-breast-expansion-name\":\"AI Breast Expansion\",\"ai-breast-expansion-desc\":\"Transform portrait photos with an exaggerated effect.\",\"ai-image-translator-name\":\"AI Image Translator\",\"ai-image-translator-desc\":\"Translate text in images to 30+ languages preserving style.\",\"ai-camera-angle-name\":\"AI Camera Angle\",\"ai-camera-angle-desc\":\"Generate multi-angle views from a single image.\",\"ai-breast-expansion-page-title\":\"AI Breast Expansion\",\"ai-camera-angle-page-title\":\"AI Camera Angle Control\",\"ai-dancing-page-title\":\"AI Dancing Video Generator\",\"ai-image-translator-page-title\":\"AI Image Translator\",\"ai-instagram-model-page-title\":\"AI Instagram Model\",\"ai-kissing-page-title\":\"AI Kissing Video Generator\",\"ai-music-video-page-title\":\"AI Music Video Generator\",\"ai-twerk-page-title\":\"AI Twerk Video Generator\",\"virtual-try-on-page-title\":\"Virtual Try-On\"},\"Templates\":{\"professional-angles-name\":\"Angles\",\"professional-angles-desc\":\"Generate new camera angles from a single photo — rotate, tilt, and shift perspective.\",\"professional-whats-next-name\":\"What's Next\",\"professional-whats-next-desc\":\"Explore what happens next in your scene — AI generates narrative continuations from a single image.\",\"professional-shots-name\":\"Shots\",\"professional-shots-desc\":\"Transform one photo into unique cinematic shots — different compositions and camera positions.\",\"professional-zooms-name\":\"Zooms\",\"professional-zooms-desc\":\"Create dynamic zoom variations — from macro close-ups to wide-angle perspectives, all from one image.\",\"professional-behind-the-scenes-name\":\"Behind the Scenes\",\"professional-behind-the-scenes-desc\":\"Turn any photo into a behind-the-scenes film set reveal — cameras, crew, and the magic of filmmaking.\",\"professional-transitions-name\":\"Transitions\",\"professional-transitions-desc\":\"Create seamless transitions between two images — smooth morphs, wipes, and cinematic scene changes.\",\"professional-expand-image-name\":\"Expand Image\",\"professional-expand-image-desc\":\"Expand any image beyond its edges — AI outpainting that seamlessly extends your scene.\",\"professional-color-grading-name\":\"Color Grading\",\"professional-color-grading-desc\":\"Apply professional cinematic color grading — film-quality tones, moods, and atmospheres.\",\"enhance-style-ai-stylist-name\":\"AI Stylist\",\"enhance-style-ai-stylist-desc\":\"Your AI fitting room — try on outfits, change poses, and swap backgrounds instantly.\",\"enhance-style-relight-name\":\"Relight\",\"enhance-style-relight-desc\":\"Adjust lighting position, color temperature, and brightness to perfect any photo.\",\"enhance-style-skin-enhancer-name\":\"Skin Enhancer\",\"enhance-style-skin-enhancer-desc\":\"Smooth skin and remove blur from portraits — natural, realistic skin textures.\",\"enhance-style-outfit-swap-name\":\"Outfit Swap\",\"enhance-style-outfit-swap-desc\":\"Try on any outfit with a single photo — transfer clothing from a reference image.\",\"enhance-style-style-snap-name\":\"Style Snap\",\"enhance-style-style-snap-desc\":\"Transform your look with instant style variations — swap outfits while keeping your pose.\",\"enhance-style-outfit-vending-name\":\"Outfit Vending\",\"enhance-style-outfit-vending-desc\":\"Display your outfit breakdown in an illuminated vending machine — AI deconstructs every item.\",\"enhance-style-glitter-sticker-name\":\"Glitter Sticker\",\"enhance-style-glitter-sticker-desc\":\"Turn your portrait into a sparkling holographic sticker on a gritty urban surface.\",\"enhance-style-outfit-shot-name\":\"Outfit Shot\",\"enhance-style-outfit-shot-desc\":\"Transform outfits into a professional AI avatar photoshoot with natural poses.\",\"face-identity-recast-name\":\"Recast\",\"face-identity-recast-desc\":\"Industry-leading character swap for any video — replace the entire persona including body and motion.\",\"face-identity-character-swap-name\":\"Character Swap\",\"face-identity-character-swap-desc\":\"Seamlessly place a new character into any scene — maintain identity across different poses and settings.\",\"face-identity-face-swap-name\":\"Face Swap\",\"face-identity-face-swap-desc\":\"Instant AI face swap for photos — seamlessly integrate new faces into any image.\",\"face-identity-commercial-faces-name\":\"Commercial Faces\",\"face-identity-commercial-faces-desc\":\"Generate ad-ready spokesperson imagery — professional face transformations for marketing.\",\"face-identity-video-face-swap-name\":\"Video Face Swap\",\"face-identity-video-face-swap-desc\":\"Best-in-class face swapping for any video — frame-by-frame accuracy with natural blending.\",\"face-identity-headshot-generator-name\":\"Headshot Generator\",\"face-identity-headshot-generator-desc\":\"Studio-quality professional headshots in seconds — no photoshoot needed.\",\"video-editing-clipcut-name\":\"ClipCut\",\"video-editing-clipcut-desc\":\"Turn one selfie into an instant outfit reel — AI-generated fashion montage synced to music.\",\"video-editing-urban-cuts-name\":\"Urban Cuts\",\"video-editing-urban-cuts-desc\":\"Next-gen beat-synced AI outfit videos — dynamic cuts perfectly timed to music.\",\"video-editing-sticker-matchcut-name\":\"Sticker Match Cut\",\"video-editing-sticker-matchcut-desc\":\"Turn any clip into a sparkling sticker animation — glittering holographic sticker frames.\",\"video-editing-breakdown-name\":\"Breakdown\",\"video-editing-breakdown-desc\":\"Split any image into its individual components — AI identifies objects, brands, and items.\",\"video-editing-japanese-show-name\":\"Japanese Show\",\"video-editing-japanese-show-desc\":\"Turn your photo into a retro 2000s Japanese variety show scene — CRT scanlines and broadcast effects.\",\"video-editing-video-bg-remover-name\":\"Video Background Remover\",\"video-editing-video-bg-remover-desc\":\"Upload any video and instantly strip the background — clean, frame-perfect results.\",\"games-characters-game-dump-name\":\"Game Dump\",\"games-characters-game-dump-desc\":\"Transform yourself into iconic video game styles — become a gaming hero with in-game UI overlays.\",\"games-characters-nano-strike-name\":\"Nano Strike\",\"games-characters-nano-strike-desc\":\"AI tactical shooter character — transform into a battle-ready operator with full gear.\",\"games-characters-nano-theft-name\":\"Nano Theft\",\"games-characters-nano-theft-desc\":\"See yourself in a realistic open-world crime game style — GTA-inspired character art.\",\"games-characters-simlife-name\":\"Simlife\",\"games-characters-simlife-desc\":\"Transform into a stylized life simulation character — The Sims-inspired avatar.\",\"games-characters-plushies-name\":\"Plushies\",\"games-characters-plushies-desc\":\"Transform any photo into an adorable plushie-style character — soft toy animation.\",\"games-characters-3d-render-name\":\"3D Render\",\"games-characters-3d-render-desc\":\"Turn any photo into a stunning 3D rendered object with professional lighting.\",\"games-characters-3d-figure-name\":\"3D Figure\",\"games-characters-3d-figure-desc\":\"Transform your photo into a detailed 3D collectible figure — action figure style.\",\"games-characters-pixel-game-name\":\"Pixel Game\",\"games-characters-pixel-game-desc\":\"Turn your photo into retro pixel game graphics — 8-bit and 16-bit art styles.\",\"games-characters-brick-cube-name\":\"Brick Cube\",\"games-characters-brick-cube-desc\":\"Transform your photo into a brick cube toy — LEGO-inspired block figure.\",\"games-characters-sketch-to-real-name\":\"Sketch to Real\",\"games-characters-sketch-to-real-desc\":\"Turn your sketch into a realistic video scene — hand-drawn doodles come to life.\",\"ads-click-to-ad-name\":\"Click to Ad\",\"ads-click-to-ad-desc\":\"Character interacts with your product in a dynamic video ad.\",\"ads-asmr-add-on-name\":\"ASMR Add-On\",\"ads-asmr-add-on-desc\":\"Character whispers about your product in an intimate ASMR video.\",\"ads-asmr-classic-name\":\"ASMR Classic\",\"ads-asmr-classic-desc\":\"Classic ASMR product video — gentle touching, tapping, and rotating.\",\"ads-poster-name\":\"Poster\",\"ads-poster-desc\":\"Generate a professional marketing poster for your product.\",\"ads-bullet-time-scene-name\":\"Bullet Time Scene\",\"ads-bullet-time-scene-desc\":\"Freeze-frame bullet-time effect with character and product.\",\"ads-chameleon-name\":\"Chameleon\",\"ads-chameleon-desc\":\"Character transforms to match your product's brand aesthetic.\",\"ads-asmr-host-name\":\"ASMR Host\",\"ads-asmr-host-desc\":\"Hosted ASMR product presentation with whispering narration.\",\"ads-packshot-name\":\"Packshot\",\"ads-packshot-desc\":\"Polished product showcase with smooth rotation and studio lighting.\",\"ads-macro-scene-name\":\"Macro Scene\",\"ads-macro-scene-desc\":\"Extreme close-up revealing product details and textures.\",\"ads-magic-button-name\":\"Magic Button\",\"ads-magic-button-desc\":\"Product appears magically with a burst of light and particles.\",\"ads-truck-ad-name\":\"Truck Ad\",\"ads-truck-ad-desc\":\"Your product displayed on a moving truck driving through the city.\",\"ads-giant-product-name\":\"Giant Product\",\"ads-giant-product-desc\":\"Surreal scene with a building-sized product towering over a person.\",\"ads-bullet-time-white-name\":\"Bullet Time White\",\"ads-bullet-time-white-desc\":\"Bullet-time 360° rotation on clean white background.\",\"ads-kick-ad-name\":\"Kick Ad\",\"ads-kick-ad-desc\":\"Dynamic action ad — character kicks product into frame.\",\"ads-billboard-ad-name\":\"Billboard Ad\",\"ads-billboard-ad-desc\":\"Your product on a glowing billboard in a bustling city at night.\",\"ads-graffiti-ad-name\":\"Graffiti Ad\",\"ads-graffiti-ad-desc\":\"Your product as vibrant street art graffiti on a brick wall.\",\"ads-bullet-time-splash-name\":\"Bullet Time Splash\",\"ads-bullet-time-splash-desc\":\"Bullet-time rotation with dramatic liquid splash effects.\",\"ads-fridge-ad-name\":\"Fridge Ad\",\"ads-fridge-ad-desc\":\"Product revealed inside an opening fridge — cool mist, fresh vibes.\",\"ads-volcano-ad-name\":\"Volcano Ad\",\"ads-volcano-ad-desc\":\"Product emerging dramatically from a volcanic eruption.\",\"ads-macroshot-product-name\":\"Macroshot Product\",\"ads-macroshot-product-desc\":\"Professional macro photography with shallow depth of field.\",\"label-character-image\":\"Character image\",\"label-character-image-default\":\"Character image\",\"label-product-image-default\":\"Product image\",\"label-face-photo\":\"Face photo\",\"label-source-character\":\"Source character\",\"label-source-face\":\"Source face\",\"label-source-video\":\"Source video\",\"label-source-image\":\"Source image\",\"label-start-frame\":\"Start frame\",\"label-end-frame\":\"End frame\",\"label-target-image\":\"Target image\",\"label-target-scene\":\"Target scene\",\"label-portrait-photo\":\"Portrait photo\",\"label-clothing-image\":\"Clothing image\",\"label-outfit-image\":\"Outfit image\",\"label-outfit-reference\":\"Outfit reference\",\"label-your-photo\":\"Your photo\",\"label-your-outfit-photo\":\"Your outfit photo\",\"label-your-selfie\":\"Your selfie\",\"label-your-sketch\":\"Your sketch\",\"label-effect\":\"Effect\",\"label-game-style\":\"Game style\",\"label-shot-type\":\"Shot type\",\"label-style\":\"Style\",\"trending-templates-yes-kiss-name\":\"Yes Kiss\",\"trending-templates-yes-kiss-desc\":\"Your photo gets kissed in a surreal, meme-style moment.\",\"trending-templates-latex-name\":\"Latex\",\"trending-templates-latex-desc\":\"Transform your photo into a sleek black latex style.\",\"trending-templates-j-magazine-name\":\"J-Magazine\",\"trending-templates-j-magazine-desc\":\"Turn your photo into a Japanese magazine cover.\",\"trending-templates-roller-coaster-name\":\"Roller Coaster\",\"trending-templates-roller-coaster-desc\":\"Put your photo on a thrilling roller coaster ride.\",\"trending-templates-60s-cafe-name\":\"60s Cafe\",\"trending-templates-60s-cafe-desc\":\"Turn your photo into a vintage 60s cafe scene.\",\"trending-templates-victory-card-name\":\"Victory Card\",\"trending-templates-victory-card-desc\":\"Turn your photo into a poker winning card.\",\"trending-templates-sand-worm-name\":\"Sand Worm\",\"trending-templates-sand-worm-desc\":\"Transform into a sand world character in an epic desert scene.\",\"trending-templates-skibidi-name\":\"Skibidi\",\"trending-templates-skibidi-desc\":\"Turn your photo into the Skibidi toilet meme.\",\"trending-templates-j-poster-name\":\"J-Poster\",\"trending-templates-j-poster-desc\":\"Turn your photo into a Japanese style poster.\",\"trending-templates-mascot-name\":\"Mascot\",\"trending-templates-mascot-desc\":\"Transform your photo into a football mascot character.\",\"trending-templates-storm-creature-name\":\"Storm Creature\",\"trending-templates-storm-creature-desc\":\"Turn your photo into an epic storm creature scene.\",\"trending-templates-burning-sunset-name\":\"Burning Sunset\",\"trending-templates-burning-sunset-desc\":\"Transform your photo into an epic burning sunset scene.\",\"trending-templates-on-fire-name\":\"On Fire\",\"trending-templates-on-fire-desc\":\"Turn your photo into the iconic 'This is Fine' meme scene.\",\"trending-templates-comic-book-name\":\"Comic Book\",\"trending-templates-comic-book-desc\":\"Transform your photo into comic book art style.\",\"trending-templates-cloud-surf-name\":\"Cloud Surf\",\"trending-templates-cloud-surf-desc\":\"Turn your photo into a dreamy pink cloud surfing scene.\",\"trending-templates-mukbang-name\":\"Mukbang\",\"trending-templates-mukbang-desc\":\"Transform your photo into a viral eating show.\",\"trending-templates-melting-doodle-name\":\"Melting Doodle\",\"trending-templates-melting-doodle-desc\":\"Turn your photo into mesmerizing melting doodle art.\",\"trending-templates-giallo-horror-name\":\"Giallo Horror\",\"trending-templates-giallo-horror-desc\":\"Transform your photo into a giallo horror scene.\",\"trending-templates-renaissance-name\":\"Renaissance\",\"trending-templates-renaissance-desc\":\"Turn your photo into a classical gallery painting.\",\"trending-templates-rap-god-name\":\"Rap God\",\"trending-templates-rap-god-desc\":\"Transform your photo into a rap music video clip.\"},\"CategoryPages\":{\"professional-title\":\"Professional Camera Effects\",\"professional-subtitle\":\"8 professional camera effect templates powered by advanced AI. Upload any photo and instantly create cinematic camera angles, dynamic zoom effects, smooth transitions, color grading, behind-the-scenes breakdowns, and more — no editing software required.\",\"professional-cta-heading\":\"Try Professional Effects\",\"professional-cta-subtitle\":\"8 camera effect templates — get free credits on signup.\",\"professional-faq-1-q\":\"What camera effects are available?\",\"professional-faq-1-a\":\"We offer 8 professional templates: camera angles, cinematic shots, dynamic zooms, smooth transitions, image expansion, color grading, behind-the-scenes breakdowns, and what's-next reveals. Each template is designed for a different creative use case.\",\"professional-faq-2-q\":\"How do the camera effects work?\",\"professional-faq-2-a\":\"Simply upload a photo, select an effect template, and click Generate. Our advanced AI analyzes your image and produces a cinematic video or enhanced image with the chosen camera effect applied — no manual editing or software skills needed.\",\"professional-faq-3-q\":\"What resolution and quality can I expect?\",\"professional-faq-3-a\":\"Video effects are generated in up to 1080p cinematic quality with smooth motion. Image effects are produced in up to 4K resolution with professional-grade color and detail preservation.\",\"professional-faq-4-q\":\"How much does it cost?\",\"professional-faq-4-a\":\"You get free credits on signup with no credit card required. After that, each generation costs a small number of credits based on the effect type. Check the pricing page for detailed credit costs.\",\"professional-faq-5-q\":\"Can I use the results for commercial projects?\",\"professional-faq-5-a\":\"Yes. All outputs you generate are yours to use for commercial purposes, including social media content, marketing materials, client projects, and more.\",\"professional-faq-6-q\":\"How long does processing take?\",\"professional-faq-6-a\":\"Most effects are generated within 10-60 seconds depending on the template and output type. Video effects generally take longer than image effects due to the additional frames being generated.\",\"professional-faq-7-q\":\"What image formats are supported?\",\"professional-faq-7-a\":\"You can upload JPEG, PNG, and WebP images. Output videos are delivered in MP4 format and output images in PNG or JPEG, ready for download and sharing.\",\"professional-faq-8-q\":\"Can I use this on mobile devices?\",\"professional-faq-8-a\":\"Yes. The entire platform is fully responsive and works on smartphones, tablets, and desktops. Upload photos directly from your camera roll and generate effects on the go.\",\"enhance-style-title\":\"Enhance \u0026 Style\",\"enhance-style-subtitle\":\"8 AI-powered fashion and visual enhancement tools for virtual try-on, professional relighting, skin retouching, outfit swapping, style transfer, and creative effects like glitter stickers — perfect for fashion creators, influencers, and e-commerce.\",\"enhance-style-cta-heading\":\"Try Enhance \u0026 Style\",\"enhance-style-cta-subtitle\":\"8 fashion and enhancement tools — get free credits on signup.\",\"enhance-style-faq-1-q\":\"What styling and enhancement tools are available?\",\"enhance-style-faq-1-a\":\"We offer 8 tools: AI Stylist for outfit recommendations, Relight for professional lighting adjustments, Skin Enhancer for natural retouching, Outfit Swap to change clothing, Style Snap for style transfer, Outfit Vending for creative outfit generation, Glitter Sticker for sparkle effects, and Outfit Shot for styled photo generation.\",\"enhance-style-faq-2-q\":\"How does virtual try-on work?\",\"enhance-style-faq-2-a\":\"Upload a photo of yourself and a reference garment or style. The AI realistically maps the clothing onto your body while preserving your pose, proportions, and background — great for previewing outfits before purchasing.\",\"enhance-style-faq-3-q\":\"How does relighting work?\",\"enhance-style-faq-3-a\":\"The Relight tool uses advanced AI to re-illuminate your photo with professional lighting setups. You can transform flat or poorly lit photos into studio-quality images with dramatic, natural, or custom lighting directions.\",\"enhance-style-faq-4-q\":\"How natural does the skin enhancement look?\",\"enhance-style-faq-4-a\":\"The Skin Enhancer uses AI trained on professional retouching techniques to smooth skin, reduce blemishes, and even out tone while preserving natural texture and detail. Results look polished but never artificial.\",\"enhance-style-faq-5-q\":\"Can I use the results commercially?\",\"enhance-style-faq-5-a\":\"Yes. All generated outputs are yours to use for commercial purposes including e-commerce listings, social media content, fashion portfolios, marketing campaigns, and client work.\",\"enhance-style-faq-6-q\":\"How much does it cost?\",\"enhance-style-faq-6-a\":\"You get free credits on signup with no credit card required. Each tool costs a small number of credits per generation. Check the pricing page for specific credit costs per effect.\",\"enhance-style-faq-7-q\":\"What output quality can I expect?\",\"enhance-style-faq-7-a\":\"Image effects are generated in up to 4K resolution with professional color accuracy. Video effects are produced in up to 1080p cinematic quality with smooth, realistic motion.\",\"face-identity-title\":\"Face \u0026 Identity\",\"face-identity-subtitle\":\"6 AI-powered face and identity tools for realistic face swapping in photos and videos, character transformation, professional headshot generation, and commercial-ready face creation — all with natural, high-fidelity results.\",\"face-identity-cta-heading\":\"Try Face \u0026 Identity\",\"face-identity-cta-subtitle\":\"6 face and identity tools — get free credits on signup.\",\"face-identity-faq-1-q\":\"What face and identity tools are available?\",\"face-identity-faq-1-a\":\"We offer 6 tools: Recast for video character transformation, Character Swap for full-body character replacement, Face Swap for photo face replacement, Commercial Faces for generating professional stock-ready faces, Video Face Swap for replacing faces in video clips, and Headshot Generator for creating polished professional portraits.\",\"face-identity-faq-2-q\":\"How realistic is the face swap quality?\",\"face-identity-faq-2-a\":\"Our advanced AI produces highly realistic face swaps that match skin tone, lighting, and perspective of the target image or video. Results seamlessly blend the swapped face with natural shadows, reflections, and facial expressions.\",\"face-identity-faq-3-q\":\"Does face swap work on videos?\",\"face-identity-faq-3-a\":\"Yes. The Video Face Swap tool processes video clips frame-by-frame with temporal consistency, ensuring the swapped face looks natural and stable throughout the entire video without flickering or artifacts.\",\"face-identity-faq-4-q\":\"How well is identity preserved across different poses?\",\"face-identity-faq-4-a\":\"The AI preserves key facial features and identity characteristics even when the source and target have different poses, angles, or expressions. It adapts the face naturally to match the target's head position and lighting.\",\"face-identity-faq-5-q\":\"What are the ethical guidelines for using these tools?\",\"face-identity-faq-5-a\":\"These tools are intended for creative, entertainment, and professional use with proper consent. Do not use them to create misleading content, impersonate others without permission, or produce non-consensual deepfakes. Users are responsible for complying with applicable laws.\",\"face-identity-faq-6-q\":\"How much does it cost?\",\"face-identity-faq-6-a\":\"You get free credits on signup with no credit card required. Each tool costs a small number of credits per generation, with video processing costing more than image processing due to the additional computation involved.\",\"face-identity-faq-7-q\":\"How long does processing take?\",\"face-identity-faq-7-a\":\"Photo face swaps typically complete in 10-30 seconds. Video face swaps and headshot generation may take 30-90 seconds depending on video length and resolution.\",\"face-identity-faq-8-q\":\"What formats are supported?\",\"face-identity-faq-8-a\":\"Upload JPEG, PNG, or WebP images for photo tools. Video tools accept MP4 and common video formats. All outputs are delivered in high-quality formats ready for download and sharing.\",\"video-editing-title\":\"Video Editing\",\"video-editing-subtitle\":\"6 AI-powered video editing tools for creating outfit reels, beat-synced montages, sticker match cuts, creative breakdowns, Japanese-show-style reveals, and background removal — ideal for social media creators, brands, and content marketers.\",\"video-editing-cta-heading\":\"Try Video Editing\",\"video-editing-cta-subtitle\":\"6 creative video tools — get free credits on signup.\",\"video-editing-faq-1-q\":\"What video editing tools are available?\",\"video-editing-faq-1-a\":\"We offer 6 tools: ClipCut for outfit reels and fashion transitions, Urban Cuts for beat-synced street-style montages, Sticker Match Cut for creative sticker-driven transitions, Breakdown for product and scene deconstruction videos, Japanese Show for dramatic reveal-style edits, and Video Background Remover for clean background extraction.\",\"video-editing-faq-2-q\":\"What video formats and resolutions are supported?\",\"video-editing-faq-2-a\":\"You can upload photos in JPEG, PNG, or WebP format as source material. Output videos are delivered in MP4 format at up to 1080p resolution, optimized for high quality and fast playback across all platforms.\",\"video-editing-faq-3-q\":\"How long does video processing take?\",\"video-editing-faq-3-a\":\"Most video effects are generated within 30-90 seconds depending on the template complexity and output duration. Simpler effects like background removal are faster, while multi-scene edits take slightly longer.\",\"video-editing-faq-4-q\":\"What output resolution can I expect?\",\"video-editing-faq-4-a\":\"All video outputs are generated in up to 1080p HD quality with smooth motion and professional-grade color. The AI ensures consistent quality across all frames for a polished final result.\",\"video-editing-faq-5-q\":\"Are the videos optimized for social media?\",\"video-editing-faq-5-a\":\"Yes. Output videos are formatted and sized for popular platforms like Instagram Reels, TikTok, YouTube Shorts, and Facebook. The aspect ratios and durations are optimized for maximum engagement on social feeds.\",\"video-editing-faq-6-q\":\"Can I use these videos for commercial purposes?\",\"video-editing-faq-6-a\":\"Yes. All generated video content is yours to use commercially, including for brand marketing, social media campaigns, client deliverables, and product promotions.\",\"video-editing-faq-7-q\":\"How much does it cost?\",\"video-editing-faq-7-a\":\"You get free credits on signup with no credit card required. Video generation costs vary by template — check the pricing page for detailed credit costs per effect.\",\"games-characters-title\":\"Games \u0026 Characters\",\"games-characters-subtitle\":\"10 AI-powered gaming art and character creation tools — transform photos into game-style art, 3D-rendered figures, retro pixel art, plush toy designs, brick cube models, and animated sketch-to-real videos. Perfect for gamers, artists, and content creators.\",\"games-characters-cta-heading\":\"Try Games \u0026 Characters\",\"games-characters-cta-subtitle\":\"10 gaming and character tools — get free credits on signup.\",\"games-characters-faq-1-q\":\"What game styles and effects are available?\",\"games-characters-faq-1-a\":\"We offer 10 templates spanning multiple genres: Game Dump and Simlife for simulation-style renders, Nano Strike and Nano Theft for action game aesthetics, Pixel Game for retro pixel art, Plushies for plush toy transformations, 3D Render and 3D Figure for three-dimensional character art, Brick Cube for block-style models, and Sketch to Real for animated sketch-to-video conversion.\",\"games-characters-faq-2-q\":\"How does 3D rendering work?\",\"games-characters-faq-2-a\":\"Upload a photo and the AI generates a stylized 3D-rendered version of your subject with realistic lighting, materials, and depth. The 3D Render template creates scene-style renders while 3D Figure produces collectible figurine-style outputs.\",\"games-characters-faq-3-q\":\"Can I create pixel art from photos?\",\"games-characters-faq-3-a\":\"Yes. The Pixel Game template transforms any photo into authentic retro-style pixel art, complete with limited color palettes and chunky pixel aesthetics reminiscent of classic 8-bit and 16-bit era games.\",\"games-characters-faq-4-q\":\"How does Sketch to Real work?\",\"games-characters-faq-4-a\":\"Upload a hand-drawn sketch and the AI animates it into a realistic video, bringing your drawings to life with natural motion and detail. It works with pencil sketches, ink drawings, and digital illustrations.\",\"games-characters-faq-5-q\":\"Can I use the generated art commercially?\",\"games-characters-faq-5-a\":\"Yes. All outputs are yours to use for commercial purposes including game assets, merchandise, social media content, print-on-demand products, and marketing materials.\",\"games-characters-faq-6-q\":\"How much does it cost?\",\"games-characters-faq-6-a\":\"You get free credits on signup with no credit card required. Each template costs a small number of credits per generation. Video-based effects like Sketch to Real cost more credits than image-only templates.\",\"games-characters-faq-7-q\":\"What quality and resolution are the outputs?\",\"games-characters-faq-7-a\":\"Image outputs are generated in up to 4K resolution with sharp detail and vibrant colors. Video outputs are produced in up to 1080p quality with smooth motion and consistent frame-to-frame quality.\",\"games-characters-faq-8-q\":\"Do I need any design or gaming skills?\",\"games-characters-faq-8-a\":\"No skills are required. Simply upload a photo, choose a template, and click Generate. The AI handles all the artistic transformation automatically.\",\"trending-templates-title\":\"Trending Templates\",\"trending-templates-subtitle\":\"20 viral AI templates for creating trending social media content — from kiss effects and comic book transformations to roller coaster rides, Renaissance portraits, magazine covers, and meme-ready styles. Upload a photo and go viral.\",\"trending-templates-cta-heading\":\"Try Trending Templates\",\"trending-templates-cta-subtitle\":\"20 viral templates — get free credits on signup.\",\"trending-templates-faq-1-q\":\"What trending effects are available?\",\"trending-templates-faq-1-a\":\"We offer 20 popular templates including kiss effects, latex styling, Japanese magazine covers, roller coaster rides, vintage cafe scenes, victory cards, sand worm adventures, comic book art, Renaissance portraits, rap video styles, and many more creative transformations.\",\"trending-templates-faq-2-q\":\"How do the trending effects work?\",\"trending-templates-faq-2-a\":\"Upload a photo of yourself or any subject, select a trending template, and click Generate. The AI transforms your image into the chosen style or creates a short video with the effect applied — most results are ready in under a minute.\",\"trending-templates-faq-3-q\":\"Are these effects good for viral social media content?\",\"trending-templates-faq-3-a\":\"Yes. These templates are specifically designed for shareability on TikTok, Instagram Reels, YouTube Shorts, and other social platforms. They follow current visual trends that drive engagement and shares.\",\"trending-templates-faq-4-q\":\"Do the templates produce images or videos?\",\"trending-templates-faq-4-a\":\"It depends on the template. Some produce stylized images (like comic book or Renaissance), while others generate short video clips with motion and effects (like roller coaster or kiss effects). Each template description indicates the output type.\",\"trending-templates-faq-5-q\":\"How much does it cost?\",\"trending-templates-faq-5-a\":\"You get free credits on signup with no credit card required. Each template costs a small number of credits per generation, with video effects costing slightly more than image effects.\",\"trending-templates-faq-6-q\":\"Can I use trending effects for commercial content?\",\"trending-templates-faq-6-a\":\"Yes. All outputs are yours to use commercially, including for branded social media posts, marketing campaigns, and content creation. There are no watermarks on generated content.\",\"trending-templates-faq-7-q\":\"How often are new trending templates added?\",\"trending-templates-faq-7-a\":\"We regularly add new templates based on viral trends and user requests. Check back frequently to discover the latest effects and stay ahead of social media trends.\",\"trending-templates-faq-8-q\":\"Can I use these on mobile?\",\"trending-templates-faq-8-a\":\"Yes. The platform is fully responsive and works on any device. Upload photos directly from your phone camera roll and generate trending effects instantly from your mobile browser.\",\"ads-title\":\"AI Ads \u0026 Products\",\"ads-subtitle\":\"20 professional AI ad templates for creating stunning product videos and images — including ASMR reveals, bullet-time effects, packshots, billboard mockups, macro close-ups, and more. Upload a product photo and generate scroll-stopping ads in seconds, no design skills needed.\",\"ads-cta-heading\":\"Create Your First Ad\",\"ads-cta-subtitle\":\"20 professional templates — get free credits on signup.\",\"ads-faq-1-q\":\"What types of ads can I create?\",\"ads-faq-1-a\":\"We offer 20 templates covering a wide range of ad styles: ASMR product reveals, bullet-time freeze effects, clean packshots, billboard mockups, macro close-up details, poster designs, street art placements, cinematic product showcases, and more. Both video and static image ad formats are available.\",\"ads-faq-2-q\":\"Can I create both video and image ads?\",\"ads-faq-2-a\":\"Yes. Each template supports either video or image output (some support both). Video ads are generated in up to 1080p cinematic quality with configurable duration (4-15 seconds), while image ads are produced in up to 4K resolution.\",\"ads-faq-3-q\":\"How does AI product photography work?\",\"ads-faq-3-a\":\"Upload a product photo and the AI automatically isolates your product, places it in the chosen scene or style, and generates professional-quality visuals with realistic lighting, shadows, and reflections — no physical studio or photographer required.\",\"ads-faq-4-q\":\"Can I use the ads for commercial marketing?\",\"ads-faq-4-a\":\"Yes. All generated ad content is yours to use commercially with no restrictions. Use them for social media ads, e-commerce listings, email campaigns, print materials, digital billboards, and any other marketing channels.\",\"ads-faq-5-q\":\"How much does it cost?\",\"ads-faq-5-a\":\"You get free credits on signup with no credit card required. Video ads cost more credits than image ads due to the additional processing. Check the pricing page for specific credit costs per template.\",\"ads-faq-6-q\":\"Do I need design or photography skills?\",\"ads-faq-6-a\":\"No skills are needed. Simply upload a product photo (and optionally a character or model photo), select a template, and click Generate. The AI handles composition, lighting, effects, and styling automatically.\",\"ads-faq-7-q\":\"How long does ad generation take?\",\"ads-faq-7-a\":\"Image ads typically generate in 10-30 seconds. Video ads take 30-90 seconds depending on the template and video duration selected. All outputs are immediately available for download once processing completes.\",\"ads-faq-8-q\":\"What image formats can I upload?\",\"ads-faq-8-a\":\"You can upload product photos in JPEG, PNG, or WebP format. For best results, use a clear product photo with a simple background. The AI will automatically extract and recompose your product into the chosen ad template.\"},\"ToolPages\":{\"image-upscaler-title\":\"AI Image Upscaler — Enhance to 4K \u0026 8K\",\"image-upscaler-subtitle\":\"Upload any photo and instantly enhance it to 2K, 4K, or 8K resolution using state-of-the-art AI upscaling. Recover lost detail, sharpen textures, and enlarge images without quality loss — no watermarks added, free credits on signup.\",\"image-upscaler-cta-heading\":\"Upscale Your First Image\",\"image-upscaler-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"image-upscaler-faq-1-q\":\"How does the AI image upscaler work?\",\"image-upscaler-faq-1-a\":\"Our advanced AI analyzes your image and intelligently adds new pixels to increase resolution. It recovers fine details, sharpens textures, and enhances clarity while enlarging your photo to 2K, 4K, or 8K.\",\"image-upscaler-faq-2-q\":\"How much does it cost to upscale an image?\",\"image-upscaler-faq-2-a\":\"You get free credits when you sign up — enough to try several upscales at no cost. After that, each image costs just a few cents depending on the target resolution.\",\"image-upscaler-faq-3-q\":\"Will upscaling make my blurry photo look better?\",\"image-upscaler-faq-3-a\":\"Yes. The AI recovers lost detail and sharpens textures as it enlarges, so soft or low-resolution photos come out noticeably clearer and crisper at higher resolutions.\",\"image-upscaler-faq-4-q\":\"What image formats can I upload and download?\",\"image-upscaler-faq-4-a\":\"You can upload JPG, PNG, or WebP images of any size. Your upscaled result is available to download as JPEG, PNG, or WebP.\",\"image-upscaler-faq-5-q\":\"Will there be a watermark on my upscaled image?\",\"image-upscaler-faq-5-a\":\"No. Your upscaled images are completely clean with no watermarks or branding added, so they are ready for immediate use.\",\"image-upscaler-faq-6-q\":\"How fast is the upscaling process?\",\"image-upscaler-faq-6-a\":\"Most images finish in just a few seconds. Higher target resolutions like 8K may take slightly longer, but you will typically have your result in under 30 seconds.\",\"image-upscaler-faq-7-q\":\"Can I use upscaled images for commercial purposes?\",\"image-upscaler-faq-7-a\":\"Yes. There are no usage restrictions on the output. You can use your upscaled images for commercial projects, print, e-commerce, social media, or any other purpose.\",\"image-upscaler-faq-8-q\":\"Does the upscaler work on mobile devices?\",\"image-upscaler-faq-8-a\":\"Yes. The tool runs entirely in your browser, so it works on any device including smartphones and tablets. Just upload your image and the cloud-based AI handles the processing.\",\"video-upscaler-title\":\"AI Video Upscaler — Enhance Videos to 4K\",\"video-upscaler-subtitle\":\"Enhance any video to 720p, 1080p, 2K, or 4K using state-of-the-art AI upscaling. Sharpen details, recover clarity, and improve visual quality while preserving smooth, natural motion — no watermarks, free credits on signup.\",\"video-upscaler-cta-heading\":\"Upscale Your First Video\",\"video-upscaler-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"video-upscaler-faq-1-q\":\"How does the AI video upscaler work?\",\"video-upscaler-faq-1-a\":\"The advanced AI analyzes each frame of your video, intelligently adding detail and sharpening textures while maintaining temporal consistency for smooth, natural-looking motion throughout.\",\"video-upscaler-faq-2-q\":\"How much does it cost to upscale a video?\",\"video-upscaler-faq-2-a\":\"You get free credits when you sign up — enough to try multiple upscales at no cost. After that, pricing depends on the video length and target resolution; short clips typically cost just a few cents.\",\"video-upscaler-faq-3-q\":\"What resolutions can I upscale to?\",\"video-upscaler-faq-3-a\":\"You can upscale to 720p, 1080p, 2K, or 4K. The AI sharpens detail and improves clarity at every resolution step, making even old or low-quality footage look crisp.\",\"video-upscaler-faq-4-q\":\"What video formats can I upload?\",\"video-upscaler-faq-4-a\":\"You can upload MP4, MOV, and WebM files. Your enhanced video is returned in a standard format ready for sharing or editing.\",\"video-upscaler-faq-5-q\":\"Will there be a watermark on the output?\",\"video-upscaler-faq-5-a\":\"No. Your upscaled video is completely clean with no watermarks or branding added, so it is ready for immediate use in any project.\",\"video-upscaler-faq-6-q\":\"How long does it take to process a video?\",\"video-upscaler-faq-6-a\":\"Short clips usually finish in under a minute. Longer videos or higher resolutions take more time, but you can close the tab and come back — your result will be waiting.\",\"video-upscaler-faq-7-q\":\"Can I use upscaled videos commercially?\",\"video-upscaler-faq-7-a\":\"Yes. There are no usage restrictions on the output. You can use your enhanced videos for commercial projects, social media, presentations, or any other purpose.\",\"video-upscaler-faq-8-q\":\"Does the video upscaler work on mobile?\",\"video-upscaler-faq-8-a\":\"Yes. The tool runs in your browser and processing happens in the cloud, so it works on any device including smartphones and tablets. Simply upload your video and wait for the result.\",\"image-watermark-remover-title\":\"AI Image Watermark Remover\",\"image-watermark-remover-subtitle\":\"Remove text watermarks, logos, date stamps, and overlays from any photo using advanced AI. The tool intelligently reconstructs what was behind the watermark for a clean, natural-looking result — free credits on signup, no installation required.\",\"image-watermark-remover-cta-heading\":\"Clean Up Your Photos Now\",\"image-watermark-remover-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"image-watermark-remover-faq-1-q\":\"How does the AI watermark remover work?\",\"image-watermark-remover-faq-1-a\":\"The advanced AI detects watermark regions in your image, removes them, and intelligently reconstructs the underlying content with matching textures, colors, and lighting for a seamless result.\",\"image-watermark-remover-faq-2-q\":\"What kinds of watermarks can this remove?\",\"image-watermark-remover-faq-2-a\":\"Text watermarks, logo stamps, semi-transparent overlays, date stamps, and tiled patterns. The AI handles both solid and translucent watermarks effectively.\",\"image-watermark-remover-faq-3-q\":\"Will my photo look edited or damaged afterward?\",\"image-watermark-remover-faq-3-a\":\"No. The AI reconstructs the texture behind the watermark so the result looks clean and natural with no visible patches, smudges, or artifacts.\",\"image-watermark-remover-faq-4-q\":\"What image formats can I upload?\",\"image-watermark-remover-faq-4-a\":\"You can upload JPG, PNG, or WebP images in any resolution. Download your cleaned image in JPEG, PNG, or WebP.\",\"image-watermark-remover-faq-5-q\":\"How much does it cost?\",\"image-watermark-remover-faq-5-a\":\"You get free credits when you sign up — enough to try several removals at no cost. After that, each image costs just a few cents.\",\"image-watermark-remover-faq-6-q\":\"How fast is the watermark removal?\",\"image-watermark-remover-faq-6-a\":\"Most images are processed in just a few seconds. The AI works quickly regardless of image size or watermark complexity.\",\"image-watermark-remover-faq-7-q\":\"Can it remove watermarks from stock photos?\",\"image-watermark-remover-faq-7-a\":\"The AI can remove visible watermarks from any image. Please make sure you have the legal right to use the underlying image before removing its watermark.\",\"image-watermark-remover-faq-8-q\":\"Does the watermark remover work on mobile devices?\",\"image-watermark-remover-faq-8-a\":\"Yes. The tool runs entirely in your browser with cloud-based processing, so it works on any device including smartphones and tablets.\",\"video-watermark-remover-title\":\"AI Video Watermark Remover\",\"video-watermark-remover-subtitle\":\"Remove watermarks, logos, captions, and text overlays from any video up to 10 minutes using advanced AI. Each frame is processed individually to preserve original quality while cleanly erasing unwanted elements — free credits on signup.\",\"video-watermark-remover-cta-heading\":\"Clean Up Your Videos Now\",\"video-watermark-remover-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"video-watermark-remover-faq-1-q\":\"How does the AI video watermark remover work?\",\"video-watermark-remover-faq-1-a\":\"The advanced AI processes each frame of your video, detecting and removing watermarks while intelligently reconstructing the underlying content to maintain visual consistency across all frames.\",\"video-watermark-remover-faq-2-q\":\"What kinds of watermarks can this remove from videos?\",\"video-watermark-remover-faq-2-a\":\"Logos, captions, hardcoded subtitles, text overlays, and semi-transparent stamps. The AI handles both static and animated watermarks effectively.\",\"video-watermark-remover-faq-3-q\":\"How long of a video can I process?\",\"video-watermark-remover-faq-3-a\":\"You can upload videos up to 10 minutes long. Shorter clips process faster and cost less, making it affordable to clean up any footage.\",\"video-watermark-remover-faq-4-q\":\"What video formats are supported?\",\"video-watermark-remover-faq-4-a\":\"Upload MP4, MOV, or WebM files. Your cleaned video is returned in a standard format ready for sharing or editing.\",\"video-watermark-remover-faq-5-q\":\"How much does it cost?\",\"video-watermark-remover-faq-5-a\":\"You get free credits when you sign up — enough to try multiple removals at no cost. After that, pricing depends on video length; short clips cost just a few cents.\",\"video-watermark-remover-faq-6-q\":\"Will the video quality be affected?\",\"video-watermark-remover-faq-6-a\":\"No. The AI only modifies the watermarked areas and leaves the rest of each frame untouched, preserving resolution, color accuracy, and motion quality throughout.\",\"video-watermark-remover-faq-7-q\":\"How long does processing take?\",\"video-watermark-remover-faq-7-a\":\"Short clips typically process in under a minute. Longer videos take proportionally more time, but you can close the tab and return later — your result will be waiting.\",\"video-watermark-remover-faq-8-q\":\"Can I use the cleaned videos commercially?\",\"video-watermark-remover-faq-8-a\":\"Yes. There are no usage restrictions on the output from our tool. However, please ensure you have the legal right to use the underlying video content before removing its watermark.\",\"image-face-swap-title\":\"AI Face Swap — Swap Faces in Photos\",\"image-face-swap-subtitle\":\"Seamlessly swap faces in any photo using advanced AI. Upload a source image and a face photo — the tool automatically detects faces, matches skin tone and lighting, and blends them naturally. Works with group photos, no watermarks added, free credits on signup.\",\"image-face-swap-cta-heading\":\"Try Your First Face Swap\",\"image-face-swap-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"image-face-swap-faq-1-q\":\"How does the AI face swap work?\",\"image-face-swap-faq-1-a\":\"Upload the photo you want to edit and a separate image of the face you want to use. The advanced AI detects both faces, matches skin tone, lighting, and angle, then blends them together seamlessly.\",\"image-face-swap-faq-2-q\":\"Can I choose which face to replace in a group photo?\",\"image-face-swap-faq-2-a\":\"Yes. Use the Target Face Index setting to pick which person in the photo gets the new face — 0 is the largest face, 1 is the next, and so on.\",\"image-face-swap-faq-3-q\":\"Does the result look natural?\",\"image-face-swap-faq-3-a\":\"Yes. The AI automatically matches skin tone, lighting, expression, and angle so the swapped face blends naturally with the rest of the photo without visible seams or artifacts.\",\"image-face-swap-faq-4-q\":\"Is there a watermark on the output?\",\"image-face-swap-faq-4-a\":\"No. Your face-swapped photo is completely clean with no watermarks or branding, ready for immediate use.\",\"image-face-swap-faq-5-q\":\"How much does it cost?\",\"image-face-swap-faq-5-a\":\"You get free credits when you sign up — enough to try several swaps at no cost. After that, each face swap costs just a few cents.\",\"image-face-swap-faq-6-q\":\"What image formats are supported?\",\"image-face-swap-faq-6-a\":\"You can upload JPG, PNG, or WebP images for both the source photo and the face image. Results are available in standard image formats.\",\"image-face-swap-faq-7-q\":\"How fast is the face swap?\",\"image-face-swap-faq-7-a\":\"Most face swaps complete in just a few seconds. The AI processes the detection, alignment, and blending almost instantly in the cloud.\",\"image-face-swap-faq-8-q\":\"Can I use face-swapped images commercially?\",\"image-face-swap-faq-8-a\":\"Yes. There are no usage restrictions on the output. Please ensure you have appropriate consent from the individuals whose faces appear in the images.\",\"video-face-swap-title\":\"AI Video Face Swap\",\"video-face-swap-subtitle\":\"Swap faces in any video using advanced AI face tracking. Upload a clip and a face photo — the tool replaces the target face across every frame with matched lighting, skin tone, and expressions for a seamless result. Free credits on signup, no watermarks added.\",\"video-face-swap-cta-heading\":\"Try Your First Video Face Swap\",\"video-face-swap-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"video-face-swap-faq-1-q\":\"How does the AI video face swap work?\",\"video-face-swap-faq-1-a\":\"Upload your video and a photo of the face you want to use. The advanced AI tracks the target face through every frame, matching lighting, angle, and expression for a consistent, natural-looking swap.\",\"video-face-swap-faq-2-q\":\"Can I choose which person's face to replace?\",\"video-face-swap-faq-2-a\":\"Yes. Use the Target Face Index to pick which face gets swapped — 0 is the largest face in the frame, 1 is the next, and so on. This works great for multi-person scenes.\",\"video-face-swap-faq-3-q\":\"Does it look natural when the person moves?\",\"video-face-swap-faq-3-a\":\"Yes. The AI tracks facial landmarks across frames so the swap stays consistent through head turns, expressions, and rapid movement without flickering or artifacts.\",\"video-face-swap-faq-4-q\":\"What video formats can I upload?\",\"video-face-swap-faq-4-a\":\"MP4, MOV, and WebM are all supported. Your swapped video is returned in a standard format ready for sharing or editing.\",\"video-face-swap-faq-5-q\":\"How much does it cost?\",\"video-face-swap-faq-5-a\":\"You get free credits when you sign up — enough to try multiple swaps at no cost. After that, pricing depends on video length; short clips cost just a few cents.\",\"video-face-swap-faq-6-q\":\"How long does processing take?\",\"video-face-swap-faq-6-a\":\"Short clips typically process in under a minute. Longer videos take proportionally more time, but you can close the tab and return later — your result will be waiting.\",\"video-face-swap-faq-7-q\":\"Does the video face swap work on mobile?\",\"video-face-swap-faq-7-a\":\"Yes. The tool runs in your browser with cloud-based processing, so it works on any device including smartphones and tablets.\",\"video-face-swap-faq-8-q\":\"Can I use face-swapped videos commercially?\",\"video-face-swap-faq-8-a\":\"Yes. There are no usage restrictions on the output. Please ensure you have appropriate consent from individuals whose likenesses appear in the content.\",\"image-background-remover-title\":\"AI Image Background Remover\",\"image-background-remover-subtitle\":\"Instantly remove backgrounds from any image using state-of-the-art AI. Get a clean transparent PNG with precise edge detection — perfect for e-commerce product photos, graphic design, compositing, and social media content. Free credits on signup.\",\"image-background-remover-cta-heading\":\"Remove Backgrounds Now\",\"image-background-remover-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"image-background-remover-faq-1-q\":\"How does the AI background remover work?\",\"image-background-remover-faq-1-a\":\"Upload any image and the advanced AI automatically detects the subject, precisely separates it from the background using edge-aware matting, and outputs a high-quality transparent PNG.\",\"image-background-remover-faq-2-q\":\"What output format do I get?\",\"image-background-remover-faq-2-a\":\"The result is a transparent PNG with an alpha channel — ready to use directly in designs, e-commerce listings, presentations, compositing, or any graphic editing software.\",\"image-background-remover-faq-3-q\":\"Does it work with complex backgrounds?\",\"image-background-remover-faq-3-a\":\"Yes. The AI handles busy backgrounds, fine hair details, semi-transparent objects, and intricate edges with clean, precise detection.\",\"image-background-remover-faq-4-q\":\"How much does it cost?\",\"image-background-remover-faq-4-a\":\"You get free credits on signup — enough to process multiple images at no cost. After that, each background removal costs just a few cents. No credit card needed to start.\",\"image-background-remover-faq-5-q\":\"Can I use it for product photos?\",\"image-background-remover-faq-5-a\":\"Absolutely. It is perfect for e-commerce — get clean, white-background or transparent product shots in seconds for marketplaces, catalogs, and online stores.\",\"image-background-remover-faq-6-q\":\"How fast is the background removal?\",\"image-background-remover-faq-6-a\":\"Most images are processed in just a few seconds. The cloud-based AI handles the heavy lifting so results are nearly instant regardless of image complexity.\",\"image-background-remover-faq-7-q\":\"What image formats can I upload?\",\"image-background-remover-faq-7-a\":\"You can upload JPG, PNG, or WebP images of any size. The output is always a transparent PNG for maximum compatibility.\",\"image-background-remover-faq-8-q\":\"Does the background remover work on mobile?\",\"image-background-remover-faq-8-a\":\"Yes. The tool runs entirely in your browser, so it works on any device including smartphones and tablets. Upload a photo from your camera roll and get a transparent cutout in seconds.\",\"video-background-remover-title\":\"AI Video Background Remover\",\"video-background-remover-subtitle\":\"Remove or replace video backgrounds using advanced AI with frame-by-frame edge-aware matting. Upload any video and optionally a custom background image — get clean compositing with natural blending, smooth motion, and fine detail preservation. Free credits on signup.\",\"video-background-remover-cta-heading\":\"Remove Video Backgrounds Now\",\"video-background-remover-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"video-background-remover-faq-1-q\":\"How does the AI video background remover work?\",\"video-background-remover-faq-1-a\":\"Upload a video and the advanced AI detects subjects frame-by-frame, removes the background with clean edge-aware matting, and maintains temporal consistency so the result looks smooth and natural.\",\"video-background-remover-faq-2-q\":\"Can I replace the background instead of just removing it?\",\"video-background-remover-faq-2-a\":\"Yes. Upload a custom background image and the AI composites your subject onto it with natural blending and edge matching — like a virtual green screen without any physical setup.\",\"video-background-remover-faq-3-q\":\"What video formats are supported?\",\"video-background-remover-faq-3-a\":\"MP4, MOV, and WebM are all supported. Your processed video is returned in a standard format ready for sharing or further editing.\",\"video-background-remover-faq-4-q\":\"How much does it cost?\",\"video-background-remover-faq-4-a\":\"You get free credits on signup — enough to process multiple videos at no cost. After that, pricing depends on video length; short clips cost just a few cents. No credit card needed to start.\",\"video-background-remover-faq-5-q\":\"How long can the video be?\",\"video-background-remover-faq-5-a\":\"The tool handles videos of various lengths. Processing time scales with video duration, but you can close the tab and return later to find your result waiting.\",\"video-background-remover-faq-6-q\":\"Does it handle hair and fine details?\",\"video-background-remover-faq-6-a\":\"Yes. The AI uses edge-aware matting that precisely handles hair, fur, semi-transparent objects, and other fine details that are difficult to mask manually.\",\"video-background-remover-faq-7-q\":\"How long does processing take?\",\"video-background-remover-faq-7-a\":\"Short clips typically process in under a minute. Longer videos take more time proportionally, but the cloud-based processing runs efficiently in the background.\",\"video-background-remover-faq-8-q\":\"Can I use the results commercially?\",\"video-background-remover-faq-8-a\":\"Yes. There are no usage restrictions on the output. You can use the processed videos for commercial projects, social media, presentations, or any other purpose.\",\"image-eraser-title\":\"AI Image Eraser\",\"image-eraser-subtitle\":\"Remove unwanted objects, people, text, logos, or blemishes from any photo using advanced AI inpainting. Simply draw a mask or describe what to erase — the tool reconstructs the background with natural textures and consistent lighting. Free credits on signup, no installation required.\",\"image-eraser-cta-heading\":\"Erase Objects from Photos\",\"image-eraser-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"image-eraser-faq-1-q\":\"How does the AI image eraser work?\",\"image-eraser-faq-1-a\":\"Upload an image, then either draw a mask over the area to remove or describe what to erase using a text prompt. The advanced AI removes the targeted element and reconstructs the background with matching textures and lighting.\",\"image-eraser-faq-2-q\":\"Do I need to provide a mask?\",\"image-eraser-faq-2-a\":\"No. You can use a text prompt instead (e.g., \\\"dog\\\" or \\\"hat\\\") and the AI will detect and remove it automatically. For precise control, upload a mask image where white marks the areas to erase.\",\"image-eraser-faq-3-q\":\"What can I erase from photos?\",\"image-eraser-faq-3-a\":\"Objects, people, text, logos, watermarks, blemishes, power lines — anything visible in the image. The AI fills the gap with realistic background that matches the surrounding area.\",\"image-eraser-faq-4-q\":\"How much does it cost?\",\"image-eraser-faq-4-a\":\"You get free credits on signup — enough to try multiple erasures at no cost. After that, each image costs just a few cents. No credit card needed to start.\",\"image-eraser-faq-5-q\":\"What image formats are supported?\",\"image-eraser-faq-5-a\":\"Upload JPG, PNG, or WebP images in any resolution. Download your cleaned result in JPEG, PNG, or WebP.\",\"image-eraser-faq-6-q\":\"How fast is the object removal?\",\"image-eraser-faq-6-a\":\"Most images are processed in just a few seconds. The cloud-based AI handles complex removals quickly regardless of image size or the complexity of what you are erasing.\",\"image-eraser-faq-7-q\":\"Will the edited area look natural?\",\"image-eraser-faq-7-a\":\"Yes. The AI reconstructs the background with consistent textures, colors, and lighting so the erased area blends seamlessly with the rest of the image.\",\"image-eraser-faq-8-q\":\"Does the image eraser work on mobile?\",\"image-eraser-faq-8-a\":\"Yes. The tool runs in your browser with cloud-based processing, so it works on any device including smartphones and tablets. Simply upload your image and describe what to remove.\",\"video-eraser-title\":\"AI Video Eraser\",\"video-eraser-subtitle\":\"Remove unwanted objects, people, text, or elements from any video using advanced AI video inpainting. Use a mask or text prompt to target what to erase — the tool reconstructs the background naturally across all frames while preserving motion and quality. Free credits on signup.\",\"video-eraser-cta-heading\":\"Erase Objects from Videos\",\"video-eraser-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"video-eraser-faq-1-q\":\"How does the AI video eraser work?\",\"video-eraser-faq-1-a\":\"Upload a video, then either draw a mask over the area to remove or describe what to erase in a text prompt. The advanced AI removes the target frame-by-frame while maintaining temporal consistency for a smooth result.\",\"video-eraser-faq-2-q\":\"Do I need to provide a mask?\",\"video-eraser-faq-2-a\":\"No. You can describe what to remove using a text prompt (e.g., \\\"person on the left\\\" or \\\"logo in corner\\\"). For precise control, upload a mask image marking the areas to erase.\",\"video-eraser-faq-3-q\":\"How long can videos be?\",\"video-eraser-faq-3-a\":\"Up to 10 minutes. Processing time scales with video length, but you can close the tab and return later to find your result waiting.\",\"video-eraser-faq-4-q\":\"How much does it cost?\",\"video-eraser-faq-4-a\":\"You get free credits on signup — enough to try multiple erasures at no cost. After that, pricing depends on video length; short clips cost just a few cents. No credit card needed to start.\",\"video-eraser-faq-5-q\":\"Does it preserve video quality?\",\"video-eraser-faq-5-a\":\"Yes. The AI maintains the original resolution, frame rate, and natural motion while cleanly removing the targeted elements and reconstructing the background consistently.\",\"video-eraser-faq-6-q\":\"What video formats are supported?\",\"video-eraser-faq-6-a\":\"MP4, MOV, and WebM are all supported. Your processed video is returned in a standard format ready for sharing or editing.\",\"video-eraser-faq-7-q\":\"Will the erased area look natural?\",\"video-eraser-faq-7-a\":\"Yes. The AI reconstructs the background behind removed objects with consistent textures and lighting across all frames, so the edit is seamless and temporally stable.\",\"video-eraser-faq-8-q\":\"Does the video eraser work on mobile?\",\"video-eraser-faq-8-a\":\"Yes. The tool runs in your browser with cloud-based processing, so it works on any device including smartphones and tablets.\",\"video-fps-increaser-title\":\"AI Video FPS Increaser\",\"video-fps-increaser-subtitle\":\"Double your video frame rate using advanced AI frame interpolation. Upload any video and get smoother motion, better slow-motion playback, and reduced judder — supports all input frame rates with intelligent motion-aware processing. Free credits on signup.\",\"video-fps-increaser-cta-heading\":\"Boost Your Video FPS\",\"video-fps-increaser-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"video-fps-increaser-faq-1-q\":\"How does the AI FPS increaser work?\",\"video-fps-increaser-faq-1-a\":\"The advanced AI analyzes motion between existing frames and generates new intermediate frames using intelligent interpolation, effectively doubling the frame rate for smoother, more fluid playback.\",\"video-fps-increaser-faq-2-q\":\"What frame rates are supported?\",\"video-fps-increaser-faq-2-a\":\"Any input frame rate is supported. The output will be double your original — for example, 24fps becomes 48fps, and 30fps becomes 60fps.\",\"video-fps-increaser-faq-3-q\":\"Does it improve video quality?\",\"video-fps-increaser-faq-3-a\":\"It makes motion significantly smoother and eliminates judder and choppiness. For the best results, combine it with our video upscaler to get both higher resolution and higher frame rate.\",\"video-fps-increaser-faq-4-q\":\"How much does it cost?\",\"video-fps-increaser-faq-4-a\":\"You get free credits on signup — enough to process multiple videos at no cost. After that, pricing depends on video length; short clips cost just a few cents. No credit card needed to start.\",\"video-fps-increaser-faq-5-q\":\"What video formats are supported?\",\"video-fps-increaser-faq-5-a\":\"MP4, MOV, and WebM are all supported. Your enhanced video is returned in a standard format ready for sharing or editing.\",\"video-fps-increaser-faq-6-q\":\"How long does processing take?\",\"video-fps-increaser-faq-6-a\":\"Short clips typically process in under a minute. Longer videos take more time proportionally, but you can close the tab and return later to find your result waiting.\",\"video-fps-increaser-faq-7-q\":\"Is the FPS increaser good for slow-motion effects?\",\"video-fps-increaser-faq-7-a\":\"Yes. By doubling the frame rate, you get extra frames that allow for smoother slow-motion playback without the stuttering that occurs when slowing down low-FPS footage.\",\"video-fps-increaser-faq-8-q\":\"Does the FPS increaser work on mobile?\",\"video-fps-increaser-faq-8-a\":\"Yes. The tool runs in your browser with cloud-based processing, so it works on any device including smartphones and tablets.\",\"flashvsr-title\":\"FlashVSR Video Upscaler\",\"flashvsr-subtitle\":\"Fast AI video super-resolution — boost resolution up to 4K, restore clarity, and recover fine detail from low-resolution or compressed footage. Optimized for speed with high-quality results, free credits on signup.\",\"flashvsr-cta-heading\":\"Upscale Your Video\",\"flashvsr-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"flashvsr-faq-1-q\":\"How does FlashVSR work?\",\"flashvsr-faq-1-a\":\"Upload a video and select a target resolution. FlashVSR uses advanced AI super-resolution to upscale and restore clarity, recovering fine detail even from blurry or heavily compressed footage.\",\"flashvsr-faq-2-q\":\"What output resolutions are supported?\",\"flashvsr-faq-2-a\":\"You can upscale to 720p, 1080p, 2K, or 4K. The AI enhances detail and sharpness at every resolution step for noticeably improved visual quality.\",\"flashvsr-faq-3-q\":\"What makes FlashVSR different from other video upscalers?\",\"flashvsr-faq-3-a\":\"FlashVSR is optimized for speed — it produces results significantly faster while maintaining high visual quality, making it ideal for quick turnaround on large batches of videos.\",\"flashvsr-faq-4-q\":\"How much does it cost?\",\"flashvsr-faq-4-a\":\"You get free credits on signup — enough to process multiple videos at no cost. After that, pricing depends on video length and target resolution; short clips cost just a few cents. No credit card needed to start.\",\"flashvsr-faq-5-q\":\"What video formats can I upload?\",\"flashvsr-faq-5-a\":\"MP4, MOV, and WebM are all supported. Your upscaled video is returned in a standard format ready for sharing or editing.\",\"flashvsr-faq-6-q\":\"How long does processing take?\",\"flashvsr-faq-6-a\":\"FlashVSR is built for speed. Short clips typically process in well under a minute, and even longer videos are handled faster than traditional upscaling approaches.\",\"flashvsr-faq-7-q\":\"Can I use upscaled videos commercially?\",\"flashvsr-faq-7-a\":\"Yes. There are no usage restrictions on the output. You can use your enhanced videos for commercial projects, social media, presentations, or any other purpose.\",\"flashvsr-faq-8-q\":\"Does FlashVSR work on mobile devices?\",\"flashvsr-faq-8-a\":\"Yes. The tool runs in your browser with cloud-based processing, so it works on any device including smartphones and tablets.\"},\"AppPages\":{\"ai-breast-expansion-title\":\"AI Breast Expansion\",\"ai-breast-expansion-subtitle\":\"Upload a portrait photo and generate an exaggerated breast enlargement transformation effect with advanced AI. The tool intelligently preserves facial features, clothing details, and background while applying the effect — fast, private, and easy to use.\",\"ai-breast-expansion-cta-heading\":\"Try It Now\",\"ai-breast-expansion-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"ai-breast-expansion-faq-1-q\":\"How does the AI breast expansion effect work?\",\"ai-breast-expansion-faq-1-a\":\"Upload a portrait photo and advanced AI applies an exaggerated breast enlargement transformation while intelligently preserving the rest of the image, including face, background, and clothing details.\",\"ai-breast-expansion-faq-2-q\":\"How realistic are the results?\",\"ai-breast-expansion-faq-2-a\":\"The AI produces visually coherent results with natural-looking proportions relative to the effect. It adjusts clothing, shadows, and body contours to maintain a believable appearance.\",\"ai-breast-expansion-faq-3-q\":\"How much does it cost?\",\"ai-breast-expansion-faq-3-a\":\"You get free credits on signup with no credit card required. Each generation costs just a few cents from your credit balance.\",\"ai-breast-expansion-faq-4-q\":\"Is my uploaded photo kept private?\",\"ai-breast-expansion-faq-4-a\":\"Yes. Uploaded photos are used only for generating the effect and are not stored permanently. Generated results are available for 7 days before automatic deletion.\",\"ai-breast-expansion-faq-5-q\":\"What image formats are supported?\",\"ai-breast-expansion-faq-5-a\":\"JPG, PNG, and WebP are all supported. For the best results, use a clear, well-lit portrait or full-body photo where the subject is facing the camera.\",\"ai-breast-expansion-faq-6-q\":\"What kind of photos work best?\",\"ai-breast-expansion-faq-6-a\":\"Clear, front-facing portrait or upper-body photos with good lighting produce the best results. Avoid heavily cropped, low-resolution, or side-angle images for optimal output quality.\",\"ai-camera-angle-title\":\"AI Camera Angle Control\",\"ai-camera-angle-subtitle\":\"Generate photorealistic multi-angle views from a single image using advanced AI. Control horizontal rotation, vertical tilt, and camera distance to create new perspective views — ideal for e-commerce product shots, 3D visualization, and creative content without a physical camera setup.\",\"ai-camera-angle-cta-heading\":\"Generate New Angles\",\"ai-camera-angle-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"ai-camera-angle-faq-1-q\":\"How does AI camera angle control work?\",\"ai-camera-angle-faq-1-a\":\"Upload 1-3 reference images and set your desired horizontal rotation, vertical tilt, and camera distance. Advanced AI generates a photorealistic new view of the subject from the specified camera angle.\",\"ai-camera-angle-faq-2-q\":\"What camera angle options are available?\",\"ai-camera-angle-faq-2-a\":\"Horizontal rotation from -90 degrees (left) to 90 degrees (right). Vertical tilt from -30 degrees (low angle) to 60 degrees (high angle). Distance options include close-up, medium, and wide shot.\",\"ai-camera-angle-faq-3-q\":\"How good is the output quality?\",\"ai-camera-angle-faq-3-a\":\"The AI produces high-resolution, photorealistic results that maintain the subject's details, textures, and lighting consistency across different viewing angles.\",\"ai-camera-angle-faq-4-q\":\"How much does it cost?\",\"ai-camera-angle-faq-4-a\":\"You get free credits on signup with no credit card required. Each multi-angle generation costs just a few cents from your credit balance.\",\"ai-camera-angle-faq-5-q\":\"What image formats are supported?\",\"ai-camera-angle-faq-5-a\":\"JPG, PNG, and WebP are all supported for uploads. You can upload up to 3 reference images to give the AI more context about the object or scene.\",\"ai-camera-angle-faq-6-q\":\"What are the best use cases?\",\"ai-camera-angle-faq-6-a\":\"E-commerce product photography, 3D asset previews, architectural visualization, game asset creation, and any scenario where you need to see an object or scene from multiple perspectives without a physical camera setup.\",\"ai-camera-angle-faq-7-q\":\"Does it work with any type of subject?\",\"ai-camera-angle-faq-7-a\":\"Yes. The AI handles objects, products, people, animals, buildings, vehicles, and full scenes. It works best when the subject is clearly visible and well-lit in the reference image.\",\"ai-dancing-title\":\"AI Dancing Video Generator\",\"ai-dancing-subtitle\":\"Make anyone dance by uploading a photo and a reference dance clip. Advanced AI motion transfer animates the person with realistic body movement, identity preservation, and smooth temporal coherence — perfect for social media content, entertainment, and creative projects.\",\"ai-dancing-cta-heading\":\"Make Anyone Dance\",\"ai-dancing-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"ai-dancing-faq-1-q\":\"How does the AI dancing video generator work?\",\"ai-dancing-faq-1-a\":\"Upload a photo of any person and a reference dance video. Advanced AI extracts the body motion from the dance clip and applies it to the person in your photo, producing a realistic dancing video while preserving their identity and appearance.\",\"ai-dancing-faq-2-q\":\"What dance styles are supported?\",\"ai-dancing-faq-2-a\":\"Any dance style works — hip-hop, ballet, salsa, K-pop choreography, TikTok trends, or freestyle. The AI extracts motion from whatever reference video you provide, so you can animate any style of dance.\",\"ai-dancing-faq-3-q\":\"How good is the video quality?\",\"ai-dancing-faq-3-a\":\"The AI generates smooth, temporally coherent video at 480p or 720p resolution. It uses first-frame identity preservation to keep the person looking like themselves throughout the entire dance sequence.\",\"ai-dancing-faq-4-q\":\"How much does it cost?\",\"ai-dancing-faq-4-a\":\"You get free credits on signup with no credit card required. Each dance video costs just a few cents, and higher resolution videos use slightly more credits.\",\"ai-dancing-faq-5-q\":\"What formats are supported for upload and download?\",\"ai-dancing-faq-5-a\":\"Upload JPG, PNG, or WebP for the person photo. The reference dance video can be MP4. The generated output is an MP4 video you can download and share instantly.\",\"ai-dancing-faq-6-q\":\"Can I add my own music to the video?\",\"ai-dancing-faq-6-a\":\"The generated video does not include audio by default. You can easily add any music track after downloading by using any basic video editor or social media app.\",\"ai-dancing-faq-7-q\":\"What kind of reference dance video works best?\",\"ai-dancing-faq-7-a\":\"Clear, well-lit videos where the dancer's full body is visible work best. TikTok clips, music videos, or your own dance recordings are all great choices.\",\"ai-image-translator-title\":\"AI Image Translator\",\"ai-image-translator-subtitle\":\"Translate text in any image to 30+ languages while perfectly preserving the original font, style, spacing, and layout. Ideal for comics, manga, signs, menus, product packaging, and documents — powered by advanced AI OCR and rendering for pixel-perfect visual fidelity.\",\"ai-image-translator-cta-heading\":\"Translate Your First Image\",\"ai-image-translator-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"ai-image-translator-faq-1-q\":\"How does the AI image translator work?\",\"ai-image-translator-faq-1-a\":\"Upload any image containing text. Advanced AI detects and extracts all text regions, translates them to your chosen language, and renders the translated text back onto the image with matching font style, size, color, spacing, and layout.\",\"ai-image-translator-faq-2-q\":\"What languages are supported?\",\"ai-image-translator-faq-2-a\":\"Over 30 languages including English, Chinese (Simplified and Traditional), Spanish, French, Arabic, Hindi, Japanese, Korean, German, Portuguese, Russian, Italian, Thai, Vietnamese, and many more.\",\"ai-image-translator-faq-3-q\":\"How accurate is the translation?\",\"ai-image-translator-faq-3-a\":\"The AI uses state-of-the-art language understanding to produce natural, context-aware translations. It handles idioms, technical terms, and colloquial expressions well, though professional review is recommended for mission-critical content.\",\"ai-image-translator-faq-4-q\":\"How much does it cost?\",\"ai-image-translator-faq-4-a\":\"You get free credits on signup with no credit card required. Each image translation costs just a few cents, making it far more affordable than manual translation services.\",\"ai-image-translator-faq-5-q\":\"What image formats are supported?\",\"ai-image-translator-faq-5-a\":\"JPG, PNG, and WebP are all supported. The output preserves the original image resolution and quality.\",\"ai-image-translator-faq-6-q\":\"What are the best use cases for AI image translation?\",\"ai-image-translator-faq-6-a\":\"Comics, manga, signs, restaurant menus, product packaging, screenshots, documents, game interfaces, social media posts, and any visual content with embedded text that needs to reach a multilingual audience.\",\"ai-image-translator-faq-7-q\":\"Does it preserve the original image layout?\",\"ai-image-translator-faq-7-a\":\"Yes. The AI matches the original font style, size, color, and spacing with extremely high visual fidelity, so the translated image looks natural and professionally done.\",\"ai-instagram-model-title\":\"AI Instagram Model\",\"ai-instagram-model-subtitle\":\"Transform any portrait into a stunning, Instagram-ready photo with advanced AI styling. Choose from 10 curated presets — including Influencer, Street Fashion, Beach, Fitness, Luxury, and Cyberpunk — to instantly create scroll-stopping social media content without a photographer.\",\"ai-instagram-model-cta-heading\":\"Create Your First Photo\",\"ai-instagram-model-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"ai-instagram-model-faq-1-q\":\"How does the AI Instagram Model generator work?\",\"ai-instagram-model-faq-1-a\":\"Upload any portrait or full-body photo. Advanced AI transforms it into a professional, Instagram-ready image using your chosen style preset and an optional text prompt for fine-grained creative control.\",\"ai-instagram-model-faq-2-q\":\"How realistic are the generated photos?\",\"ai-instagram-model-faq-2-a\":\"The AI produces highly realistic, photographic-quality results that preserve your facial features and body proportions while applying professional lighting, composition, and styling consistent with the chosen preset.\",\"ai-instagram-model-faq-3-q\":\"Can I use the photos for commercial purposes?\",\"ai-instagram-model-faq-3-a\":\"Yes. You own the generated images and can use them for social media content, brand promotion, e-commerce, or marketing. Ensure you have the rights to the original photo you upload.\",\"ai-instagram-model-faq-4-q\":\"How much does it cost?\",\"ai-instagram-model-faq-4-a\":\"You get free credits on signup with no credit card required. Each photo generation costs just a few cents, making it far more affordable than a professional photoshoot.\",\"ai-instagram-model-faq-5-q\":\"What image formats are supported?\",\"ai-instagram-model-faq-5-a\":\"JPG, PNG, and WebP are all supported for uploads. The AI generates high-resolution output images you can download instantly.\",\"ai-instagram-model-faq-6-q\":\"Is my uploaded photo kept private?\",\"ai-instagram-model-faq-6-a\":\"Yes. Your uploaded photos are used only to generate the styled output and are not stored permanently. Generated results are available for 7 days before automatic deletion.\",\"ai-kissing-title\":\"AI Kissing Video Generator\",\"ai-kissing-subtitle\":\"Transform photos into romantic kissing videos with advanced AI. Upload a couple photo or two separate portraits, and the AI generates a smooth, natural animation with realistic facial expressions and head movement — ready to download and share in seconds.\",\"ai-kissing-cta-heading\":\"Create Your First Video\",\"ai-kissing-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"ai-kissing-faq-1-q\":\"How does the AI kissing video generator work?\",\"ai-kissing-faq-1-a\":\"Upload a photo with two people or two separate portraits. Advanced AI detects faces, composes them together if needed, and generates a smooth, natural-looking kissing animation with realistic head movement and facial expressions.\",\"ai-kissing-faq-2-q\":\"How good is the video quality?\",\"ai-kissing-faq-2-a\":\"The AI produces high-quality video with natural motion, smooth transitions, and realistic facial details. The output maintains the likeness and appearance of the people in your uploaded photos.\",\"ai-kissing-faq-3-q\":\"Is my data private and secure?\",\"ai-kissing-faq-3-a\":\"Yes. Uploaded photos are used only to generate your video and are not stored permanently. Generated outputs are available for 7 days before automatic deletion.\",\"ai-kissing-faq-4-q\":\"How much does it cost?\",\"ai-kissing-faq-4-a\":\"You get free credits on signup with no credit card required. Each video generation costs just a few cents from your credit balance.\",\"ai-kissing-faq-5-q\":\"What image formats can I upload?\",\"ai-kissing-faq-5-a\":\"JPG, PNG, and WebP are all supported. For best results, use clear, well-lit portrait photos where faces are clearly visible.\",\"ai-kissing-faq-6-q\":\"Can I share the generated videos?\",\"ai-kissing-faq-6-a\":\"Absolutely. You can download and share the videos on social media, messaging apps, or anywhere else. Please use the tool responsibly and respect others' privacy and consent.\",\"ai-kissing-faq-7-q\":\"Does it work on mobile devices?\",\"ai-kissing-faq-7-a\":\"Yes. The AI kissing generator is fully responsive and works on any modern smartphone or tablet browser — no app installation required.\",\"ai-music-video-title\":\"AI Music Video Generator\",\"ai-music-video-subtitle\":\"Create professional music videos from audio and photos with advanced AI. Upload your track with 1-3 reference images, and get a full-length video (up to 10 minutes) with cinematic camera angles, smooth scene transitions, and precise lip synchronization — no video editing skills required.\",\"ai-music-video-cta-heading\":\"Create Your Music Video\",\"ai-music-video-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"ai-music-video-faq-1-q\":\"How does the AI music video generator work?\",\"ai-music-video-faq-1-a\":\"Upload an audio or music file along with 1-3 reference photos. Advanced AI generates a full music video with cinematic camera angles, smooth scene transitions, and lip sync precisely matched to the audio track.\",\"ai-music-video-faq-2-q\":\"What music and audio formats are supported?\",\"ai-music-video-faq-2-a\":\"MP3 and WAV audio files are supported. You can upload any music track, vocal recording, or audio clip up to 10 minutes long.\",\"ai-music-video-faq-3-q\":\"How good is the video quality?\",\"ai-music-video-faq-3-a\":\"The AI produces professional-quality music videos at 480p or 720p resolution in both 16:9 and 9:16 aspect ratios. The output features cinematic camera movements, smooth transitions, and accurate lip synchronization.\",\"ai-music-video-faq-4-q\":\"How much does it cost?\",\"ai-music-video-faq-4-a\":\"You get free credits on signup with no credit card required. Longer videos cost more credits proportionally, but even a full-length music video is very affordable.\",\"ai-music-video-faq-5-q\":\"Can I use the generated music videos commercially?\",\"ai-music-video-faq-5-a\":\"Yes. You own the generated video output and can use it for your music releases, social media, YouTube, or promotional content. Make sure you hold the rights to the audio and reference photos you upload.\",\"ai-music-video-faq-6-q\":\"What output formats and resolutions are available?\",\"ai-music-video-faq-6-a\":\"Videos are generated as MP4 files in 480p or 720p resolution. Both landscape (16:9) and portrait (9:16) orientations are supported, or the AI can auto-detect the best ratio from your reference images.\",\"ai-video-editor-title\":\"AI Video Editor — edit any clip with keyframe references\",\"ai-video-editor-subtitle\":\"Pin up to 9 moments, write what each should look like, preview the change as an image, then render an AI-edited video that follows those visual targets.\\nLocalised by design — anything you do not explicitly change stays exactly as the source.\",\"ai-video-editor-cta-heading\":\"Try the AI Video Editor\",\"ai-video-editor-cta-subtitle\":\"Edit any video with keyframe-level image references before rendering.\",\"ai-video-editor-faq-1-q\":\"How does the AI Video Editor work?\",\"ai-video-editor-faq-1-a\":\"Upload a video, scrub to the moments you want to change, and capture each as a keyframe. Write a short prompt for each keyframe and the AI generates a still image that previews the edit. When the references look right, click Render — the AI applies those changes to the matching moments in the video and produces a new clip.\",\"ai-video-editor-faq-2-q\":\"Why generate an image reference for each keyframe first?\",\"ai-video-editor-faq-2-a\":\"Editing a single frame is faster and cheaper than rendering a whole video. The per-keyframe reference lets you confirm the visual direction — colour grade, object placement, costume change, lighting — before spending the larger render budget on the final clip.\",\"ai-video-editor-faq-3-q\":\"How long can the input video be?\",\"ai-video-editor-faq-3-a\":\"You can upload longer videos, but only the first 15 seconds are editable and rendered in this workflow. Anything past the 15s mark is ignored at render time.\",\"ai-video-editor-faq-4-q\":\"Which models power the AI Video Editor?\",\"ai-video-editor-faq-4-a\":\"Per-keyframe image previews use Seedream 5.0 Lite Edit. The final video render uses ByteDance Seedance 2.0 Edit (higher fidelity) or Seedance 2.0 Fast Edit (cheaper, quicker). You can switch models from the settings panel before rendering.\",\"ai-video-editor-faq-5-q\":\"What kind of edits work best?\",\"ai-video-editor-faq-5-a\":\"Localised changes — outfit swaps, object replacement, colour grading, relighting, background replacement, weather changes — all work well because they can be anchored to a moment and a reference image. Very broad rewrites (e.g. changing the entire genre of footage) are less reliable.\",\"ai-video-editor-faq-6-q\":\"Can I iterate on a render?\",\"ai-video-editor-faq-6-a\":\"Yes. Every render lands in the versions strip alongside the original source. Click any version to make it the working video, tweak prompts or keyframes, then render again to produce a new version on top of that one.\",\"ai-twerk-title\":\"AI Twerk Video Generator — Make Anyone Dance\",\"ai-twerk-subtitle\":\"Turn any photo into a hilarious twerking dance video with advanced AI body animation and synchronized hip-hop music. Perfect for memes, TikTok, Instagram Reels, and sharing laughs with friends — generate your video in seconds.\",\"ai-twerk-cta-heading\":\"Make Your First Dance Video\",\"ai-twerk-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"ai-twerk-faq-1-q\":\"How does the AI twerk video generator work?\",\"ai-twerk-faq-1-a\":\"Upload any photo of a person. Advanced AI detects the body pose and structure, then animates it into an energetic twerking dance with synchronized hip-hop music — all generated in seconds.\",\"ai-twerk-faq-2-q\":\"What video quality can I expect?\",\"ai-twerk-faq-2-a\":\"The AI produces smooth, high-quality video with natural body motion and fluid dance movements. The output preserves the person's appearance and likeness from the original photo.\",\"ai-twerk-faq-3-q\":\"How much does it cost?\",\"ai-twerk-faq-3-a\":\"You get free credits on signup with no credit card required. Each twerk video costs just a few cents from your credit balance.\",\"ai-twerk-faq-4-q\":\"What image formats are supported?\",\"ai-twerk-faq-4-a\":\"JPG, PNG, and WebP are all supported. For the best results, use a clear photo where the person is fully visible with good lighting.\",\"ai-twerk-faq-5-q\":\"Is my uploaded photo kept private?\",\"ai-twerk-faq-5-a\":\"Yes. Uploaded photos are used only for video generation and are not stored permanently. Generated videos are available for download for 7 days before automatic deletion.\",\"ai-twerk-faq-6-q\":\"Can I share the videos on social media?\",\"ai-twerk-faq-6-a\":\"Absolutely. The videos are perfect for TikTok, Instagram Reels, memes, and group chats. You can download and share them anywhere — just be respectful of others when posting.\",\"virtual-try-on-title\":\"AI Virtual Try-On — See Any Outfit on You\",\"virtual-try-on-subtitle\":\"Upload your photo and clothing images to instantly see how any outfit looks on you. Powered by advanced AI body parsing and garment warping, the virtual fitting room produces photorealistic results — perfect for online shopping, e-commerce, and fashion content creation.\",\"virtual-try-on-cta-heading\":\"Try Your First Outfit\",\"virtual-try-on-cta-subtitle\":\"Get free credits on signup — no credit card needed.\",\"virtual-try-on-faq-1-q\":\"How does AI virtual try-on work?\",\"virtual-try-on-faq-1-a\":\"Upload a photo of yourself and one or more clothing images. Advanced AI analyzes your body shape, pose, and proportions, then realistically composites the garments onto your body with accurate draping, shadows, and wrinkles.\",\"virtual-try-on-faq-2-q\":\"How accurate is the clothing fit?\",\"virtual-try-on-faq-2-a\":\"The AI uses state-of-the-art body parsing and garment warping to produce highly realistic results. It accounts for body contours, fabric texture, and natural folds to make the clothes look like they were actually worn in the photo.\",\"virtual-try-on-faq-3-q\":\"Does it work with all body types?\",\"virtual-try-on-faq-3-a\":\"Yes. The AI adapts to any body shape, size, and pose. Whether you are petite, plus-size, or anywhere in between, the virtual fitting produces natural-looking results.\",\"virtual-try-on-faq-4-q\":\"What should I upload for the best results?\",\"virtual-try-on-faq-4-a\":\"For the person photo, use a clear, front-facing image with the full upper body visible and good lighting. For clothing, flat-lay photos, mannequin shots, or product images from online stores all work well.\",\"virtual-try-on-faq-5-q\":\"Can I use the results for commercial purposes?\",\"virtual-try-on-faq-5-a\":\"Yes. You own the generated images and can use them for e-commerce product pages, marketing materials, or social media. Please ensure you have rights to the original photos you upload.\",\"virtual-try-on-faq-6-q\":\"How much does it cost?\",\"virtual-try-on-faq-6-a\":\"You get free credits on signup with no credit card required. After that, each try-on costs just a few cents — far cheaper than a physical photoshoot.\",\"virtual-try-on-faq-7-q\":\"What image formats are supported?\",\"virtual-try-on-faq-7-a\":\"JPG, PNG, and WebP are all supported for both the person photo and clothing images. The output is a high-resolution image you can download instantly.\",\"virtual-try-on-faq-8-q\":\"Can I use this on my phone?\",\"virtual-try-on-faq-8-a\":\"Yes. The virtual try-on tool is fully responsive and works on any modern mobile browser — no app download needed.\"},\"TemplatePage\":{\"subtitle-image\":\"{desc} Use advanced AI to enhance, restyle, and transform your photos into stunning images — all in just a few clicks.\",\"subtitle-video\":\"{desc} Use advanced AI to enhance, restyle, and transform your photos into stunning videos — all in just a few clicks.\",\"faq-1-q-with-name\":\"How does {name} work?\",\"faq-1-a-character-and-script\":\"Upload two images — a primary photo and a reference image for styling, add descriptive text to guide the transformation, and click Generate. The AI intelligently analyzes your input and applies the \\\"{name}\\\" enhancement, producing a polished result that preserves the essence of your original while adding the desired style transformation.\",\"faq-1-a-character\":\"Upload two images — a primary photo and a reference image for styling, and click Generate. The AI intelligently analyzes your input and applies the \\\"{name}\\\" enhancement, producing a polished result that preserves the essence of your original while adding the desired style transformation.\",\"faq-1-a-script\":\"Upload a photo, add descriptive text to guide the transformation, and click Generate. The AI intelligently analyzes your input and applies the \\\"{name}\\\" enhancement, producing a polished result that preserves the essence of your original while adding the desired style transformation.\",\"faq-1-a-photo\":\"Upload a photo, and click Generate. The AI intelligently analyzes your input and applies the \\\"{name}\\\" enhancement, producing a polished result that preserves the essence of your original while adding the desired style transformation.\",\"faq-2-q\":\"What quality and resolution can I expect?\",\"faq-2-a\":\"Image outputs are generated in up to 4K resolution with vivid colors and sharp detail, perfect for social media, portfolios, or print. Video outputs are rendered in up to 1080p cinematic quality with fluid motion and professional-grade visual fidelity.\",\"faq-3-q\":\"Is it free to try?\",\"faq-3-a\":\"Yes! Every new account receives free credits on signup — no credit card required. You can experiment with different styles and enhancements before purchasing additional credits.\",\"faq-4-q\":\"Can I use the results commercially?\",\"faq-4-a\":\"Yes. All generated outputs belong to you and can be used freely for personal or commercial purposes, including marketing campaigns, product photography, social media, and client projects. No watermarks are applied.\",\"faq-5-q\":\"How long does generation take?\",\"faq-5-a-image\":\"Image generation typically completes within 10 to 60 seconds, depending on the complexity of the effect and the output resolution. Progress is shown in real time so you can track each step of the process.\",\"faq-5-a-video\":\"Video generation typically completes within 10 to 60 seconds, depending on the complexity of the effect and the output resolution. Progress is shown in real time so you can track each step of the process.\",\"faq-6-q\":\"What file formats are supported?\",\"faq-6-a\":\"Accepted input formats include JPEG, PNG, and WebP images. Generated images are output as high-quality PNG or JPEG files. Video results are delivered as MP4 files compatible with all major social media platforms and video editing applications.\",\"cta-heading-try-this-effect\":\"Try This Effect\",\"cta-heading-try-this-tool\":\"Try This Tool\",\"cta-heading-create-your-ad\":\"Create Your Ad\",\"cta-subtitle-get-free-credits\":\"Get free credits on signup — no credit card needed.\",\"ads-subtitle-image\":\"{desc} Create scroll-stopping image ads in seconds using advanced AI — no design team or expensive software required.\",\"ads-subtitle-video\":\"{desc} Create scroll-stopping video ads in seconds using advanced AI — no design team or expensive software required.\",\"ads-faq-1-a-character-and-script-image\":\"Upload a character or spokesperson photo and a product image, add a script or tagline to guide the creative direction, select whether you want image output, and click Generate. The AI combines your assets with the \\\"{name}\\\" template to produce a polished, professional ad ready for deployment across your marketing channels.\",\"ads-faq-1-a-character-and-script-video\":\"Upload a character or spokesperson photo and a product image, add a script or tagline to guide the creative direction, select whether you want video output, and click Generate. The AI combines your assets with the \\\"{name}\\\" template to produce a polished, professional ad ready for deployment across your marketing channels.\",\"ads-faq-1-a-character-image\":\"Upload a character or spokesperson photo and a product image, select whether you want image output, and click Generate. The AI combines your assets with the \\\"{name}\\\" template to produce a polished, professional ad ready for deployment across your marketing channels.\",\"ads-faq-1-a-character-video\":\"Upload a character or spokesperson photo and a product image, select whether you want video output, and click Generate. The AI combines your assets with the \\\"{name}\\\" template to produce a polished, professional ad ready for deployment across your marketing channels.\",\"ads-faq-1-a-script-image\":\"Upload a product image, add a script or tagline to guide the creative direction, select whether you want image output, and click Generate. The AI combines your assets with the \\\"{name}\\\" template to produce a polished, professional ad ready for deployment across your marketing channels.\",\"ads-faq-1-a-script-video\":\"Upload a product image, add a script or tagline to guide the creative direction, select whether you want video output, and click Generate. The AI combines your assets with the \\\"{name}\\\" template to produce a polished, professional ad ready for deployment across your marketing channels.\",\"ads-faq-1-a-photo-image\":\"Upload a product image, select whether you want image output, and click Generate. The AI combines your assets with the \\\"{name}\\\" template to produce a polished, professional ad ready for deployment across your marketing channels.\",\"ads-faq-1-a-photo-video\":\"Upload a product image, select whether you want video output, and click Generate. The AI combines your assets with the \\\"{name}\\\" template to produce a polished, professional ad ready for deployment across your marketing channels.\",\"ads-faq-2-a\":\"Video ads are generated in up to 1080p cinematic quality with smooth motion and professional-grade lighting. Image ads are generated in up to 4K resolution for crisp, detailed output that looks great on any screen size — from mobile feeds to desktop displays and print.\",\"ads-faq-3-a\":\"Yes! Every new account receives free credits on signup — no credit card required. Generate sample ads with your own product images to evaluate the quality before purchasing additional credits.\",\"ads-faq-4-a\":\"Absolutely. All generated ads are yours to use across any channel — social media campaigns, paid advertising, e-commerce listings, email marketing, websites, and more. No watermarks are applied, and there are no usage restrictions on your generated content.\",\"ads-faq-5-a-image\":\"Most ads are generated within 10 to 60 seconds. Image ads are typically faster. Real-time progress is displayed on the page so you can track each step.\",\"ads-faq-5-a-video\":\"Most ads are generated within 10 to 60 seconds. Video ads take slightly longer than images due to multi-frame rendering and motion processing. Real-time progress is displayed on the page so you can track each step.\",\"ads-faq-6-a\":\"Upload product and character images in JPEG, PNG, or WebP format. Generated image ads are delivered as high-quality PNG or JPEG files. Video ads are delivered as MP4 files optimized for social media platforms including Instagram, TikTok, Facebook, YouTube, and LinkedIn.\"},\"Dashboard\":{\"view-all-models\":\"View all models\",\"view-all-favorites\":\"View all favorites\",\"latest-models\":\"Latest Models\",\"favourite\":\"Favourites\",\"aws-monthly-spending-limit-title\":\"Monthly spending limit\",\"aws-monthly-spending-limit-description\":\"Your current AWS Marketplace monthly spending limit is \u003camount\u003e\u003c/amount\u003e. Your current credit balance is \u003cbalance\u003e\u003c/balance\u003e.\",\"aws-monthly-spending-limit-contact\":\"Need a higher limit? \u003clink\u003eContact Sales\u003c/link\u003e to request an increase.\",\"aws-monthly-spending-limit-auto\":\"If you do not contact Sales, your limit may be adjusted automatically based on your recent usage. The automatic limit is calculated as \u003cemphasis\u003e2x your average monthly usage over the past 3 months\u003c/emphasis\u003e.\",\"credit-limit-title\":\"Credit Limit\",\"credit-limit-description\":\"Your credit limit is \u003climit\u003e\u003c/limit\u003e and current available limit is \u003cbalance\u003e\u003c/balance\u003e.\",\"credit-limit-upsell\":\"Need a higher credit? \u003clink\u003eContact Sales\u003c/link\u003e to request an increase. Ensure your projects run smoothly with a higher account credit limit. By increasing your available balance, you can avoid service interruptions, support larger workloads, and scale your API usage with confidence.\",\"action-label\":\"I want to\",\"action-create-with-ai\":\"create with AI\",\"action-build-with-api\":\"build app with API\",\"journey-hide\":\"Hide Getting Started\",\"journey-show\":\"Show Getting Started\",\"journey-welcome-title\":\"Welcome to WaveSpeed!\",\"journey-welcome-description\":\"Follow these steps to get the most out of your experience. If you run into any issues, reach out to us on Discord or X—we're happy to help!\",\"journey-quick-start-title\":\"Quick start\",\"journey-quick-start-description\":\"Quick access to essential features and resources.\",\"journey-quick-start-desktop\":\"Desktop app\",\"journey-quick-start-desktop-link\":\"Download →\",\"journey-quick-start-studio\":\"AI Generator\",\"journey-quick-start-studio-link\":\"Try Now →\",\"journey-quick-start-affiliate\":\"Affiliate Program\",\"journey-quick-start-affiliate-link\":\"Join →\",\"journey-quick-start-collaborator\":\"Become a Collaborator\",\"journey-quick-start-collaborator-link\":\"Apply →\",\"journey-quick-start-inspiration\":\"Get Inspiration\",\"journey-quick-start-inspiration-link\":\"Explore →\",\"journey-quick-start-accesskey\":\"API Keys\",\"journey-quick-start-accesskey-link\":\"Manage →\",\"journey-step-create-account\":\"Create an account\",\"journey-step-add-credits\":\"Add credits\",\"journey-step-generate-first-media\":\"Generate your first media\",\"journey-step-explore\":\"Explore\",\"journey-api-title\":\"Create something with API\",\"journey-api-step1-title\":\"Get an API Key\",\"journey-api-step1-link\":\"Get →\",\"journey-api-step2-title\":\"Quick Start Guide\",\"journey-api-step2-link\":\"Check →\",\"journey-api-step3-title\":\"How to use in Python SDK\",\"journey-api-step3-link\":\"Check →\",\"journey-api-step4-title\":\"Check documentation\",\"journey-api-step4-link\":\"Check →\",\"journey-explore-title\":\"Explore models\",\"journey-explore-description\":\"Browse latest tools for image, video, and audio generation.\",\"usage\":\"Usage\",\"see-usage-statistics-per-model\":\"View usage data for the selected time range\",\"pick-a-date\":\"Pick a date\",\"quick-range-30m\":\"30 min\",\"quick-range-1h\":\"1 h\",\"quick-range-24h\":\"24 h\",\"quick-range-7d\":\"7 days\",\"quick-range-28d\":\"28 days\",\"quick-range-30d\":\"30 days\",\"quick-range-this-month\":\"This month\",\"quick-range-last-month\":\"Last month\",\"usage-per-model\":\"Usage per model\",\"total-predictions\":\"Total {total} predictions, cost {cost}\",\"model\":\"Model\",\"request-count\":\"Request Count\",\"cost\":\"Cost\",\"usage-breakdown\":\"Usage breakdown\",\"no-usage-data-yet\":\"No usage data yet, you can try to run some models.\",\"amount-usd\":\"Amount(USD)\",\"total-cost\":\"Total Cost\",\"total-requests\":\"Total Requests\",\"daily-usage\":\"Daily Usage\",\"date\":\"Date\",\"models-used\":\"Models Used\",\"avg-cost\":\"Avg Cost\",\"export\":\"Export\",\"your-outputs-are-stored-for-7-days-only-make-sure-to-download-and-save-them-before-they-expire\":\"Your outputs are stored for 7 days only. Make sure to download and save them before they expire.\",\"created\":\"Created\",\"delete\":\"Delete\",\"are-you-sure-you-want-to-delete-these-predictions\":\"Are you sure you want to delete these predictions?\",\"status\":\"Status\",\"action\":\"Action\",\"requests\":\"Requests\",\"no-predictions-found\":\"No predictions found\",\"are-you-sure-you-want-to-delete-this-prediction\":\"Are you sure you want to delete this prediction?\",\"10-per-page\":\"10/page\",\"20-per-page\":\"20/page\",\"50-per-page\":\"50/page\",\"download\":\"Download\",\"cancel\":\"Cancel\",\"i-want-to\":\"I want to\",\"current-credit-balance\":\"Current credit balance\",\"manage-credits\":\"Manage credits\",\"billing\":\"Billing\",\"request-in-last-7-days\":\"Requests in last 7 days\",\"check-history\":\"Check history\",\"check-usage\":\"Check usage\",\"show-api-requests\":\"Show API requests\",\"output\":\"Output\",\"no-recent-requests\":\"No recent requests found\",\"search-id\":\"Search ID\",\"filter-by-status\":\"Filter by status\",\"view-all-usage\":\"View all usage\",\"all-models\":\"All Models\",\"success-rate\":\"Success Rate\",\"total\":\"Total\",\"predictions\":\"predictions\",\"publish-to-hugging-face\":\"Publish to Hugging Face\",\"filter-by-model\":\"Filter by model\",\"journey-api-cli-title\":\"How to use the CLI\",\"journey-api-cli-link\":\"Check →\",\"old-api-key-warning-title\":\"API key security notice\",\"old-api-key-warning-description\":\"You have \u003ckeyCount\u003e{count}\u003c/keyCount\u003e active API key(s) that are \u003cage\u003etoo old\u003c/age\u003e. For security, we recommend that you \u003caction\u003egenerate a new API key and replace the old one\u003c/action\u003e.\",\"old-api-key-warning-usage\":\"WaveSpeedAI tracks API usage based on \u003ckey\u003eAPI key activity\u003c/key\u003e. After the new key is working, we recommend that you \u003cdelete\u003edelete the old API key\u003c/delete\u003e. Please keep your key private; leakage or misuse may result in \u003crisk\u003eunauthorized usage under your account\u003c/risk\u003e.\",\"old-api-key-warning-action\":\"Manage API keys\",\"key-rotation-bonus-title\":\"Claim ${amount} bonus for rotating your API keys\",\"key-rotation-bonus-ready-description\":\"Every legacy key has been removed and you have a new-format key in place. Click below to receive ${amount} in account credit.\",\"key-rotation-bonus-steps-description\":\"Delete every legacy API key (you still have {legacy}) and create at least one new-format key {hasNew, plural, =0 {(none yet)} other {(✓)}} to unlock ${amount} in credit.\",\"key-rotation-bonus-claim-action\":\"Claim ${amount}\",\"key-rotation-bonus-claiming\":\"Claiming…\",\"key-rotation-bonus-granted-toast\":\"Bonus credited: +${amount}\",\"key-rotation-bonus-claim-failed\":\"Could not claim the migration bonus. Please try again.\"},\"AccessKey\":{\"api-keys\":\"API Keys\",\"how-to-use-api-key\":\"How to use API key?\",\"create-key\":\"Create Key\",\"created\":\"Created\",\"status\":\"Status\",\"total_count\":\"Total calls\",\"usage_amount\":\"Spend\",\"last_used_at\":\"Last used\",\"actions\":\"Actions\",\"failed-to-fetch-access-keys\":\"Failed to fetch access keys\",\"please-enter-a-key-name\":\"Please enter a key name\",\"access-key-created-successfully\":\"Access key created successfully!\",\"failed-to-create-access-key\":\"Failed to create access key\",\"name\":\"Name\",\"key\":\"Key\",\"creating\":\"Creating...\",\"are-you-sure-you-want-to-inactive-this-access-key\":\"Are you sure you want to inactive this access key?\",\"no-access-keys-found\":\"No access keys found. Create one to get started.\",\"top-up-your-account\":\"Top up your account\",\"users-without-a-top-up-can-not-generate-an-api-key\":\"Users without a top-up can not generate an API key.\",\"please-top-up-your-account-to-continue\":\"Please top up your account to continue.\",\"top-up\":\"Top up\",\"confirm\":\"Confirm\",\"cancel\":\"Cancel\",\"enter-key-name\":\"Enter key name\",\"access-key-inactive-successfully\":\"Access key deactivated\",\"failed-to-inactive-access-key\":\"Failed to inactive access key\",\"key-copied\":\"Key copied to clipboard!\",\"copy-key\":\"Copy key\",\"copy-and-save-this-key\":\"Copy and save this API key\",\"api-key-shown-only-once\":\"This API key is shown only once. You will not be able to view it again after closing this message.\"},\"Collection\":{\"explore\":\"Explore\",\"our-selection\":\"Our selection\",\"try-it-now\":\"Try it now!\",\"see-docs\":\"See docs\",\"all-models\":\"All models\",\"models-count\":\"{count} models\",\"seo-heading\":\"{name} API — pricing \u0026 performance\",\"seo-intro\":\"Run any model in the {name} collection through a single REST API. Pay per generation — no subscriptions, no minimums — with industry-leading latency on a 99.9% uptime infrastructure.\",\"seo-features-heading\":\"Why run {name} on WaveSpeedAI\",\"seo-pricing-title\":\"Transparent pricing\",\"seo-pricing-desc\":\"Per-call pricing for every {name} model. The price is listed on each model page — no platform fees on top.\",\"seo-performance-title\":\"Optimized for low latency\",\"seo-performance-desc\":\"Most {name} image models complete in under 2 seconds. Video and 3D models run several times faster than self-hosted alternatives.\",\"seo-reliability-title\":\"99.9% uptime\",\"seo-reliability-desc\":\"Multi-region failover and automatic retries keep your production traffic online — even during provider outages.\",\"seo-faq-heading\":\"Frequently asked questions\",\"seo-faq-pricing-q\":\"How much does the {name} API cost?\",\"seo-faq-pricing-a\":\"Each model has its own per-call price listed on the model page. We bill per successful generation, with no subscription fees or minimums.\",\"seo-faq-speed-q\":\"How fast are {name} models on WaveSpeedAI?\",\"seo-faq-speed-a\":\"Image models in this collection typically complete in under 2 seconds. Video and 3D models depend on duration and resolution but are usually several times faster than self-hosted runs.\",\"seo-faq-trial-q\":\"Can I try the API without a credit card?\",\"seo-faq-trial-a\":\"Yes — every account gets $1 in free credits on signup, enough to try most {name} models without a credit card.\",\"seo-faq-limits-q\":\"Are there rate limits?\",\"seo-faq-limits-a\":\"Standard accounts have generous concurrent-job limits. Enterprise plans offer custom RPM, higher concurrency, and dedicated capacity — contact sales for details.\"},\"Collaborator\":{\"hero-title\":\"WaveSpeedAI Creator Program\",\"hero-subtitle\":\"Create with the best AI models in the world — all in one place.\",\"hub-title\":\"The AI Model Hub for Creators\",\"hub-subtitle\":\"Join creators around the world using WaveSpeedAI to build the future of AI content.\",\"join-now\":\"Join Now\",\"perks-title\":\"What You Get as a Creator\",\"perk-credits-title\":\"Monthly Credits\",\"perk-credits-desc\":\"Receive free credits every month to experiment, build, and bring your AI ideas to life.\",\"perk-models-title\":\"Access to 1000+ AI Models\",\"perk-models-desc\":\"Explore 1,000+ AI models across image, video, and multimodal creation — all in one place.\",\"perk-early-title\":\"Early Access\",\"perk-early-desc\":\"Get priority access to upcoming models and features before public release.\",\"perk-recognition-title\":\"Creator Recognition\",\"perk-recognition-desc\":\"Top creators may become WaveSpeedAI Brand Creators, gaining early access to new models, exclusive betas, and collaboration opportunities.\",\"featured-title\":\"Featured Creator Works\",\"featured-subtitle\":\"Explore some of the amazing creations made by our community.\",\"how-title\":\"How the Program Works\",\"step-label\":\"Step {number}\",\"step-1-title\":\"Create\",\"step-1-desc\":\"Create with WaveSpeedAI's AI models.\",\"step-2-title\":\"Share\",\"step-2-desc\":\"Post your work on social media.\",\"step-3-title\":\"Get Featured\",\"step-3-desc\":\"Tag @WaveSpeedAI for a chance to be featured\",\"form-title\":\"Join Our Creator Program\",\"social-required-error\":\"Please enter your social media link.\",\"submit-success\":\"Application submitted, we will get back to you as soon as possible.\",\"submit-failed\":\"Failed to submit application, please try again.\",\"pending-title\":\"Application received\",\"pending-desc-1\":\"Your application is currently under review.\",\"pending-desc-2\":\"We'll notify you once a decision is made.\",\"approved-title\":\"Congratulations! You're in 🎉\",\"approved-desc-1\":\"Welcome to the WaveSpeedAI Creator Program.\",\"approved-desc-2\":\"We'll send you the next steps soon.\",\"rejected-title\":\"Thank you for applying\",\"rejected-desc-1\":\"Our current creator cohort is full.\",\"rejected-desc-2\":\"We hope to work with you in the future.\",\"account-label\":\"Account\",\"email-label\":\"Email Address:\",\"sign-in-prompt\":\"Please sign in to apply.\",\"social-label\":\"Social Media Account Link\",\"social-placeholder\":\"Your social media link\",\"social-desc\":\"Please provide a link to your social media profile, e.g. Instagram, Twitter, TikTok, etc.\",\"sign-in\":\"Sign In\",\"submit\":\"Submit\"},\"Customers\":{\"hero-title-suffix\":\"Customer Stories\",\"hero-subtitle\":\"Latest news on AI image and video generation models.\",\"our-customers\":\"Our Customers:\",\"read-full-story\":\"Read full story\",\"freepik-title\":\"How Freepik scaled FLUX media generation to millions of requests per day with DataCrunch and WaveSpeed\",\"freepik-description\":\"Freepik has been working with DataCrunch since early 2024 to integrate state-of-the-art media generation into its AI Suite and scale beyond millions of inference requests per day. DataCrunch has been providing Freepik with its cutting-edge GPU infrastructure and managed inference services, delivering the following capabilities:\",\"colehaan-title\":\"How Cole Haan Produced a High-Converting Brand Video in 30 Minutes.\",\"colehaan-description\":\"In Cole Haan's Shanghai office, content creation used to be a race against time. For fast-paced e-commerce platforms like Douyin and Taobao, the team needed large volumes of visual assets—daily. High content refresh rates, constant A/B testing, and rapidly evolving platform algorithms made traditional production methods far too slow and too costly\",\"datacrunch-title\":\"Build vs buy: Why Anthropic chose Intercom’s Fin\",\"datacrunch-description\":\"Pioneering AI research lab Anthropic could have easily chosen to build an in-house AI agent to power its customer service. But the team saw a greater opportunity to partner with a company with deep expertise in the CS space – which led them to Intercom.\",\"novita-title\":\"How Novita AI Achieves Dual Optimization of Efficiency and Cost with WaveSpeedAI\",\"novita-description\":\"Novita AI is a company focused on AI inference infrastructure, dedicated to providing creators, developers, and enterprises with reliable and efficient video generation inference services. The company supports the deployment of multiple mainstream video generation models, covering...\"},\"FeatureCard\":{\"try-it\":\"Try it\",\"models-count\":\"{count} models\"},\"Inspiration\":{\"inspiration\":\"Inspiration\",\"filter\":\"Filter\",\"time-period\":\"Time Period\",\"all-time\":\"All time\",\"day\":\"Day\",\"week\":\"Week\",\"month\":\"Month\",\"model\":\"Model\",\"no-results\":\"No results\",\"loading\":\"Loading\",\"reset\":\"Reset\",\"check-results\":\"Check results\",\"search-by-model\":\"Search by Model\",\"latest\":\"Latest\",\"most-liked\":\"Most Liked\",\"all\":\"All\",\"all-kind\":\"All kind\",\"all-models\":\"All models\",\"kind\":\"Kind\",\"tags\":\"Tags\",\"try-it\":\"Try it\",\"more-tools\":\"More tools\",\"image-upscaler\":\"Image Upscaler\",\"generate-video\":\"Generate Video\",\"please-login-to-continue\":\"Please login to continue\",\"unliked-successfully\":\"Unliked successfully\",\"liked-successfully\":\"Liked successfully\",\"failed-to-like\":\"Failed to like\",\"no-data\":\"No data\",\"in-review\":\"In review\",\"rejected\":\"Rejected\",\"revoke\":\"Revoke\",\"loading-more\":\"Loading more...\",\"change-tags\":\"Change tags\",\"cancel-submission\":\"Cancel submission\",\"share\":\"Share\",\"copied-to-clipboard\":\"Copied to clipboard\",\"cancel-sharing\":\"Cancel sharing\",\"no-do-not-cancel\":\"No, do not cancel\",\"are-you-sure-to-cancel-sharing\":\"Are you sure to cancel sharing? This action could not be reversed.\",\"cancel-share-successfully\":\"Cancel share successfully\",\"failed-to-cancel-share\":\"Failed to cancel share\",\"yes-cancel-sharing\":\"Yes, cancel sharing\"},\"Invoices\":{\"invoice\":\"Invoice\",\"invoice-number\":\"Invoice Number\",\"date\":\"Date\",\"period\":\"Period\",\"customer-id\":\"Customer ID\",\"currency\":\"Currency\",\"details\":\"Details\",\"description\":\"Description\",\"transaction-quantity\":\"Transaction Quantity\",\"price\":\"Price(USD)\",\"amount\":\"Amount(USD)\",\"total\":\"Total(USD)\"},\"Leaderboard\":{\"last-updated\":\"Last updated\",\"total-votes\":\"Total Votes\",\"total-models\":\"Total Models\",\"rank\":\"Rank\",\"model\":\"Model\",\"score\":\"Score\",\"votes\":\"Votes\",\"organization\":\"Organization\",\"license\":\"License\",\"vision\":\"Vision\",\"text-to-image\":\"Text to Image\",\"image-edit\":\"Image Edit\",\"text-to-video\":\"Text to Video\",\"image-to-video\":\"Image to Video\",\"ranking\":\"Ranking\"},\"Members\":{\"team-members\":\"Team Members\",\"manage-your-team-members-and-their-roles\":\"Manage your team members and their roles.\",\"invite-team-member\":\"Invite Team Member\",\"email\":\"Email\",\"name\":\"Name\",\"role\":\"Role\",\"source\":\"Source\",\"created\":\"Created\",\"pending\":\"Pending\",\"invite-link-copied-to-clipboard\":\"Invite link copied to clipboard\",\"invite-sent-successfully\":\"Invite sent successfully\",\"failed-to-remove-member\":\"Failed to remove member\",\"member-removed-successfully\":\"Member removed successfully\",\"are-you-sure-you-want-to-remove-this-member\":\"Are you sure you want to remove this member?\",\"admin\":\"Admin\",\"billing\":\"Billing\",\"developer\":\"Developer\",\"invite-team-members\":\"Invite Team Members\",\"choose-a-role\":\"Choose a Role\",\"admin-has-full-access-to-account-features\":\"Admin has full access to account features. They can create and delete keys, view and interact with the billing dashboard, invite or remove team members, and change member roles.\",\"billing-can-access-and-manage-the-billing-dashboard-but-does-not-have-access-to-keys\":\"Billing can access and manage the billing dashboard, but does not have access to keys.\",\"developer-has-limited-permissions-and-cannot-access-the-billing-dashboard-or-keys\":\"Developer has limited permissions and cannot access the billing dashboard or keys.\",\"invite\":\"Invite\",\"member-invited\":\"Member Invited\",\"you-can-copy-the-link-below-to-invite-a-member\":\"You can copy the link below to invite a member\",\"copied-to-clipboard\":\"Copied to clipboard\",\"copy\":\"Copy\",\"create-team\":\"Create Team\",\"team-name\":\"Team Name\",\"team-created-successfully\":\"Team created successfully\",\"create\":\"Create\",\"enter-a-team-name\":\"Enter a team name\",\"select-role\":\"Select Role\",\"please-fill-in-all-fields\":\"Please fill in all fields\"},\"ContactSale\":{\"please-fill-in-all-required-fields\":\"Please fill in all required fields.\",\"please-enter-a-valid-email-address\":\"Please enter a valid email address.\",\"submitted-successfully-we-ll-get-back-to-you-soon\":\"Submitted successfully. We'll get back to you soon.\",\"submit-failed-please-try-again-later\":\"Submit failed. Please try again later.\",\"your-country\":\"Your country\",\"no-country-found\":\"No country found.\",\"select-option\":\"Select option\",\"filter-country\":\"Filter country...\",\"input-your-company-name\":\"Input your company name\",\"input-your-first-name\":\"Input your first name\",\"input-your-last-name\":\"Input your last name\",\"input-your-email\":\"Input your email\",\"tell-us-why-you-want-to-contact\":\"Tell us why you want to contact\",\"submitting\":\"Submitting...\",\"submit\":\"Submit\",\"company-name\":\"Company Name\",\"first-name\":\"First Name\",\"last-name\":\"Last Name\",\"inquiry-reason\":\"Inquiry Reason\",\"email\":\"Email\",\"thank-you-title\":\"Thank you!\",\"thank-you-message\":\"We've received your inquiry and will get back to you within 24 hours.\"},\"Support\":{\"support\":\"Support\",\"account\":\"Account\",\"subject\":\"Subject\",\"submit\":\"Submit\",\"email-address\":\"Email Address\",\"briefly-describe-your-issue-question-or-feedback\":\"Briefly describe your issue, question, or feedback.\",\"what-are-you-having-issues-with\":\"What are you having issues with?\",\"select-an-issue-type\":\"Select an issue type\",\"model\":\"Model\",\"deployment\":\"Deployment\",\"prediction\":\"Prediction\",\"payment-billing\":\"Payment/Billing\",\"documentation\":\"Documentation\",\"other\":\"Other\",\"how-can-we-help\":\"How can we help?\",\"describe-your-issue-question-or-feedback-in-detail\":\"Describe your issue, question, or feedback in detail.\",\"fill-out-the-form-to-create-a-support-ticket-we-ll-send-a-reply-in-an-email-as-soon-as-possible\":\"Fill out the form to create a support ticket. We'll send a reply in an email as soon as possible.\"},\"Pay\":{\"payment-processing\":\"Payment Processing\",\"please-wait-paypal-payment-processing\":\"Please wait while your payment is being processed...\",\"payment-successful\":\"Payment Successful\",\"thank-you-for-your-purchase-your-payment-has-been-successfully-processed\":\"Thank you for your purchase! Your payment has been successfully processed.\",\"explore-more\":\"Explore More\",\"automated-top-ups-setting\":\"Automated Top-ups Setting\",\"please-wait-while-we-set-up-your-automated-top-ups\":\"Please wait while we set up your automated top-ups...\",\"thank-you-for-your-trust-your-automated-top-ups-has-been-successfully-set-up\":\"Thank you for your trust! Your automated top-ups have been successfully set up.\",\"automated-top-ups-successful\":\"Automated Top-ups Successful\",\"automated-top-ups-failed\":\"Automated Top-ups Failed\",\"please-try-again-later\":\"Please try again later.\",\"set-up-automated-top-ups\":\"Set Up Automated Top-ups\",\"automated-top-ups-setting-canceled\":\"Automated Top-ups Setting Canceled\",\"the-price-must-be-at-least-10\":\"The amount must be at least $5.\",\"the-price-exceeds-the-maximum-allowed-limit-of-max-amount\":\"The amount exceeds the maximum allowed limit of ${maxAmount}.\",\"amount-must-be-a-multiple-of-1\":\"Amount must be a multiple of 1\",\"please-sign-in-to-continue\":\"Please sign in to continue.\",\"2-minimum-1-increments\":\"$$5 minimum, $1 increment\",\"top-up\":\"Top Up\",\"amount\":\"Amount\",\"generate-over-videos-or-images\":\"\u003cimages\u003e\u003c/images\u003e images or \u003cvideos\u003e\u003c/videos\u003e videos per minute.\",\"vip\":\"Be our VIP customer, custom your concurrency.\",\"concurrent\":\"Gain \u003cnumber\u003e\u003c/number\u003e concurrent tasks\",\"no-concurrent-tasks\":\"No concurrent tasks.\",\"custom\":\"Custom\",\"minimum\":\"Minimum\",\"increments\":\"increments\",\"payment-method\":\"Payment Method\",\"select-payment-vendor\":\"Select payment vendor\",\"and-more\":\"and more...\",\"enter-amount-min-amount\":\"Enter amount (min. {minAmount})\",\"my-account\":\"My Account\",\"account-balance\":\"Account Balance\",\"the-balance-never-expires\":\"The balance never expires.\",\"when-your-balance-is-less-than-threshold-amount\":\"When your balance is less than {thresholdAmount}, then top-up {rechargeAmount} with card {cardBrand}:  **** **** **** {cardLast4} {cardExpMonth}/{cardExpYear}\",\"are-you-sure-you-want-to-disable-auto-top-up\":\"Are you sure you want to disable auto top-up?\",\"auto-top-up-disabled-successfully\":\"Auto top-up disabled successfully\",\"disable\":\"Disable\",\"you-can-set-up-auto-top-up-to-avoid-running-out-of-credits\":\"You can set up auto top-up to avoid running out of credits.\",\"enable\":\"Enable\",\"date\":\"Date\",\"action\":\"Action\",\"billing\":\"Billing\",\"description\":\"Description\",\"get-invoice\":\"Get Invoice\",\"you-do-not-have-a-billing-address-so-we-will-provide-your-personal-invoice-if-you-want-to-use-a-specific-name-and-billing-address-plea