3-650dd3a1d3b6de13.js\",\"21926\",\"static/chunks/21926-455fea3a5b8f90a7.js\",\"33094\",\"static/chunks/33094-e4117856e11608db.js\",\"88746\",\"static/chunks/88746-3a0f046237c44280.js\",\"89373\",\"static/chunks/89373-5a1fa9564ebd3923.js\",\"85728\",\"static/chunks/85728-7a0578e9be7acce3.js\",\"47612\",\"static/chunks/47612-82dabe0deeb48122.js\",\"52274\",\"static/chunks/52274-bde2700ad12bd908.js\",\"33761\",\"static/chunks/33761-a986a7805e332ef8.js\",\"67547\",\"static/chunks/67547-72b91dc78978d7f4.js\",\"48487\",\"static/chunks/48487-a3545daca426eabf.js\",\"53234\",\"static/chunks/53234-f6479b4bee810537.js\",\"93340\",\"static/chunks/93340-6c90cb9a7af6c338.js\",\"24048\",\"static/chunks/24048-08e21113ec618f13.js\",\"87970\",\"static/chunks/87970-4049ab54c44c5f65.js\",\"69606\",\"static/chunks/69606-2ccc0529f98237df.js\",\"84697\",\"static/chunks/84697-0e61d1710a173850.js\",\"68999\",\"static/chunks/68999-b2cddd88f73c91d4.js\",\"91208\",\"static/chunks/91208-98f668857961b6ff.js\",\"79359\",\"static/chunks/79359-8c15d9ee7a4932d3.js\",\"37840\",\"static/chunks/37840-c3926976cfc0f9a1.js\",\"52533\",\"static/chunks/52533-c27b5f299d1786ee.js\",\"98450\",\"static/chunks/app/%5Blocale%5D/layout-f7eeefff60dfe4cf.js\"],\"CookieConsent\"]\n1d:T606,The best AI image model depends on the type of realism you want to create. Right now, GPT Image2, Nano Banana Pro, and Nano Banana 2 are considered the strongest overall AI image models for realistic image generation, thanks to their improvements in photorealism, prompt understanding, text rendering, and image editing quality.\n\nGPT Image2 is especially strong for commercial visuals, product photography, advertising creatives, and clean marketing imagery. It produces highly polished outputs with excellent typography, layout understanding, and prompt accuracy, making it popular for design workflows and branded content.\n\nNano Banana Pro and Nano Banana 2 currently lead many community rankings for photorealistic AI images. They are known for natural lighting, realistic huma"])</script><script>self.__next_f.push([1,"n faces, strong physical consistency, and high quality cinematic outputs. These models also perform extremely well for storytelling, multi character scenes, and realistic lifestyle photography.\n\nSeedream remains one of the best AI models for cinematic realism and artistic photography, especially for fashion, editorial style visuals, and atmospheric imagery. WAN and FLUX are also strong choices for realistic image generation, cinematic lighting, and creative flexibility depending on the workflow.\n\nWaveSpeedAI allows users to compare all of these leading AI image models in one platform, making it easier to choose the best model for realistic photography, ecommerce visuals, social media content, cinematic scenes, and commercial image generation workflows."])</script><script>self.__next_f.push([1,"1b:[\"$\",\"$L1c\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"SEO\":{\"home-title\":\"Ultimate AI Media Generation Platform — WaveSpeedAI\",\"home-description\":\"WaveSpeedAI home – explore the platform that speeds up image, video and audio generation so you can build AI features, creative tools and workflows faster.\",\"accesskey-title\":\"Access Key Management - WaveSpeedAI\",\"accesskey-description\":\"Manage Access Keys – create, rotate and revoke WaveSpeedAI API keys, manage permissions and keep your image, video and audio integrations secure at scale.\",\"dashboard-title\":\"Dashboard - WaveSpeedAI\",\"dashboard-description\":\"Dashboard – monitor WaveSpeedAI usage, manage projects and models, inspect requests, view logs and quickly jump into docs, billing and account settings.\",\"favourite-title\":\"Favourite - WaveSpeedAI\",\"favourite-description\":\"Favourite for WaveSpeedAI. - WaveSpeedAI\",\"inspiration-title\":\"Inspiration - WaveSpeedAI\",\"inspiration-description\":\"Inspiration for WaveSpeedAI. - WaveSpeedAI\",\"leaderboard-title\":\"AI Model Leaderboard — Top Creators \u0026 Usage Stats | WaveSpeedAI\",\"leaderboard-description\":\"See who's leading on WaveSpeedAI — top creators, most-used AI models, and community usage stats across image, video, and audio generation.\",\"share-title\":\"Prediction - WaveSpeedAI\",\"share-description\":\"Prediction for WaveSpeedAI. - WaveSpeedAI\",\"studio-title\":\"AI Studio - WaveSpeedAI\",\"studio-description\":\"WaveSpeedAI Studio – browser workspace to generate and edit images, video and audio; try models, iterate on prompts and export assets without writing code.\",\"top-up-title\":\"Top Up - WaveSpeedAI\",\"top-up-description\":\"Top Up – add credits to your WaveSpeedAI account securely so you can keep running image, video and audio jobs without interruption.\",\"sign-in-title\":\"Sign In - WaveSpeedAI\",\"sign-in-description\":\"Sign in – log into your WaveSpeedAI account to access the dashboard, manage API keys, view usage and billing and launch image, video or audio jobs.\",\"collaborator-title\":\"Collaborator - WaveSpeedAI\",\"collaborator-description\":\"Collaborator page – invite teammates, share projects and manage roles on WaveSpeedAI so product, design and engineering can ship multimodal AI together.\",\"contact-title\":\"Contact - WaveSpeedAI\",\"contact-description\":\"Contact WaveSpeedAI – reach the team for support, sales or partnership questions, and get help with account issues, integrations, pricing and onboarding.\",\"privacy-title\":\"Privacy Policy - WaveSpeedAI\",\"privacy-description\":\"Privacy Policy – learn how WaveSpeedAI handles your data, including logs, content and billing, with clear rules for retention, security and compliance.\",\"terms-title\":\"Terms of Service - WaveSpeedAI\",\"terms-description\":\"Terms of Service – WaveSpeedAI’s rules for using the platform, covering acceptable use, content policies, account responsibilities and legal limitations.\",\"contact-sales-title\":\"Contact Sales - WaveSpeedAI\",\"contact-sales-description\":\"Contact Sales – talk with the WaveSpeedAI team about pricing, enterprise plans, higher limits and custom image, video or audio deployments for your stack.\",\"affiliate-title\":\"WaveSpeedAI Affiliate Program\",\"affiliate-description\":\"WaveSpeedAI Affiliate Program - earn up to 25% commission for every paid customer you refer.\",\"public-api-title\":\"Status public API - WaveSpeedAI\",\"public-api-description\":\"Documentation for the WaveSpeedAI status page public JSON API: catalog index, overall summary, and per-component status.\",\"enterprise-title\":\"Enterprise - WaveSpeedAI\",\"enterprise-description\":\"Enterprise solutions – get dedicated support, higher limits, performance SLAs, and custom deployments for your team with WaveSpeedAI enterprise plans.\",\"models-title\":\"Browse 1,000+ AI Models — Image, Video, Audio \u0026 3D | WaveSpeedAI\",\"models-description\":\"Explore 1,000+ AI models from FLUX, Seedream, Kling, Wan, Seedance, and more. Filter by category, search by capability — all accessible via unified API or free web playground.\",\"history-title\":\"History - WaveSpeedAI\",\"history-description\":\"Review your past WaveSpeedAI generations — re-run, share or download outputs from every model you've used.\",\"serverless-title\":\"Serverless GPU - WaveSpeedAI\",\"serverless-description\":\"Deploy your own AI models on enterprise-grade serverless GPU infrastructure. Per-second billing, no cold starts.\",\"pricing-title\":\"Pricing - WaveSpeedAI\",\"pricing-description\":\"Transparent, pay-as-you-go pricing for image, video, audio and language models on WaveSpeedAI — billed per request, second, megapixel or token.\",\"customers-title\":\"Customer Stories - WaveSpeedAI\",\"customers-description\":\"See how teams use WaveSpeedAI to ship faster image, video and audio products at scale — case studies from production deployments.\",\"tool-image-upscaler-title\":\"AI Image Upscaler — Enhance Images to 4K \u0026 8K for Free | WaveSpeedAI\",\"tool-image-upscaler-description\":\"Upscale any photo to 2K, 4K, or 8K in seconds — recover detail, sharpen textures, and enlarge without quality loss. No watermark added, free to start.\",\"tool-image-upscaler-og-description\":\"Upscale any photo to 2K, 4K, or 8K in seconds — recover detail and sharpen textures instantly.\",\"tool-video-upscaler-title\":\"AI Video Upscaler — Enhance Videos to 4K for Free | WaveSpeedAI\",\"tool-video-upscaler-description\":\"Upscale any video to 720p, 1080p, 2K, or 4K — sharpen details and improve clarity while keeping smooth motion. No watermark, free to start.\",\"tool-video-upscaler-og-description\":\"Upscale any video to 4K — sharpen details and improve clarity while keeping smooth motion.\",\"tool-flashvsr-title\":\"FlashVSR — Fast AI Video Upscaler | WaveSpeedAI\",\"tool-flashvsr-description\":\"FlashVSR is a fast, high-quality video upscaler that boosts resolution and restores clarity for low-resolution or blurry footage. Up to 4K output.\",\"tool-flashvsr-og-description\":\"Fast AI video upscaler — boost resolution up to 4K.\",\"tool-flashvsr-twitter-title\":\"FlashVSR Video Upscaler | WaveSpeedAI\",\"tool-image-watermark-remover-title\":\"AI Image Watermark Remover — Remove Watermarks for Free | WaveSpeedAI\",\"tool-image-watermark-remover-description\":\"Remove text watermarks, logos, and overlays from any photo in seconds. The AI fills in what was behind the watermark naturally — free to start, no signup required.\",\"tool-image-watermark-remover-og-description\":\"Remove text watermarks, logos, and overlays from any photo in seconds — natural results, no artifacts.\",\"tool-video-watermark-remover-title\":\"AI Video Watermark Remover — Remove Watermarks from Videos | WaveSpeedAI\",\"tool-video-watermark-remover-description\":\"Remove watermarks, logos, captions, and text overlays from any video up to 10 minutes. Clean results with original quality preserved — free to start.\",\"tool-video-watermark-remover-og-description\":\"Remove watermarks, logos, and text overlays from any video — clean results with quality preserved.\",\"tool-image-background-remover-title\":\"AI Image Background Remover — Transparent PNG in Seconds | WaveSpeedAI\",\"tool-image-background-remover-description\":\"Remove image backgrounds instantly with AI. Get high-quality transparent PNGs perfect for e-commerce, product photos, graphics, and design — free to start.\",\"tool-image-background-remover-og-description\":\"Remove image backgrounds instantly with AI — high-quality transparent PNGs.\",\"tool-image-background-remover-twitter-title\":\"AI Image Background Remover | WaveSpeedAI\",\"tool-video-background-remover-title\":\"AI Video Background Remover — Remove or Replace Backgrounds | WaveSpeedAI\",\"tool-video-background-remover-description\":\"Remove or replace video backgrounds with AI. Clean matting, edge-aware blending, and natural compositing — upload a video and optionally a new background image.\",\"tool-video-background-remover-og-description\":\"Remove or replace video backgrounds with AI — clean matting and natural compositing.\",\"tool-video-background-remover-twitter-title\":\"AI Video Background Remover | WaveSpeedAI\",\"tool-image-eraser-title\":\"AI Image Eraser — Remove Objects from Photos | WaveSpeedAI\",\"tool-image-eraser-description\":\"Remove unwanted objects, people, or text from any photo with AI. The eraser reconstructs the background with natural detail and consistent lighting.\",\"tool-image-eraser-og-description\":\"Remove objects, people, or text from photos — AI fills in the background naturally.\",\"tool-image-eraser-twitter-title\":\"AI Image Eraser | WaveSpeedAI\",\"tool-video-eraser-title\":\"AI Video Eraser — Remove Objects from Videos | WaveSpeedAI\",\"tool-video-eraser-description\":\"Remove unwanted objects, people, or elements from videos with AI. Preserves quality and natural motion — supports videos up to 10 minutes.\",\"tool-video-eraser-og-description\":\"Remove objects or people from videos — AI preserves quality and natural motion.\",\"tool-video-eraser-twitter-title\":\"AI Video Eraser | WaveSpeedAI\",\"tool-image-face-swap-title\":\"AI Face Swap — Swap Faces in Photos for Free | WaveSpeedAI\",\"tool-image-face-swap-description\":\"Swap faces in any photo in seconds — pick a face from one image and place it onto another. Works with group photos, no watermark added. Free to start.\",\"tool-image-face-swap-og-title\":\"AI Face Swap — Swap Faces in Photos | WaveSpeedAI\",\"tool-image-face-swap-og-description\":\"Swap faces in any photo in seconds — works with group photos, no watermark added.\",\"tool-video-face-swap-title\":\"AI Video Face Swap — Swap Faces in Videos for Free | WaveSpeedAI\",\"tool-video-face-swap-description\":\"Swap faces in any video — upload a clip and a face photo, and the AI tracks and replaces the face across every frame. Smooth results, free to start.\",\"tool-video-face-swap-og-title\":\"AI Video Face Swap — Swap Faces in Videos | WaveSpeedAI\",\"tool-video-face-swap-og-description\":\"Swap faces in any video — the AI tracks and replaces the face across every frame smoothly.\",\"tool-video-fps-increaser-title\":\"AI Video FPS Increaser — Double Frame Rate for Smoother Video | WaveSpeedAI\",\"tool-video-fps-increaser-description\":\"Double your video frame rate with AI. Get smoother motion, better slow-motion playback, and higher quality output — upload any video and enhance it instantly.\",\"tool-video-fps-increaser-og-title\":\"AI Video FPS Increaser — Smoother Video | WaveSpeedAI\",\"tool-video-fps-increaser-og-description\":\"Double your video frame rate with AI for smoother motion and better playback.\",\"tool-video-fps-increaser-twitter-title\":\"AI Video FPS Increaser | WaveSpeedAI\",\"app-virtual-try-on-title\":\"AI Virtual Try-On — Try Clothes Online for Free | WaveSpeedAI\",\"app-virtual-try-on-description\":\"See how any outfit looks on you before buying. Upload your photo and clothing images — the AI fits them naturally on your body. Free to try, no signup required.\",\"app-virtual-try-on-og-description\":\"See how any outfit looks on you with AI — upload a photo and clothing images.\",\"app-virtual-try-on-twitter-title\":\"AI Virtual Try-On — Try Clothes Online | WaveSpeedAI\",\"app-ai-kissing-title\":\"AI Kissing Video Generator — Create Romantic Videos from Photos | WaveSpeedAI\",\"app-ai-kissing-description\":\"Turn one or two photos into a romantic kissing video with AI. Upload a couple photo or two separate portraits — the AI brings them together naturally.\",\"app-ai-kissing-og-title\":\"AI Kissing Video Generator — Create Romantic Videos | WaveSpeedAI\",\"app-ai-kissing-og-description\":\"Turn photos into romantic kissing videos with AI.\",\"app-ai-kissing-twitter-title\":\"AI Kissing Video Generator | WaveSpeedAI\",\"app-ai-twerk-title\":\"AI Twerk Video Generator — Make Anyone Dance from a Photo | WaveSpeedAI\",\"app-ai-twerk-description\":\"Turn any photo into a fun twerking dance video with AI. Upload a picture and watch it come alive with energetic dance moves and upbeat music.\",\"app-ai-twerk-og-title\":\"AI Twerk Video Generator — Make Anyone Dance | WaveSpeedAI\",\"app-ai-twerk-og-description\":\"Turn any photo into a twerking dance video with AI.\",\"app-ai-twerk-twitter-title\":\"AI Twerk Video Generator | WaveSpeedAI\",\"app-ai-instagram-model-title\":\"AI Instagram Model — Generate Stunning Instagram Photos | WaveSpeedAI\",\"app-ai-instagram-model-description\":\"Generate Instagram-style photos from your image with AI. Choose from 10 style presets — influencer, street fashion, beach, fitness, luxury, anime, cyberpunk, and more.\",\"app-ai-instagram-model-og-description\":\"Generate Instagram-style photos from your image with 10 style presets.\",\"app-ai-instagram-model-twitter-title\":\"AI Instagram Model | WaveSpeedAI\",\"app-ai-dancing-title\":\"AI Dancing Video Generator — Make Anyone Dance | WaveSpeedAI\",\"app-ai-dancing-description\":\"Turn any photo into a realistic dancing video. Upload a person image and a reference dance clip — the AI transfers the dance moves with identity preservation and smooth motion.\",\"app-ai-dancing-og-description\":\"Turn any photo into a dancing video with AI motion transfer.\",\"app-ai-dancing-twitter-title\":\"AI Dancing Video Generator | WaveSpeedAI\",\"app-ai-music-video-title\":\"AI Music Video Generator — Create Music Videos from Audio | WaveSpeedAI\",\"app-ai-music-video-description\":\"Transform audio and a photo into a full music video with cinematic camera angles, smooth transitions, and perfect lip sync. Up to 10 minutes, 480p or 720p.\",\"app-ai-music-video-og-title\":\"AI Music Video Generator | WaveSpeedAI\",\"app-ai-music-video-og-description\":\"Create full music videos from audio + a photo with AI.\",\"app-ai-music-video-twitter-title\":\"AI Music Video Generator | WaveSpeedAI\",\"app-ai-breast-expansion-title\":\"AI Breast Expansion — Photo Effect Generator | WaveSpeedAI\",\"app-ai-breast-expansion-description\":\"AI Breast Expansion transforms portrait photos with an exaggerated breast enlargement effect. Upload a photo and get an entertaining result.\",\"app-ai-breast-expansion-og-title\":\"AI Breast Expansion | WaveSpeedAI\",\"app-ai-breast-expansion-og-description\":\"Transform portrait photos with AI breast expansion effect.\",\"app-ai-breast-expansion-twitter-title\":\"AI Breast Expansion | WaveSpeedAI\",\"app-ai-image-translator-title\":\"AI Image Translator — Translate Text in Images to 30+ Languages | WaveSpeedAI\",\"app-ai-image-translator-description\":\"Translate text in any image to 30+ languages while perfectly preserving font, style, spacing, and layout. High visual fidelity output.\",\"app-ai-image-translator-og-title\":\"AI Image Translator | WaveSpeedAI\",\"app-ai-image-translator-og-description\":\"Translate text in images to 30+ languages while preserving style and layout.\",\"app-ai-image-translator-twitter-title\":\"AI Image Translator | WaveSpeedAI\",\"app-ai-camera-angle-title\":\"AI Camera Angle Control — Generate Multi-Angle Views | WaveSpeedAI\",\"app-ai-camera-angle-description\":\"Generate multiple-angle views of objects or scenes from a single image. Control horizontal rotation, vertical tilt, and camera distance with AI.\",\"app-ai-camera-angle-og-title\":\"AI Camera Angle Control | WaveSpeedAI\",\"app-ai-camera-angle-og-description\":\"Generate multi-angle views from a single image with AI camera control.\",\"app-ai-camera-angle-twitter-title\":\"AI Camera Angle Control | WaveSpeedAI\",\"app-ai-video-editor-title\":\"AI Video Editor — Keyframe-Driven Prompt Edits | WaveSpeedAI\",\"app-ai-video-editor-description\":\"Edit any video by pinning keyframes and describing what should change. Preview each edit as an image, then render with AI in one click.\",\"app-ai-video-editor-og-title\":\"AI Video Editor | WaveSpeedAI\",\"app-ai-video-editor-og-description\":\"Pin up to 9 keyframes in your clip, edit each as an image reference, then render an AI-edited video that follows those visual targets.\",\"app-ai-video-editor-twitter-title\":\"AI Video Editor | WaveSpeedAI\",\"category-professional-title\":\"Professional Camera Effects — AI Video \u0026 Image Tools | WaveSpeedAI\",\"category-professional-description\":\"Professional camera effects powered by AI. Angles, zooms, transitions, color grading, and more. Upload a photo and create cinematic video or image effects instantly.\",\"category-professional-og-title\":\"Professional Camera Effects | WaveSpeedAI\",\"category-professional-og-description\":\"Professional camera effects powered by AI.\",\"category-enhance-style-title\":\"Enhance \u0026 Style — AI Fashion \u0026 Visual Enhancement | WaveSpeedAI\",\"category-enhance-style-description\":\"AI-powered fashion and visual enhancement tools. Virtual try-on, relighting, skin enhancement, outfit swap, and more. Upload a photo and transform your style instantly.\",\"category-enhance-style-og-title\":\"Enhance \u0026 Style | WaveSpeedAI\",\"category-enhance-style-og-description\":\"AI fashion and visual enhancement tools.\",\"category-face-identity-title\":\"Face \u0026 Identity — AI Face Swap \u0026 Character Tools | WaveSpeedAI\",\"category-face-identity-description\":\"AI-powered face and identity tools. Character swap, face swap, headshot generator, and more. Transform faces in photos and videos instantly.\",\"category-face-identity-og-title\":\"Face \u0026 Identity | WaveSpeedAI\",\"category-face-identity-og-description\":\"AI face and identity transformation tools.\",\"category-video-editing-title\":\"Video Editing — AI Video Effects \u0026 Creative Tools | WaveSpeedAI\",\"category-video-editing-description\":\"AI-powered video editing tools. Outfit reels, beat-synced videos, sticker animations, background removal, and more. Create professional video content instantly.\",\"category-video-editing-og-title\":\"Video Editing | WaveSpeedAI\",\"category-video-editing-og-description\":\"AI video editing and creative effects tools.\",\"category-games-characters-title\":\"Games \u0026 Characters — AI Gaming Art \u0026 Character Creator | WaveSpeedAI\",\"category-games-characters-description\":\"AI-powered gaming art and character tools. Game styles, 3D figures, pixel art, plushies, and sketch-to-video. Transform your photos into gaming characters instantly.\",\"category-games-characters-og-title\":\"Games \u0026 Characters | WaveSpeedAI\",\"category-games-characters-og-description\":\"AI gaming art and character creation tools.\",\"category-trending-templates-title\":\"Trending Templates — Viral AI Effects \u0026 Meme Styles | WaveSpeedAI\",\"category-trending-templates-description\":\"Trending AI templates — viral effects, meme transformations, and creative styles. Turn your photos into roller coasters, comic books, Renaissance paintings, and more.\",\"category-trending-templates-og-title\":\"Trending Templates | WaveSpeedAI\",\"category-trending-templates-og-description\":\"Viral AI effects and meme styles.\",\"category-ads-title\":\"AI Ads \u0026 Products — Create Professional Ad Videos \u0026 Images | WaveSpeedAI\",\"category-ads-description\":\"Create stunning product ads with AI. 20 templates including ASMR, bullet-time, packshot, billboard, and more. Upload a product photo and generate professional video or image ads instantly.\",\"category-ads-og-title\":\"AI Ads \u0026 Products | WaveSpeedAI\",\"category-ads-og-description\":\"Create professional product ads with 20 AI templates.\",\"tools-index-title\":\"AI Image \u0026 Video Tools — Upscale, Remove Watermarks \u0026 More | WaveSpeedAI\",\"tools-index-description\":\"Free AI tools to upscale images and videos to 4K, remove watermarks, and more. No watermarks on output, professional results in seconds.\",\"tools-index-og-title\":\"AI Image \u0026 Video Tools | WaveSpeedAI\",\"tools-index-og-description\":\"Upscale, remove watermarks, enhance — free AI tools for images and videos.\",\"apps-index-title\":\"AI Tools for Creators \u0026 Marketers | WaveSpeedAI\",\"apps-index-description\":\"One-click AI effects that transform any content into professional ads, viral trends, or artistic masterpieces. Free to start.\",\"apps-index-og-description\":\"One-click AI effects for professional ads, viral trends, and creative content.\",\"about-title\":\"About WaveSpeedAI — The Ultimate AI Media Generation Platform\",\"about-description\":\"WaveSpeedAI accelerates AI image, video, and audio generation with 1000+ models, sub-second inference, and no cold starts. Built for developers, creators, and enterprises.\",\"about-og-title\":\"About WaveSpeedAI\",\"about-og-description\":\"The ultimate AI media generation platform — 1000+ models, blazing fast inference, built for everyone.\",\"github-page-title\":\"Github\",\"github-page-description\":\"Github\",\"cli-page-title\":\"WaveSpeed CLI — Every AI model from your terminal\",\"cli-page-description\":\"Open-source command-line tool to run any WaveSpeed AI model. Dynamic per-model help, alias shortcuts, and pipe-safe JSON output. Install with one command.\",\"return-policy-title\":\"Return Policy - WaveSpeedAI\",\"return-policy-description\":\"WaveSpeedAI return and refund policy for AI API services.\",\"llm-title\":\"LLM Models - API Pricing \u0026 Comparison | WaveSpeed\",\"llm-description\":\"Compare 290+ LLM models with transparent pricing. Access GPT-5.5, Claude Opus 4.7, Gemini 3, DeepSeek R1, Llama 4, Grok 4 and more through a unified OpenAI-compatible API on WaveSpeed.\",\"llm-keywords\":\"LLM, large language model, GPT-4, Claude, Gemini, AI API, model pricing, model comparison, WaveSpeed\",\"llm-log-title\":\"LLM Log\",\"llm-log-description\":\"LLM Log\",\"llm-monitor-title\":\"LLM Monitor\",\"llm-monitor-description\":\"LLM Monitor\",\"llm-playground-title\":\"LLM Playground — Test AI Models Online | WaveSpeedAI\",\"llm-playground-description\":\"Test and compare 290+ LLM models in a live playground. Try GPT-5.5, Claude Opus 4.7, Gemini 3, DeepSeek R1, Llama 4, Grok 4 and more — see responses, latency, and costs in real time.\",\"llm-path-title\":\"LLM API Pricing \u0026 Performance | WaveSpeedAI\",\"llm-path-description\":\"Compare pricing, speed, and performance for 290+ LLM models including GPT-5.5, Claude Opus 4.7, Gemini 3, DeepSeek R1, Llama 4, Grok 4, and more. Unified API access with no cold starts.\",\"llm-page-h1\":\"LLM API — Access 290+ AI Models\",\"llm-page-lead\":\"Compare pricing, speed, and performance for GPT-5.5, Claude Opus 4.7, Gemini 3, Qwen 3, DeepSeek R1, Llama 4, Grok 4, and more. Unified OpenAI-compatible API with no cold starts and transparent per-token pricing.\",\"llm-page-features-title\":\"Why Choose WaveSpeedAI for LLMs\",\"llm-page-feature-models-title\":\"290+ Models\",\"llm-page-feature-models-desc\":\"GPT, Claude, Gemini, Qwen, DeepSeek, Llama, Grok, Mistral — all in one unified API.\",\"llm-page-feature-compat-title\":\"OpenAI Compatible\",\"llm-page-feature-compat-desc\":\"Drop-in replacement for OpenAI SDK. Switch models with one line of code.\",\"llm-page-feature-cold-title\":\"No Cold Starts\",\"llm-page-feature-cold-desc\":\"Models are always warm. First-token latency measured in milliseconds.\",\"llm-page-feature-pay-title\":\"Pay Per Token\",\"llm-page-feature-pay-desc\":\"Transparent pricing with no subscriptions. Only pay for what you use.\",\"llm-page-faq-title\":\"Frequently Asked Questions\",\"llm-page-faq-pricing-q\":\"How does pricing work?\",\"llm-page-faq-pricing-a\":\"You pay per token — input and output tokens are priced separately. No subscriptions, no minimum commitments. Check the pricing table above for per-model rates.\",\"llm-page-faq-compat-q\":\"Is the API compatible with OpenAI?\",\"llm-page-faq-compat-a\":\"Yes. Our API is fully OpenAI-compatible. Use the OpenAI SDK and just change the base URL and API key.\",\"llm-page-faq-models-q\":\"What models are available?\",\"llm-page-faq-models-a\":\"We offer 290+ models from 30+ providers including OpenAI GPT-5.5 \u0026 GPT-5.4, Anthropic Claude Opus 4.7, Google Gemini 3, Qwen 3, DeepSeek R1 \u0026 V3, Meta Llama 4, xAI Grok 4, Mistral, and many more.\",\"llm-page-faq-limits-q\":\"Are there rate limits?\",\"llm-page-faq-limits-a\":\"Rate limits depend on your plan. Free tier includes generous limits for testing. Paid plans offer higher throughput.\",\"llm-page-cta-models-title\":\"Explore 1,000+ AI Models\",\"llm-page-cta-models-desc\":\"Image, video, 3D, audio, and more — beyond LLMs.\",\"llm-page-cta-docs-title\":\"API Documentation\",\"llm-page-cta-docs-desc\":\"Get started in minutes with Python, JavaScript, or cURL.\",\"llm-page-not-found-title\":\"Model not found\",\"llm-page-not-found-desc\":\"We couldn't find a model matching this page. Browse the \u003clink\u003efull LLM catalog\u003c/link\u003e to explore available models.\",\"llm-model-input\":\"Input\",\"llm-model-output\":\"Output\",\"llm-model-discount\":\"Discount\",\"llm-model-context\":\"Context\",\"llm-model-max-output\":\"Max Output\",\"llm-model-vision\":\"Vision\",\"llm-model-tool-use\":\"Tool Use\",\"llm-model-supported\":\"Supported\",\"llm-model-free\":\"Free\",\"llm-model-discount-off\":\"{percent}% off\",\"llm-model-try-on\":\"Try {model} on WaveSpeedAI\",\"llm-model-try-desc\":\"Access {model} through our unified API — OpenAI-compatible, no cold starts, transparent pricing.\",\"llm-model-open-playground\":\"Open Playground\",\"llm-model-explore-llms\":\"Explore LLMs\",\"llm-model-faq-title\":\"Frequently Asked Questions about {model}\",\"llm-model-faq-cost-q\":\"How much does {model} cost via the API?\",\"llm-model-faq-cost-a\":\"Pricing on WaveSpeedAI: {input} per million input tokens and {output} per million output tokens. Prompt caching and batch processing are billed separately and reduce effective cost on long, repetitive workloads.\",\"llm-model-faq-context-q\":\"What is the context window of {model}?\",\"llm-model-faq-context-a\":\"{model} supports up to {context} tokens of context with up to {maxOutput} tokens of output per request.\",\"llm-model-faq-compat-q\":\"Is {model} OpenAI-compatible?\",\"llm-model-faq-compat-a\":\"Yes. WaveSpeedAI exposes {model} through an OpenAI-compatible endpoint at https://llm.wavespeed.ai/v1. Point the official OpenAI SDK at this base URL with your WaveSpeedAI API key — no other code changes required.\",\"llm-model-faq-access-q\":\"How do I get started with {model}?\",\"llm-model-faq-access-a\":\"Sign in to WaveSpeedAI, create an API key in Access Keys, then send a request to https://llm.wavespeed.ai/v1/chat/completions with model id set to the value shown above. New accounts receive free credits to evaluate {model} before paying per token.\",\"llm-model-related-title\":\"Related LLM APIs\",\"seo-ads-template-title\":\"{name} — AI Ad Generator | WaveSpeedAI\",\"seo-ads-template-description-video\":\"{desc} Create professional video ads with AI — no design skills nee