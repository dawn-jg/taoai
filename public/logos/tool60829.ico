ble\":\"Add card to enable auto top-up\",\"enable-auto-top-up\":\"Enable Auto Top-up\",\"payment-method-card\":\"Credit Card\",\"payment-method-link\":\"Payment Link\",\"payment-method-admin\":\"Admin Manual\",\"payment-method-admin-recharge\":\"Admin Recharge\",\"payment-method-admin-link\":\"Admin Payment Link\",\"payment-method-invite\":\"Invite Bonus\",\"payment-method-bancontact\":\"Bancontact\",\"payment-method-eps\":\"EPS\",\"payment-method-paypal\":\"PayPal\",\"payment-method-stripe-auto\":\"Stripe Auto Top-up\",\"coupon-code-placeholder\":\"Coupon code\",\"throughput-img-vid-per-min\":\"{images} img/min · {videos} vid/min\",\"concurrency-value\":\"Concurrency: {count}\",\"contact-us-for-concurrency-setup\":\"Contact us for concurrency setup\",\"airwallex-checkout-summary-title\":\"Recharge\",\"airwallex-pay-to-merchant\":\"Pay to WaveSpeedAI\",\"airwallex-order-amount-label\":\"Order amount\",\"airwallex-credits-disclaimer\":\"You'll receive {amount} USD in credits. Local currency rates and card issuer fees are handled by your provider or bank.\"},\"Billing\":{\"prediction-id-placeholder\":\"Prediction ID\",\"reset\":\"Reset\",\"search\":\"Search\",\"access-key\":\"Access Key\",\"prediction-id\":\"Prediction ID\",\"model\":\"Model\",\"date\":\"Date\",\"amount\":\"Amount\",\"showing-results\":\"Showing {from} to {to} of {total} results\",\"invalid-page-number\":\"Invalid page number\",\"go\":\"Go\",\"export-billing-by-specific-month\":\"Export Billing By Specific Month\",\"year\":\"Year\",\"select-year\":\"Select Year\",\"month\":\"Month\",\"select-month\":\"Select Month\",\"cancel\":\"Cancel\",\"export\":\"Export\"},\"Settings\":{\"profile-title\":\"Profile Settings\",\"profile-description\":\"Manage your personal information and preferences\",\"basic-info\":\"Basic Info\",\"email\":\"Email\",\"username\":\"Username\",\"login-methods\":\"Login Methods\",\"my-team\":\"My Team\",\"account-level-title\":\"Account Level\",\"account-level-description\":\"View and upgrade your account level\",\"account-level-intro\":\"WaveSpeedAI offers four account levels to suit different usage requirements:\",\"account-level-table-level\":\"Level\",\"account-level-table-images-per-min\":\"Images/min\",\"account-level-table-videos-per-min\":\"Videos/min\",\"account-level-table-max-concurrent\":\"Max Concurrency\",\"account-level-table-activation\":\"Activation\",\"account-level-current\":\"Current\",\"account-level-bronze\":\"Bronze\",\"account-level-silver\":\"Silver\",\"account-level-gold\":\"Gold\",\"account-level-ultra\":\"Ultra\",\"account-level-no-activation\":\"-\",\"account-level-activation-100\":\"One-time top-up of $100\",\"account-level-activation-1000\":\"One-time top-up of $1,000\",\"account-level-activation-10000\":\"One-time top-up of $10,000\",\"account-level-how-to-upgrade-title\":\"How to upgrade:\",\"account-level-how-to-upgrade-description\":\"Simply make a payment through our platform to automatically upgrade to your desired tier.\",\"account-level-upgrade-now\":\"Upgrade Now\"},\"Models\":{\"search-model\":\"Quickly search across 1000+ models by name or capability, and click to find the best model for your needs.\",\"try\":\"Try\",\"model-groups\":\"Model Groups\",\"category\":\"Category\",\"all-models\":\"All Models\",\"models\":\"Models\",\"clear\":\"Clear\",\"newest\":\"Newest\",\"most-popular\":\"Most Popular\",\"best-match\":\"Best Match\",\"loading\":\"Loading\",\"load-more\":\"Load More\",\"featured-models\":\"Featured Models\",\"no-models-found\":\"No models found\",\"generation-failed-the-cost-has-been-refunded\":\"Generation failed. The cost has been refunded.\",\"task-failed-please-try-again-later\":\"Task failed, please try again later.\",\"please-login-first\":\"Please login first\",\"failed-to-run-the-model\":\"Failed to run the model\",\"home\":\"Home\",\"explore\":\"Explore\",\"schema\":\"Schema\",\"llms\":\"LLMs\",\"open-markdown-content\":\"Open Markdown content\",\"copy-content\":\"Copy content\",\"open-in-chatgpt\":\"Open in ChatGPT\",\"open-in-claude\":\"Open in Claude\",\"playground\":\"Playground\",\"examples\":\"Examples\",\"documentation\":\"Documentation\",\"run\":\"Run\",\"taken\":\"taken\",\"the-task-hasnt-finished-yet-please-wait-a-moment-or-try-again-later\":\"The task hasn't finished yet. Please wait a moment or try again later.\",\"enable-comparision\":\"Enable comparision\",\"toggle-on-to-view-before-and-after-results-if-disabled-only-the-processed-output-will-be-shown\":\"Toggle on to view before-and-after results. If disabled, only the processed output will be shown.\",\"enable-image-magnification\":\"Enable Image Magnification\",\"your-request-will-cost\":\"Your request will cost \u003ccost\u003e\u003c/cost\u003e \u003cmodel\u003e\u003c/model\u003e.\",\"per-5-second-video-length\":\"per 5-second video length\",\"per-run\":\"per run\",\"for-you-can-run-this-model-approximately\":\"For \u003ccost\u003e\u003c/cost\u003e you can run this model approximately \u003ctimes\u003e\u003c/times\u003e times.\",\"one-more-thing\":\"Next:\",\"share-inspiration\":\"Share Inspiration\",\"image-upscaler\":\"Image Upscaler\",\"remove-background\":\"Remove Background\",\"image-eraser\":\"Image Eraser\",\"generate-video\":\"Generate Video\",\"add-sound\":\"Add Sound\",\"video-upscaler\":\"Video Upscaler\",\"video-upscaler-pro\":\"Video Upscaler Pro\",\"video-extend\":\"Video extend\",\"view-all\":\"View all\",\"related-models\":\"Related Models\",\"attention\":\"Attention\",\"only-paid-user-can-use-this-model-you-can-top-up-to-continue\":\"Only paid user can use this model. You can \u003ctopUp\u003e\u003c/topUp\u003e to continue.\",\"close\":\"Close\",\"top-up\":\"Top up\",\"prompt-examples\":\"Prompt Examples\",\"examples-are-generated-using-the\":\"Examples are generated using the {name}. \",\"no-examples-found\":\"No examples found\",\"running\":\"Running...\",\"calculating-price\":\"Calculating price...\",\"off\":\"OFF\",\"reset\":\"Clear\",\"added-to-favourite\":\"This model has been added to \u003clink\u003e\u003c/link\u003e\",\"failed-to-add-to-favourite\":\"Failed to add to favourites\",\"add-to-favourite\":\"Add to favourites\",\"remove-from-favourite\":\"Remove from favourite\",\"favourite\":\"Favourites\",\"latest-models\":\"Latest Models\",\"view-all-models\":\"View all models\",\"create-for-free\":\"Create for Free\",\"generate\":\"Generate\",\"name\":\"Name\",\"preview\":\"Preview\",\"submitting\":\"Submitting...\",\"input\":\"Input\",\"idle\":\"Idle\",\"search\":\"Search\",\"accessibility-label\":\"Accessibility:\",\"accessibility-third-party-ai\":\"This website uses AI models provided by third parties.\",\"api-landing-pages-title\":\"Per-model API landing pages\",\"faq-title\":\"WaveSpeedAI Models — Frequently asked questions\",\"faq-q1-question\":\"What is WaveSpeedAI?\",\"faq-q1-answer\":\"WaveSpeedAI is an AI inference platform that exposes 1,000+ image, video, audio, and 3D models from providers like ByteDance, Google, Alibaba, OpenAI, Kuaishou, ElevenLabs, and more — all behind a single REST API and one billing account. No per-provider setup, no separate API keys, no per-vendor rate-limit juggling.\",\"faq-q2-question\":\"How do I use a model on WaveSpeedAI?\",\"faq-q2-answer\":\"Pick a model from the catalog above, open its playground page, then either run it interactively or copy the auto-generated Python / JavaScript / cURL example into your own code. Submission returns a prediction id; poll the prediction endpoint until status is \\\"completed\\\" and read the output URL from data.outputs[0]. Full docs at wavespeed.ai/docs.\",\"faq-q3-question\":\"How is pricing calculated?\",\"faq-q3-answer\":\"Each model lists a base price per run. The final charge scales with the parameters you set (resolution, duration, output count, references — whichever knobs that model exposes), and the exact cost for your current input is shown live next to the Generate button before you submit. Pricing is per output, not per second of compute, so it stays predictable as you scale.\",\"faq-q4-question\":\"Do I need an API key to try a model?\",\"faq-q4-answer\":\"You can run any model from the in-browser playground without writing code. Once you want to integrate the API into your own app you create an API key from /accesskey — new accounts get free starter credits.\",\"faq-q5-question\":\"Which model categories are available?\",\"faq-q5-answer\":\"Image generation (text-to-image, image editing), video generation (text-to-video, image-to-video, video editing, video extend), motion control + digital humans, 3D asset generation, audio + speech synthesis, upscalers, watermark / object removal, and 1,000+ LoRA variants. Filter the catalog by type using the pills above the grid.\",\"faq-q6-question\":\"Can I run multiple models with one account?\",\"faq-q6-answer\":\"Yes — one API key, one billing account, one rate-limit envelope across every model. Cross-vendor workflows (e.g. Seedream → Seedance → upscaler) compose without juggling separate authentications.\"},\"Predictions\":{\"prediction-detail\":\"Prediction Detail\",\"reminder\":\"Reminder\",\"your-outputs-are-stored-for-7-days-only-this-prediction-id-has-been-archived\":\"Your outputs are stored for 7 days only, this prediction \u003cid\u003e\u003c/id\u003e has been archived.\",\"previous-prediction\":\"Previous Prediction\",\"next-prediction\":\"Next Prediction\",\"model\":\"Model\",\"status\":\"Status\",\"created\":\"Created\",\"time-taken\":\"Time Taken\",\"cost\":\"Cost\",\"your-outputs-are-stored-for-7-days-only-make-sure-to-download-and-save-them-before-they-expire\":\"Your outputs are stored for 7 days only. Make sure to download and save them before they expire.\",\"form\":\"Form\",\"toggle-on-to-view-before-and-after-results-if-disabled-only-the-processed-output-will-be-shown\":\"Toggle on to view before-and-after results. If disabled, only the processed output will be shown.\",\"enable-comparision\":\"Enable comparision\",\"result\":\"Result\",\"customize\":\"Customize\",\"share\":\"Share\"},\"Favourite\":{\"my-favourite-models\":\"My Favourite Models\",\"all\":\"All\",\"text-to-image\":\"Text to Image\",\"image-to-image\":\"Image to Image\",\"text-to-video\":\"Text to Video\",\"image-to-video\":\"Image to Video\",\"video-to-video\":\"Video to Video\",\"other\":\"Other\",\"remove-from-favourites\":\"Remove from Favourites\",\"cancel\":\"Cancel\",\"remove\":\"Remove\",\"are-you-sure-you-want-to-remove-model-from-favourites\":\"Are you sure you want to remove {model} from your favourites?\",\"this-action-cannot-be-undone\":\"This action cannot be undone.\",\"removed-from-favourite\":\"Removed from favourite\",\"failed-to-remove-from-favourite\":\"Failed to remove from favourite\",\"no-data\":\"No data\"},\"FakeGenerator\":{\"eyebrow\":\"Start creating\",\"tab-image\":\"Image\",\"tab-video\":\"Video\",\"tab-avatar\":\"Avatar\",\"placeholder-image\":\"Describe an image you want to generate…\",\"placeholder-video\":\"Describe a video you want to create…\",\"placeholder-avatar\":\"Describe what your AI avatar should say or do…\",\"cta\":\"Generate\",\"tab-audio\":\"Audio\",\"placeholder-audio\":\"Describe the music or speech you want…\",\"upload-attached\":\"Image attached\",\"upload-clear\":\"Remove image\",\"upload-image-only\":\"Please choose an image file\",\"upload-failed\":\"Upload failed\",\"upload-cta\":\"Image\",\"sample-image-1\":\"Professional headshot of a confident woman in her 30s, soft studio lighting, neutral backdrop\",\"sample-image-2\":\"Skincare bottle on marble counter, morning light, minimal editorial product shot\",\"sample-image-3\":\"Couple sharing coffee in a sunlit loft, natural lifestyle photo, warm tones\",\"sample-video-1\":\"Slow-motion macro of mascara applying to lashes, glossy beauty ad\",\"sample-video-2\":\"Confident model walking through a modern office in a tailored suit, cinematic\",\"sample-video-3\":\"Aerial reveal of a luxury sedan on a coastal highway at golden hour\",\"sample-avatar-1\":\"Friendly real-estate agent presenting a luxury home, eye contact, natural light\",\"sample-avatar-2\":\"Polished CEO delivering a quarterly update in a glass-walled office\",\"sample-avatar-3\":\"Energetic fitness coach explaining a workout, bright gym backdrop, 9:16\",\"sample-audio-1\":\"Upbeat acoustic guitar bed for a coffee brand ad, 30 seconds\",\"sample-audio-2\":\"Warm female narrator: \\\"Introducing our new fragrance collection...\\\"\",\"sample-audio-3\":\"Confident male voiceover for a luxury car commercial, deep resonant tone\",\"placeholder-image-edit\":\"Describe how to edit this image…\",\"placeholder-video-edit\":\"Describe how this image should move…\",\"placeholder-avatar-edit\":\"Describe what this person should say or do…\"},\"AudioRecorder\":{\"record-audio\":\"Record Audio\",\"use-your-mic-to-record-the-audio\":\"Use your mic to record the audio.\",\"no-recording-yet\":\"No recording yet. \",\"click-to-record\":\"You can click the following “Start Recording” button to record.\",\"start-recording\":\"Start Recording\",\"stop-recording\":\"Stop Recording\",\"retake\":\"Retake\",\"use-audio\":\"Use Audio\"},\"Survey\":{\"title\":\"Product Experience Survey\",\"individual-or-company\":\"Individual or Company?\",\"individual\":\"Individual\",\"company\":\"Company\",\"company-name\":\"What's your company name?\",\"company-size\":\"Company Size\",\"select-an-option\":\"Select an option\",\"company-size-up-to-5\":\"Up to 5\",\"company-size-5-25\":\"5-25\",\"company-size-25-100\":\"25-100\",\"company-size-101-1000\":\"101-1000\",\"company-size-1000-plus\":\"1000+\",\"role\":\"What's your role?\",\"role-developer\":\"Developer / Engineer\",\"role-ml-engineer\":\"Machine Learning Engineer\",\"role-researcher\":\"Researcher / Scientist\",\"role-product-manager\":\"Product Manager\",\"role-technical-lead\":\"Technical Lead / Architect\",\"role-content-creator\":\"Content Creator\",\"role-student\":\"Student\",\"role-other\":\"Other\",\"source\":\"Where did you hear about us?\",\"source-google\":\"Google\",\"source-github\":\"GitHub\",\"source-community\":\"Community (e.g. Reddit, Discord, etc.)\",\"source-chatgpt\":\"ChatGPT or other AI\",\"source-tech-conference\":\"Tech conference / meetup\",\"source-blog\":\"Blog / Article\",\"source-friend\":\"Friend or colleague\",\"source-other\":\"Other\",\"preferred-models\":\"Which model would you like to use?\",\"model-flux\":\"flux\",\"model-wan\":\"wan\",\"model-hunyuan\":\"hunyuan\",\"model-kling\":\"kling\",\"model-hidream\":\"hidream\",\"model-other\":\"other\",\"other-model\":\"Other Model\",\"other-model-placeholder\":\"Which model do you prefer?\",\"other-model-description\":\"Other Model Description\",\"other-model-description-placeholder\":\"You can describe the model you'd like to use\",\"submit\":\"Submit\",\"skip\":\"Skip\"},\"Affiliate\":{\"hero-title\":\"WaveSpeedAI Affiliate Program\",\"join-now\":\"Join now\",\"high-commissions\":\"High commissions\",\"easy-tracking\":\"Easy tracking\",\"what-is-title\":\"What is WaveSpeedAI's Affiliate Program\",\"who-can-become-title\":\"Who can become an affiliate\",\"how-does-it-work-title\":\"How does it work\",\"faq-title\":\"Frequently Asked Questions\",\"faq-subtitle\":\"Have questions about our affiliate program? Find answers to the most common questions below.\",\"hero-subtitle-v2-prefix\":\"Earn\",\"hero-subtitle-v2-commission\":\"10% commission\",\"hero-subtitle-v2-suffix\":\"for every paid customer you refer.\",\"what-is-description-v2\":\"The WaveSpeedAI Affiliate Program allows creators, influencers, and partners to earn by promoting our products. We use Tolt for reliable tracking, making it easy to sign up and generate your unique referral link in just one click. Earn a 10% commission on all payments made by new users within their first 30 days after registering through your link. Simple, transparent, and built for long-term growth.\",\"who-can-become-tagline\":\"Anyone with an audience or network.\",\"who-can-become-description-v2\":\"Creators, influencers, educators, agencies, consultants, and partners are all welcome. If you can share it, you can earn from it.\",\"step-join-title\":\"Join Instantly\",\"step-join-desc\":\"Click \\\"Join Now\\\" and get your affiliate link right away.\",\"step-share-title\":\"Share With Your Audience\",\"step-share-desc\":\"Promote WaveSpeedAI anywhere your audience engages with you.\",\"step-paid-title\":\"Get Paid\",\"step-paid-desc\":\"Earn 10% commission on all payments made within 30 days of a new user's registration.\",\"faq-commission-question\":\"How much commission can I earn?\",\"faq-commission-answer\":\"Affiliates earn 10% commission on payments made by referred users. \u003cbr /\u003e The maximum total commission per customer is capped at $10.\",\"faq-cookie-question\":\"How long does the referral cookie last?\",\"faq-cookie-answer\":\"Our cookie duration is 30 days. \u003cbr /\u003e If someone signs up within 30 days after clicking your referral link, the referral will be attributed to your account.\",\"faq-minpayout-question\":\"Is there a minimum payout amount?\",\"faq-minpayout-answer\":\"No. The minimum payout threshold is $0.00, which means any confirmed commission balance is eligible for payout.\",\"faq-payouts-question\":\"When are payouts sent?\",\"faq-payouts-answer\":\"Payouts follow a NET-15 schedule. \u003cbr /\u003e\\nCommissions earned during a given month are processed 15 days after the end of that month. \u003cbr /\u003e\\nExample: \u003cbr /\u003e\\nCommissions earned in April will be paid around May 15.\u003cbr /\u003e\",\"faq-track-question\":\"How do I track my referrals and earnings?\",\"faq-track-answer\":\"We use Tolt to manage our affiliate program. \u003cbr /\u003e\\n Once you sign up, you'll get access to your affiliate dashboard, where you can: \u003cbr /\u003e\\n- Get your unique referral link \u003cbr /\u003e\\n- Track clicks, signups, and conversions \u003cbr /\u003e\\n- Monitor your commission earnings \u003cbr /\u003e\"},\"Pricing\":{\"hero-title\":\"Simple and transparent pricing\",\"image-video-models-title\":\"Image \u0026 Video Models\",\"language-models-title\":\"Language Models\",\"serverless-gpu-title\":\"Serverless GPU\",\"enterprise-dedicated-account-manager-title\":\"Dedicated account manager\",\"enterprise-dedicated-account-manager-description\":\"Get personalized support from a dedicated team member who understands your needs.\",\"enterprise-priority-support-title\":\"Priority support\",\"enterprise-priority-support-description\":\"Fast-track your requests with priority access to our engineering team.\",\"enterprise-higher-gpu-limits-title\":\"Higher GPU limits\",\"enterprise-higher-gpu-limits-description\":\"Scale without constraints with increased GPU allocation and concurrent processing.\",\"enterprise-performance-slas-title\":\"Performance SLAs\",\"enterprise-performance-slas-description\":\"Guaranteed uptime and performance with enterprise-grade service level agreements.\",\"volume-discounts-title\":\"Volume discounts available\",\"table-model\":\"Model\",\"table-unit\":\"Unit\",\"table-price\":\"Price\",\"table-output-per-dollar\":\"Output per $1\",\"table-context-window\":\"Context Window\",\"table-input-price\":\"Input Price\",\"table-output-price\":\"Output Price\",\"table-gpu\":\"GPU\",\"table-vram\":\"VRAM\",\"button-contact-sales\":\"Contact Sales\",\"button-start-building\":\"Start building for free\",\"unit-image\":\"image\",\"unit-second\":\"second\",\"output-images\":\"{count} images\",\"output-seconds\":\"{count} seconds\",\"output-7-images\":\"7 images\",\"output-25-images\":\"25 images\",\"output-33-images\":\"33 images\",\"output-200-images\":\"200 images\",\"output-10-seconds\":\"10 seconds\",\"output-20-seconds\":\"20 seconds\",\"output-3-seconds\":\"3 seconds\",\"output-33-seconds\":\"33 seconds\",\"output-100-seconds\":\"100 seconds\",\"output-7-seconds\":\"7 seconds\",\"hero-subtitle\":\"Pay only for what you use. No hidden fees, no surprises. Scale from prototype to production with predictable costs.\",\"hero-no-credit-card\":\"No credit card required • Start with $1 free credits\",\"image-video-models-subtitle\":\"State-of-the-art generation with models from WaveSpeed, OpenAI, Google, and more.\",\"pricing-doc-note\":\"Prices may vary based on resolution and generation parameters.\",\"pricing-doc-link\":\"See full pricing documentation\",\"language-models-subtitle-prefix\":\"Access leading LLMs with OpenAI-compatible API. 1K tokens\",\"language-models-subtitle-suffix\":\"750 words.\",\"serverless-gpu-subtitle\":\"Run your own models on enterprise-grade GPUs with pay-per-second billing.\",\"table-tier\":\"Tier\",\"table-hourly\":\"Hourly\",\"table-per-second\":\"Per Second\",\"serverless-tag-no-cold-starts\":\"Zero cold starts\",\"serverless-tag-auto-scaling\":\"Auto-scaling\",\"serverless-tag-pay-per-second\":\"Pay-per-second\",\"serverless-tag-soc2\":\"SOC 2 Type II\",\"enterprise-section-title\":\"Need more? Talk to us.\",\"enterprise-section-description\":\"For teams that need higher limits, dedicated support, and custom deployment options.\",\"enterprise-custom-model-title\":\"Custom model deployment\",\"enterprise-custom-model-description\":\"Expert guidance to help you deploy custom models and optimize performance.\",\"volume-discounts-short-description\":\"We've got volume discounts for large amounts of spend. Contact us to learn more.\",\"faq-section-title-line1\":\"Frequently asked\",\"faq-section-title-line2\":\"questions\",\"faq-contact-prefix\":\"Can't find what you're looking for?\",\"faq-contact-link\":\"Contact support\",\"faq-1-question\":\"How does pricing work?\",\"faq-1-answer\":\"WaveSpeed uses a pay-per-use model. You only pay for what you generate. There are no monthly fees or commitments. Simply add credits to your account and start creating.\",\"faq-2-question\":\"What payment methods do you accept?\",\"faq-2-answer\":\"We accept all major credit cards (Visa, Mastercard, American Express), PayPal, and wire transfers for enterprise customers.\",\"faq-3-question\":\"Is there a free trial?\",\"faq-3-answer\":\"Yes! New accounts receive $1 in free credits to try out our platform. No credit card required to sign up. Some premium models may not be available with trial credits.\",\"faq-4-question\":\"What are account levels?\",\"faq-4-answer\":\"WaveSpeed offers four account levels: Bronze (default), Silver ($100 top-up), Gold ($1,000 top-up), and Ultra ($10,000 top-up). Higher levels unlock increased rate limits and concurrent task allowances.\",\"faq-5-question\":\"Do you offer enterprise pricing?\",\"faq-5-answer\":\"Yes! For high-volume usage, we offer custom enterprise plans with volume discounts, dedicated support, and SLAs. Contact our sales team to learn more.\",\"bottom-cta-title\":\"Unlock Your AI Potential Today\",\"bottom-cta-button\":\"Start Building\"},\"Enterprise\":{\"hero-title-line1\":\"Ultimate AI Media\",\"hero-title-line2\":\"Generation Platform\",\"hero-title-line3\":\"for Enterprise\",\"hero-description\":\"WaveSpeed accelerates AI Image and Video generation for you to build, create, and scale faster.\",\"talk-to-us\":\"Talk to us\",\"ai-models-title\":\"Access State-of-the-Art AI Models\",\"ai-models-description\":\"Ready-to-use REST inference API with the latest image, video, and language models. Best performance, no cold starts, affordable pricing.\",\"image-video-models-title\":\"Image \u0026 Video Models\",\"image-video-models-description\":\"State-of-the-art image and video generation with models like Nano Banana, Seedream, Veo, Seedance, Wan, and Kling.\",\"language-models-title\":\"Language Models\",\"language-models-description\":\"Access leading LLMs including GPT-5.4, Claude Opus 4.7, Gemini 3.1 Pro, and Qwen3 Max with up to 200K context windows.\",\"model-nano-banana-pro\":\"Nano Banana Pro\",\"model-seedream-v4-5\":\"Seedream V4.5\",\"model-sora-2\":\"Sora 2\",\"model-wan-2-6\":\"Wan 2.6\",\"model-gpt-5-2\":\"GPT-5.2\",\"model-claude-opus-4-5\":\"Claude Opus 4.5\",\"model-gemini-3-pro\":\"Gemini 3 Pro\",\"model-qwen3-max\":\"Qwen3 Max\",\"try-for-free\":\"Try for free\",\"security-title\":\"Enterprise-grade security and compliance\",\"security-description\":\"SOC 2 Type 2 certified. Privacy Shield compliant. BAA negotiable. Data stays within your chosen infrastructure region.\",\"serverless-gpu-title\":\"Serverless GPU Infrastructure\",\"serverless-gpu-description\":\"Run your own models on enterprise-grade GPUs with auto-scaling, pay-per-second billing, and zero cold starts. No infrastructure management required.\",\"serverless-tag-soc2\":\"SOC 2 Type II\",\"serverless-tag-encryption\":\"End-to-end encryption\",\"serverless-tag-autoscaling\":\"Auto-scaling\",\"serverless-tag-pay-per-second\":\"Pay-per-second\",\"serverless-tag-zero-cold-starts\":\"Zero cold starts\",\"features-title\":\"There is plenty more…\",\"feature-priority-support-title\":\"Priority support when you need it\",\"feature-priority-support-description\":\"Fast-track your requests with priority access to our engineering team.\",\"feature-higher-gpu-title\":\"Higher GPU limits for bigger workloads\",\"feature-higher-gpu-description\":\"Scale without constraints with increased GPU allocation and concurrent processing.\",\"feature-slas-title\":\"SLAs that meet your requirements\",\"feature-slas-description\":\"Guaranteed uptime and performance with enterprise-grade service level agreements.\",\"feature-custom-models-title\":\"Help with custom models\",\"feature-custom-models-description\":\"Expert guidance to help you deploy custom models and optimize performance.\",\"feature-account-manager-title\":\"Dedicated account manager\",\"feature-account-manager-description\":\"Get personalized support from a dedicated team member who understands your needs.\",\"feature-volume-discounts-title\":\"Volume discounts\",\"feature-volume-discounts-description\":\"We've got volume discounts for large amounts of spend. Contact us to learn more.\",\"contact-title\":\"Get in touch\",\"contact-info-response\":\"Typical response within 24 hours\",\"contact-info-soc2\":\"SOC 2 Type 2 certified\",\"contact-info-priority\":\"Priority onboarding for enterprise\"},\"Github\":{\"hero-title\":\"WaveSpeed AI Open Source\",\"hero-description\":\"Explore our open-source projects and contribute to the future of AI. From high-performance attention mechanisms to serverless deployment frameworks.\",\"button-visit-github\":\"Visit GitHub Organization\",\"stat-projects\":\"Open Source Projects\",\"stat-stars\":\"GitHub Stars\",\"stat-forks\":\"Forks\",\"by-author\":\"by {author}\",\"button-view-github\":\"View on GitHub\",\"key-features\":\"Key Features:\",\"project-goal\":\"Project Goal:\",\"tag-serverless\":\"Serverless\",\"tag-deployment\":\"Deployment\",\"tag-infrastructure\":\"Infrastructure\",\"tag-attention\":\"Attention\",\"tag-performance\":\"Performance\",\"tag-deep-learning\":\"Deep Learning\",\"tag-desktop-app\":\"Desktop App\",\"tag-cross-platform\":\"Cross-Platform\",\"tag-ui\":\"UI\",\"tag-python\":\"Python\",\"tag-sdk\":\"SDK\",\"tag-api\":\"API\",\"tag-comfyui\":\"ComfyUI\",\"tag-integration\":\"Integration\",\"tag-image-generation\":\"Image Generation\",\"tag-official\":\"Official\",\"tag-models\":\"Models\",\"tag-multi-agent\":\"Multi-Agent\",\"tag-mcp\":\"MCP\",\"tag-research\":\"Research\",\"project-waverless-description\":\"Serverless deployment framework for WaveSpeed AI models, enabling scalable and cost-effective AI inference.\",\"project-waverless-feature-1\":\"Serverless architecture\",\"project-waverless-feature-2\":\"Auto-scaling capabilities\",\"project-waverless-feature-3\":\"Pay-per-use pricing model\",\"project-waverless-feature-4\":\"Easy deployment and management\",\"project-waverless-goal\":\"To make AI model deployment effortless and cost-effective through serverless infrastructure, reducing operational overhead.\",\"project-paraattention-description\":\"A high-performance parallel attention mechanism implementation for large-scale AI models.\",\"project-paraattention-feature-1\":\"Optimized attention computation for transformer models\",\"project-paraattention-feature-2\":\"Parallel processing capabilities for faster inference\",\"project-paraattention-feature-3\":\"Memory-efficient implementation\",\"project-paraattention-feature-4\":\"Compatible with popular deep learning frameworks\",\"project-paraattention-goal\":\"To accelerate attention mechanisms in large language models and vision transformers, enabling faster training and inference times.\",\"project-wavespeed-desktop-description\":\"Cross-platform desktop application for WaveSpeed AI, bringing AI capabilities to your local machine.\",\"project-wavespeed-desktop-feature-1\":\"Cross-platform support (Windows, macOS, Linux)\",\"project-wavespeed-desktop-feature-2\":\"Local and cloud model execution\",\"project-wavespeed-desktop-feature-3\":\"Intuitive user interface\",\"project-wavespeed-desktop-feature-4\":\"Offline capabilities\",\"project-wavespeed-desktop-goal\":\"To deliver a powerful desktop experience that combines the convenience of local execution with the scalability of cloud computing.\",\"project-wavespeed-python-description\":\"Official Python SDK for WaveSpeed AI, providing easy access to our AI models and services.\",\"project-wavespeed-python-feature-1\":\"Comprehensive API coverage\",\"project-wavespeed-python-feature-2\":\"Type-safe implementations\",\"project-wavespeed-python-feature-3\":\"Async/await support\",\"project-wavespeed-python-feature-4\":\"Detailed documentation and examples\",\"project-wavespeed-python-goal\":\"To empower Python developers with a robust, easy-to-use SDK for integrating WaveSpeed AI into their applications.\",\"project-comfy-wavespeed-description\":\"WaveSpeed AI integration for ComfyUI, bringing powerful AI models to the ComfyUI workflow.\",\"project-comfy-wavespeed-feature-1\":\"Seamless ComfyUI integration\",\"project-comfy-wavespeed-feature-2\":\"Access to WaveSpeed AI models\",\"project-comfy-wavespeed-feature-3\":\"Custom nodes for image and video generation\",\"project-comfy-wavespeed-feature-4\":\"Easy-to-use workflow components\",\"project-comfy-wavespeed-goal\":\"To bridge WaveSpeed AI's powerful models with ComfyUI's intuitive workflow interface, making advanced AI accessible to creators.\",\"project-wavespeed-comfyui-description\":\"Official WaveSpeed AI nodes and extensions for ComfyUI, providing native support for our AI models.\",\"project-wavespeed-comfyui-feature-1\":\"Native WaveSpeed AI model support\",\"project-wavespeed-comfyui-feature-2\":\"Optimized inference nodes\",\"project-wavespeed-comfyui-feature-3\":\"Batch processing capabilities\",\"project-wavespeed-comfyui-feature-4\":\"Advanced parameter controls\",\"project-wavespeed-comfyui-goal\":\"To provide the best-in-class ComfyUI experience with WaveSpeed AI models, optimized for performance and ease of use.\",\"project-agent-mcp-lab-description\":\"An experimental laboratory for Multi-Agent Communication Protocol (MCP) development and testing.\",\"project-agent-mcp-lab-feature-1\":\"Multi-agent communication framework\",\"project-agent-mcp-lab-feature-2\":\"Protocol testing environment\",\"project-agent-mcp-lab-feature-3\":\"Agent behavior simulation\",\"project-agent-mcp-lab-feature-4\":\"Extensible agent architecture\",\"project-agent-mcp-lab-goal\":\"To research and develop robust multi-agent communication protocols that enable AI agents to collaborate effectively on complex tasks.\"},\"Cli\":{\"hero-title\":\"Every WaveSpeed model — from your terminal\",\"hero-description\":\"One open-source CLI to run any WaveSpeed AI model. Image, video, audio, 3D. Dynamic per-model help fetched live, alias shortcuts you control, pipe-safe JSON for agents.\",\"button-view-npm\":\"Install from npm\",\"button-view-github\":\"View on GitHub\",\"quickstart-heading\":\"Three commands and you're shipping\",\"step-1-title\":\"Install\",\"step-1-desc\":\"Node 18+ required. One global install gives you the wavespeed binary everywhere.\",\"step-2-title\":\"Sign in\",\"step-2-desc\":\"Opens the access-key page in your browser. We auto-detect a copied key and validate it live.\",\"step-3-title\":\"Run any model\",\"step-3-desc\":\"Same shape for all models. Pass the model ID and inputs — get a CDN URL back, or pipe --json to your scripts.\",\"features-heading\":\"Built for humans and agents\",\"feature-1-title\":\"Dynamic per-model help\",\"feature-1-desc\":\"Run wavespeed run '\u003c'model'\u003e' -h and the CLI fetches that model's input schema live and prints the exact flags it accepts — no guessing.\",\"feature-2-title\":\"Aliases that ship with your repo\",\"feature-2-desc\":\"Define named shortcuts in wavespeed.json that bundle a model + default inputs. Teams pull the file, type wavespeed run hero, get on-brand output.\",\"feature-3-title\":\"Agent-native by design\",\"feature-3-desc\":\"Every command supports --json on stdout and progress on stderr. Drop a SKILL.md so Claude Code, Codex, and Cursor know how to call it.\",\"feature-4-title\":\"No magic, no daemon\",\"feature-4-desc\":\"The CLI never mutates your prompt and never opens a background process. It calls api.wavespeed.ai directly. Open source, MIT licensed.\",\"demo-heading\":\"What a real session looks like\",\"demo-subtitle\":\"From catalog browse to JSON output — three commands.\",\"agent-heading\":\"Plug into your coding agent in one step\",\"agent-description\":\"No MCP server, no extra config. Coding agents already know how to run shell commands — the SKILL.md tells them how to use the CLI.\",\"agent-footer\":\"Works with Claude Code, Codex, Cursor, and any agent that auto-loads .claude/skills/*.\",\"cta-heading\":\"Open source. Ready today.\",\"cta-description\":\"MIT licensed, scoped under @wavespeed on npm, hosted on GitHub. Issues and PRs welcome.\",\"button-install\":\"Install from npm\",\"button-star\":\"Star on GitHub\",\"copy-content\":\"Copy markdown\",\"open-markdown-content\":\"Open markdown\",\"open-in-chatgpt\":\"Open in ChatGPT\",\"open-in-claude\":\"Open in Claude\"},\"error\":{\"loading\":\"Failed to load data\",\"loading-logs\":\"Failed to load logs\",\"retry\":\"Retry\",\"view-details\":\"View Details\",\"hide-details\":\"Hide Details\",\"message\":\"Error Message\",\"code\":\"Error Code\",\"network\":{\"title\":\"Network Error\",\"description\":\"Please check your network connection and try again\"},\"timeout\":{\"title\":\"Request Timeout\",\"description\":\"The request took too long. Please try again\"},\"server\":{\"title\":\"Server Error\",\"description\":\"The server encountered an error while processing your request\"},\"client\":{\"title\":\"Request Failed\",\"description\":\"There was an issue with your request\"},\"validation\":{\"title\":\"Validation Error\",\"description\":\"Please check your input and try again\"},\"unauthorized\":{\"title\":\"Unauthorized\",\"description\":\"You don't have permission to access this resource\"},\"forbidden\":{\"title\":\"Access Denied\",\"description\":\"You don't have permission to access this resource\"},\"not-found\":\"Not Found\",\"not-found-description\":\"The requested resource was not found\",\"unknown\":{\"title\":\"Unknown Error\",\"description\":\"An unexpected error occurred\"}},\"modelPage\":{\"title\":\"Models\",\"search-placeholder\":\"Search model name...\",\"results-count\":\"{{count}} models\",\"view-all\":\"View All\",\"show-more\":\"Show more ({{count}})\",\"tabs\":{\"featured\":\"Featured\",\"all\":\"All Models\",\"llm\":\"LLM\",\"serverless\":\"Serverless\",\"image\":\"Image\",\"audio\":\"Audio\",\"video\":\"Video\",\"embedding\":\"Embedding\",\"reranker\":\"Reranker\",\"vision\":\"Vision\"},\"filters\":{\"all-providers\":\"All Providers\",\"providers-title\":\"Providers\",\"provider-others\":\"Others\"},\"card\":{\"new\":\"New\",\"featured\":\"Featured\",\"input\":\"Input\",\"output\":\"Output\",\"cache-read\":\"Cache Read\",\"context\":\"Context\",\"max-output\":\"Max Output\"},\"empty\":{\"title\":\"No models found\",\"description\":\"Try adjusting your filters or search query\"}},\"Wan22SpicyLoraSeo\":{\"s1-h2\":\"1. What Is LoRA and Why Use It for Video Generation?\",\"s1-p1\":\"LoRA, short for Low-Rank Adaptation, is a lightweight fine-tuning technique that helps AI video models learn a specific character, visual style, brand identity, or artistic direction without retraining the entire base model. For AI video generation, LoRA works like an additional style or identity layer on top of a powerful video model, allowing creators to generate videos with more consistent looks and repeatable results.\",\"s1-p2\":\"In image-to-video workflows, consistency is one of the biggest challenges. A standard AI video model can create smooth motion from a reference image, but the character's face, clothing, art style, color palette, or brand aesthetics may shift between generations. LoRA helps solve this problem by guiding the model toward a specific visual identity.\",\"s1-p3\":\"WaveSpeedAI's WAN 2.2 Spicy Image-to-Video LoRA model combines high-quality image-to-video generation with custom LoRA support. Users can upload a reference image, describe the desired motion, camera action, or mood in the prompt, and optionally apply up to 3 LoRAs through \u003cloras\u003eloras\u003c/loras\u003e, \u003chighNoise\u003ehigh_noise_loras\u003c/highNoise\u003e, or \u003clowNoise\u003elow_noise_loras\u003c/lowNoise\u003e. The model supports 480p and 720p output, 5-second or 8-second duration, and seed control for more reproducible results.\",\"s1-p4\":\"This makes WAN 2.2 Spicy LoRA especially useful for creators who need consistent characters, branded video content, anime-style videos, cinematic product visuals, or scalable AI video generation pipelines.\",\"s2-h2\":\"2. Use Cases for WAN 2.2 Spicy Image-to-Video LoRA\",\"s2-brand-h3\":\"Brand Videos with Consistent Visual Style\",\"s2-brand-p1\":\"For brands, visual consistency is essential. Every product video, social media ad, launch teaser, or campaign asset needs to follow the same design language, color tone, product appearance, and overall brand identity. WAN 2.2 Spicy Image-to-Video LoRA helps brands generate AI videos from a single image while keeping a more consistent visual style across multiple outputs.\",\"s2-brand-p2\":\"By applying a brand-specific LoRA, marketing teams can create videos that better preserve product details, lighting style, color grading, model appearance, or campaign aesthetics. This is especially valuable for e-commerce brands, fashion labels, beauty products, gaming studios, and creative agencies that need to produce many video variations quickly.\",\"s2-brand-p-seo\":\"\u003cbold\u003eRecommended SEO keywords to naturally include around this section:\u003c/bold\u003e AI brand video generator, brand video generation, consistent brand video, image to video AI, AI product video generator, LoRA video generation, AI marketing video\",\"suggested-use-cases\":\"Suggested use cases:\",\"s2-brand-li1\":\"Product launch videos\",\"s2-brand-li2\":\"E-commerce product animations\",\"s2-brand-li3\":\"Fashion and beauty campaign videos\",\"s2-brand-li4\":\"Social media ad creatives\",\"s2-brand-li5\":\"Branded character or mascot videos\",\"s2-brand-li6\":\"Scalable AI video production for agencies\",\"s2-brand-p3\":\"Because WaveSpeedAI provides a ready-to-use REST inference API with no cold starts and scalable infrastructure, this model is also suitable for developers building automated video-generation tools or high-volume creative workflows.\",\"s2-anime-h3\":\"Anime-Style Video Generation\",\"s2-anime-p1\":\"WAN 2.2 Spicy LoRA is also a strong fit for anime-style video generation. Anime and stylized content often require stable character identity, consistent hair design, outfit details, facial features, linework, and shading style. Without LoRA, AI-generated videos may produce appealing motion but can drift in character design or visual style across different clips.\",\"s2-anime-p2\":\"With custom LoRA support, creators can guide the model toward a specific anime character style, illustration style, or visual universe. This makes the workflow useful for anime short videos, VTuber content, AI music videos, game character animations, fan-style animations, and cinematic anime scenes.\",\"s2-anime-p-seo\":\"\u003cbold\u003eRecommended SEO keywords:\u003c/bold\u003e anime video generator, AI anime video generator, anime image to video, LoRA anime video, anime-style video generation, AI animation generator, character consistent video\",\"s2-anime-li1\":\"Anime character animation from a reference image\",\"s2-anime-li2\":\"VTuber intro or promotional clips\",\"s2-anime-li3\":\"AI anime music videos\",\"s2-anime-li4\":\"Stylized fight scenes or emotional scenes\",\"s2-anime-li5\":\"Game character cutscene concepts\",\"s2-anime-li6\":\"Short-form anime content for TikTok, YouTube Shorts, and Reels\",\"s2-anime-p3\":\"The key value is not only \\\"turning an image into motion,\\\" but generating motion while preserving a recognizable anime style or character identity.\",\"s2-art-h3\":\"Art-Style Video Creation\",\"s2-art-p1\":\"Artists, designers, and filmmakers can use WAN 2.2 Spicy Image-to-Video LoRA to create stylized videos based on a specific visual direction. Instead of manually editing frame by frame, creators can apply LoRA weights to generate videos in a more controlled art style, such as watercolor, oil painting, cyberpunk, fantasy illustration, retro film, 3D cartoon, cinematic concept art, or surreal visual effects.\",\"s2-art-p2\":\"This is valuable for creative projects where style is as important as motion. A music visualizer, for example, may need a consistent surreal look. A digital artist may want to animate a portfolio image while preserving their signature style. A creative agency may need several motion concepts with the same visual identity.\",\"s2-art-p-seo\":\"\u003cbold\u003eRecommended SEO keywords:\u003c/bold\u003e AI art video generator, stylized video generation, LoRA art style video, image to video art generator, cinematic AI video, AI music video generator, custom style video AI\",\"s2-art-li1\":\"Music visualizers\",\"s2-art-li2\":\"Digital art animation\",\"s2-art-li3\":\"Experimental short films\",\"s2-art-li4\":\"Concept art motion previews\",\"s2-art-li5\":\"Cyberpunk or fantasy-style videos\",\"s2-art-li6\":\"Social media art content\",\"s2-art-li7\":\"AI filmmaking prototypes\",\"s2-art-p3\":\"WAN 2.2 Spicy is positioned for high-quality, smooth image-to-video animation and scalable content generation, while the LoRA version adds another layer of style control and creative repeatability.\",\"s3-h2\":\"3. WAN 2.2 Spicy LoRA vs Standard WAN 2.2: Output Differences\",\"s3-p1\":\"The standard WAN 2.2 Spicy Image-to-Video model is designed to convert a single image into high-quality videos with smooth animation, making it suitable for general image-to-video generation. The LoRA version keeps the same core image-to-video workflow but adds custom LoRA weight support, giving users more control over style, character consistency, and repeated visual identity.\",\"tbl-comparison\":\"Comparison\",\"tbl-standard\":\"Standard WAN 2.2 Spicy Image-to-Video\",\"tbl-lora\":\"WAN 2.2 Spicy Image-to-Video LoRA\",\"row-best-for-label\":\"Best For\",\"row-best-for-std\":\"General image-to-video generation\",\"row-best-for-lora\":\"Consistent style, character, or brand video generation\",\"row-input-label\":\"Input\",\"row-input-std\":\"Image + prompt\",\"row-input-lora\":\"Image + prompt + optional LoRA weights\",\"row-motion-label\":\"Motion Quality\",\"row-motion-std\":\"Smooth, cinematic animation\",\"row-motion-lora\":\"Smooth, cinematic animation with stronger style guidance\",\"row-style-label\":\"Style Control\",\"row-style-std\":\"Mainly controlled by prompt\",\"row-style-lora\":\"Controlled by prompt + custom LoRA\",\"row-character-label\":\"Character Consistency\",\"row-character-std\":\"May vary across generations\",\"row-character-lora\":\"Better for preserving character identity\",\"row-brand-label\":\"Brand Consistency\",\"row-brand-std\":\"Limited to prompt and image reference\",\"row-brand-lora\":\"Better for repeatable brand visual style\",\"row-anime-label\":\"Anime / Art Style\",\"row-anime-std\":\"Possible, but more generic\",\"row-anime-lora\":\"Better for specific anime or artistic styles\",\"row-repro-label\":\"Reproducibility\",\"row-repro-std\":\"Seed supported\",\"row-repro-lora\":\"Seed supported, plus LoRA-guided consistency\",\"row-production-label\":\"Production Use\",\"row-production-std\":\"Fast general video creation\",\"row-production-lora\":\"Better for professional and repeatable creative pipelines\",\"s3-p2\":\"In simple terms, the standard version is best when users want fast and high-quality AI image-to-video generation. The LoRA version is better when users need a specific look to stay consistent across multiple videos.\",\"s3-p3\":\"For example, if a user uploads a product image and asks for a cinematic camera movement, the standard model can generate a smooth product video. But if the user wants every output to follow the same luxury brand style, same lighting mood, same color palette, or same model appearance, the LoRA version is the better choice.\",\"s3-p4\":\"Similarly, for anime-style video generation, the standard model may create a visually pleasing animation, while the LoRA version can better preserve a specific anime character design, illustration style, or trained visual identity.\",\"s3-p5\":\"From an SEO perspective, this section should target comparison-intent keywords such as: WAN 2.2 LoRA vs WAN 2.2, WAN 2.2 Spicy LoRA, LoRA image to video, AI video generation with LoRA, custom LoRA video generator, consistent character video AI\"},\"modelDetail\":{\"back-to-models\":\"Back to Models\",\"pricing\":\"Pricing\",\"pay-per-use\":\"Pay-per-use\",\"pay-per-use-desc\":\"No upfront costs, pay only for what you use\",\"api-usage\":\"API Usage\",\"api-usage-desc\":\"Use the following code examples to integrate with our API:\",\"readme\":\"Model Introduction\",\"supported-functionality\":\"Supported Functionality\",\"api-access-guide\":\"API Access Guide\",\"try-now\":\"Chat Now\",\"show-more\":\"Show more\",\"show-less\":\"Show less\",\"info\":\"Info\",\"provider\":\"Provider\",\"type\":\"Type\",\"vision\":\"Vision\",\"function-calling\":\"Function Calling\",\"supported\":\"✓ Supported\",\"base-url\":\"Base URL\",\"api-endpoint\":\"API Endpoint\",\"model-id\":\"Model ID\",\"modality-text\":\"Text\",\"modality-image\":\"Image\",\"modality-audio\":\"Audio\",\"try-the-model\":\"Try the model\",\"chat-placeholder\":\"Start chatting with the model...\",\"chat-online\":\"Online\",\"chat-footer-hint\":\"Responses may take a few seconds.\",\"chat-welcome\":\"Hi! I am a helpful AI assistant. What can I do for you?\",\"chat-waiting\":\"Waiting for response...\",\"open-playground\":\"Playground\",\"chat-send\":\"Send\",\"clear-chat\":\"Clear Chat\",\"sunset-going-away\":\"Going away\"},\"Generator\":{\"image-meta-title\":\"Free AI Image Generator — 500+ Models, FLUX, Seedream \u0026 More | WaveSpeedAI\",\"image-meta-description\":\"Generate and edit stunning images with 10+ AI models including GPT Image, Nano Banana, Seedream, Qwen, FLUX, and more. Text-to-image, image editing, and style transfer — all free to start.\",\"video-meta-title\":\"Free AI Video Generator — 200+ Models, Text to Video \u0026 Image to Video | WaveSpeedAI\",\"video-meta-description\":\"Create high-quality videos from text or images with 10+ AI models including Kling, Sora, Veo, WAN, Hailuo, and Grok. Text-to-video, image-to-video — free credits on signup.\",\"avatar-meta-title\":\"WaveSpeed AI Avatar Generator — Create Your Own Avatar for Free\",\"avatar-meta-description\":\"Create talking avatars, lip-sync videos, face swaps, and motion-controlled animations with AI. Powered by InfiniteTalk, Kling Motion Control, WAN Animate, SteadyDancer, and more.\",\"audio-meta-title\":\"WaveSpeed AI Audio Generator — Text to Speech \u0026 Music for Free\",\"audio-meta-description\":\"Generate speech, music, and sound effects with AI. Text-to-speech with ElevenLabs and MiniMax, music generation with ACE-Step and MiniMax Music — free credits on signup.\",\"three-d-meta-title\":\"WaveSpeedAI 3D Generator — Image, Text \u0026 Sketch to 3D for Free\",\"three-d-meta-description\":\"Generate production-ready 3D models from images, text, or sketches with AI. Tripo3D, Hunyuan3D, Hyper3D Rodin — PBR materials, live preview, free credits on signup.\",\"select-model\":\"Select a model\",\"generate-button\":\"Generate\",\"randomize-seed\":\"Randomize Seed\",\"download-success\":\"Download started\",\"download-error\":\"Download failed\",\"generation-started\":\"Generation started\",\"generating\":\"Generating...\",\"generation-failed\":\"Generation failed\",\"available-credits\":\"Available Credits\",\"submission-error\":\"Failed to submit\",\"create-for-free\":\"Create for Free\",\"credits\":\"Credits\",\"top-up\":\"Top up\",\"sign-in-for-credits\":\"Sign in to get free credits →\",\"count\":\"Count\",\"batch-mode\":\"Batch Mode\",\"preview\":\"Preview\",\"copied\":\"Copied\",\"copy-url\":\"Copy URL\",\"open-in-new-tab\":\"Open in new tab\",\"download\":\"Download\",\"expired\":\"Expired\",\"stored-for7-days\":\"Stored for 7 days only\",\"output-unavailable\":\"Output unavailable — may be expired or caused by an error\",\"how-it-works-heading\":\"How It Works\",\"image-page-title\":\"AI Image Generator Powered by the World's Best Models\",\"image-page-subtitle\":\"Create cinematic art, product photography, marketing creatives, anime illustrations, and realistic AI images using GPT Image2, Seedream, Nano Banana 2 \u0026 Pro, FLUX, Qwen Image, Wan, and more in one fast, production ready workflow.\\n\\nCompare outputs instantly, switch between leading AI image models, and generate high-quality visuals for social media, ecommerce, branding, advertising, concept art, and creative projects without changing tools or workflows.\\n\\nUse the right model for every style, workflow, and creative goal.\",\"image-cta-subtitle\":\"Start generating stunning AI images for free. No credit card required.\",\"image-features-heading\":\"Why Creators Choose WaveSpeedAI for AI Image Generation\",\"image-feature-1-title\":\"Access the Best AI Image Models\",\"image-feature-1-desc\":\"Generate realistic photos, anime art, marketing visuals, cinematic scenes, and product images using GPT Image2, Seedream, Nano Banana, FLUX, Qwen Image, WAN, and more in one platform.\",\"image-feature-2-title\":\"Fast AI Image Generation\",\"image-feature-2-desc\":\"Create high quality AI images in seconds with optimized inference, fast model switching, and no cold starts so you can iterate faster and generate more creative variations.\",\"image-feature-3-title\":\"Generate Images for Any Creative Workflow\",\"image-feature-3-desc\":\"Create AI generated content for social media, ecommerce, advertising, branding, YouTube thumbnails, concept art, and creative projects with one unified workflow.\",\"image-feature-4-title\":\"Edit, Restyle, and Transform Images with AI\",\"image-feature-4-desc\":\"Upload reference images to edit backgrounds, restyle visuals, enhance details, generate variations, or transform existing images with advanced AI image tools.\",\"image-step-1-title\":\"Enter a Prompt\",\"image-step-1-desc\":\"Describe the image you want to create. Be as detailed or as simple as you like.\",\"image-step-2-title\":\"Choose a Model\",\"image-step-2-desc\":\"Pick from 12+ AI models, each optimized for different styles, speeds, and use cases.\",\"image-step-3-title\":\"Generate \u0026 Download\",\"image-step-3-desc\":\"Click Generate and get your image in seconds. Download in full resolution.\",\"image-seo-guide-title\":\"How to Generate AI Images for Free with WaveSpeedAI?\",\"image-seo-guide-intro-1\":\"Creating high-quality AI images has never been easier. With WaveSpeedAI, you can generate realistic photos, anime art, marketing creatives, cinematic scenes, product photography, and social media visuals using the world's leading AI image models in one platform. New users receive free credits after signup, so you can start generating AI images without a subscription or upfront payment.\",\"image-seo-guide-intro-2\":\"Whether you are a designer, marketer, content creator, ecommerce seller, or simply exploring AI art tools, WaveSpeedAI gives you access to advanced image generation models including GPT Image2, Seedream, Nano Banana 2 \u0026 Pro, FLUX, Qwen Image, WAN, and more.\",\"image-seo-guide-intro-3\":\"Unlike traditional AI image generators that lock users into a single model, WaveSpeedAI lets you compare multiple image models, switch styles instantly, and choose the best AI model for every creative workflow.\",\"image-seo-guide-step1-title\":\"Step 1: Enter Your Prompt\",\"image-seo-guide-step1-p1\":\"Start by describing the image you want to create. You can keep your prompt simple or add detailed instructions for style, lighting, composition, mood, colors, camera angles, or visual aesthetics.\",\"image-seo-guide-step1-examples-label\":\"Examples:\",\"image-seo-guide-step1-ex-1\":\"Cinematic portrait photography in Tokyo neon streets\",\"image-seo-guide-step1-ex-2\":\"Luxury skincare product photo with soft studio lighting\",\"image-seo-guide-step1-ex-3\":\"Anime warrior character concept art\",\"image-seo-guide-step1-ex-4\":\"Realistic AI-generated food photography\",\"image-seo-guide-step1-ex-5\":\"Social media ad creative for a fashion brand\",\"image-seo-guide-step1-p3\":\"WaveSpeedAI supports a wide range of creative styles including photorealistic images, anime illustrations, digital art, product photography, concept art, marketing visuals, typography-based designs, and cinematic scenes.\",\"image-seo-guide-step1-p4\":\"The better your prompt, the more accurate and visually detailed your AI-generated image will be.\",\"image-seo-guide-step2-title\":\"Step 2: Choose the Best AI Image Model\",\"image-seo-guide-step2-p1\":\"Different AI image models are optimized for different creative tasks. WaveSpeedAI allows you to access multiple leading AI image generators in one workflow so you can generate images faster and compare outputs side by side.\",\"image-seo-guide-step2-models-label\":\"Popular models include:\",\"image-seo-guide-step2-m-1\":\"GPT Image2 — clean compositions, design accuracy, and marketing visuals\",\"image-seo-guide-step2-m-2\":\"Seedream — cinematic realism and high-quality photography\",\"image-seo-guide-step2-m-3\":\"Nano Banana 2 \u0026 Pro — anime art and stylized illustrations\",\"image-seo-guide-step2-m-4\":\"FLUX — balanced prompt following and versatile image generation\",\"image-seo-guide-step2-m-5\":\"Qwen Image — detailed creative outputs\",\"image-seo-guide-step2-m-6\":\"WAN — cinematic visual storytelling and artistic scenes\",\"image-seo-guide-step2-p2\":\"This multi-model workflow makes WaveSpeedAI a strong alternative to standalone tools like Midjourney or Ideogram because you are not limited to a single image generation style or engine.\",\"image-seo-guide-step2-p3\":\"You can experiment with different models to find the best results for social media graphics, ecommerce product photos, YouTube thumbnails, branding assets, advertising creatives, concept art, and more.\",\"image-seo-guide-step3-title\":\"Step 3: Generate AI Images in Seconds\",\"image-seo-guide-step3-p1\":\"Once you choose a model, click Generate to create your image. WaveSpeedAI is optimized for fast AI image generation with low latency and no cold starts, allowing you to iterate quickly and test multiple creative directions.\",\"image-seo-guide-step3-p2\":\"Most image generations complete within seconds depending on the selected model and image settings.\",\"image-seo-guide-step3-p3\":\"New users receive free credits upon signup, which means you can start generating AI images immediately without purchasing a subscription. Pricing starts from just $0.001 per generation depending on the model, making WaveSpeedAI one of the most affordable AI image generation platforms for creators, teams, and businesses.\",\"image-seo-guide-step3-p4\":\"This flexible pricing model is ideal for users who want access to premium AI image models without committing to expensive monthly plans.\",\"image-seo-guide-step4-title\":\"Step 4: Download, Edit, and Refine\",\"image-seo-guide-step4-p1\":\"After generation, you can download your AI-generated images in high resolution or continue refining them with additional prompts and reference images.\",\"image-seo-guide-step4-features-label\":\"WaveSpeedAI also supports AI-powered image editing workflows including:\",\"image-seo-guide-step4-f-1\":\"Image restyling\",\"image-seo-guide-step4-f-2\":\"Background replacement\",\"image-seo-guide-step4-f-3\":\"Visual enhancement\",\"image-seo-guide-step4-f-4\":\"Image variations\",\"image-seo-guide-step4-f-5\":\"Reference-based generation\",\"image-seo-guide-step4-f-6\":\"Creative transformations\",\"image-seo-guide-step4-p2\":\"This makes it easy to move from initial idea to production-ready visuals for marketing campaigns, ecommerce listings, social content, creative projects, and professional design workflows.\",\"image-seo-guide-step4-p3\":\"Whether you need realistic AI photos, anime illustrations, commercial graphics, or creative concept art, WaveSpeedAI helps you generate high-quality AI images quickly, affordably, and at scale.\",\"image-models-compare-title\":\"Best AI Image Models Compared\",\"image-models-compare-lead\":\"Choose the right AI image model for your creative workflow.\",\"image-models-compare-intro-1\":\"AI image generation is evolving rapidly, with new models pushing the boundaries of realism, prompt understanding, editing accuracy, typography, and creative control. Instead of relying on a single image generator, creators and teams now choose different AI image models depending on the workflow, visual style, and production needs.\",\"image-models-compare-intro-2\":\"WaveSpeedAI gives users access to multiple leading AI image generation models in one platform, making it easier to compare outputs, switch styles, and choose the best model for every creative task.\",\"image-models-compare-intro-3\":\"Whether you are generating realistic photography, anime art, product visuals, social media creatives, cinematic scenes, or marketing assets, different models excel in different areas.\",\"image-models-compare-th-model\":\"AI model\",\"image-models-compare-th-best-for\":\"Best for\",\"image-models-compare-th-strengths\":\"Key strengths\",\"image-models-compare-best-for-label\":\"Best for:\",\"image-models-compare-gpt2-name\":\"GPT Image2\",\"image-models-compare-gpt2-row-best-for\":\"Marketing visuals, design, commercial content\",\"image-models-compare-gpt2-row-strengths\":\"Excellent prompt understanding, clean layouts, strong typography, polished outputs\",\"image-models-compare-gpt2-card-desc\":\"Built for professional quality AI image generation with strong prompt understanding, realistic rendering, clean composition, and polished visual outputs. GPT Image2 performs especially well for commercial design, branded content, marketing creatives, and product advertising.\",\"image-models-compare-gpt2-card-best-for\":\"Marketing visuals, commercial content, product ads, professional design, photorealistic images\",\"image-models-compare-nano-name\":\"Nano Banana Pro \u0026 2\",\"image-models-compare-nano-row-best-for\":\"Realistic photography, storytelling, fast iteration\",\"image-models-compare-nano-row-strengths\":\"Ultra realistic images, strong prompt accuracy, cinematic realism, fast generation\",\"image-models-compare-nano-card-desc\":\"Optimized for ultra realistic photography, cinematic storytelling, and fast creative iteration. Nano Banana models deliver highly natural lighting, strong scene consistency, and realistic character generation while maintaining fast generation speed.\",\"image-models-compare-nano-card-best-for\":\"Realistic photography, storytelling, cinematic scenes, fast concept iteration\",\"image-models-compare-seedream-name\":\"Seedream\",\"image-models-compare-seedream-row-best-for\":\"Artistic realism, fashion, editorial visuals\",\"image-models-compare-seedream-row-strengths\":\"Cinematic lighting, creative compositions, aesthetic photography\",\"image-models-compare-seedream-card-desc\":\"Focused on artistic realism, cinematic lighting, and editorial style aesthetics. Seedream generates visually rich images with strong atmosphere, creative composition, and fashion-forward visual direction.\",\"image-models-compare-seedream-card-best-for\":\"Artistic realism, fashion photography, editorial visuals, aesthetic campaigns\",\"image-models-compare-flux-name\":\"FLUX\",\"image-models-compare-flux-row-best-for\":\"General purpose image generation\",\"image-models-compare-flux-row-strengths\":\"Balanced prompt following, flexible styles, strong image quality\",\"image-models-compare-flux-card-desc\":\"A flexible general purpose AI image model designed for balanced realism, creativity, and reliable prompt following. FLUX works well across a wide range of image generation workflows and visual styles.\",\"image-models-compare-flux-card-best-for\":\"General purpose image generation, mixed creative tasks, versatile visual production\",\"image-models-compare-qwen-name\":\"Qwen Image\",\"image-models-compare-qwen-row-best-for\":\"Detailed realism and multilingual prompts\",\"image-models-compare-qwen-row-strengths\":\"Accurate details, natural lighting, strong multilingual understanding\",\"image-models-compare-qwen-card-desc\":\"Designed for detailed visual rendering and multilingual prompt understanding. Qwen Image produces natural looking outputs with strong detail accuracy, realistic lighting, and consistent scene generation.\",\"image-models-compare-qwen-card-best-for\":\"Detailed realism, multilingual prompting, natural photography, accurate visual generation\",\"image-models-compare-wan-name\":\"WAN\",\"image-models-compare-wan-row-best-for\":\"Cinematic scenes and visual storytelling\",\"image-models-compare-wan-row-strengths\":\"Atmospheric visuals, film style compositions, artistic direction\",\"image-models-compare-wan-card-desc\":\"Specialized in cinematic storytelling and atmospheric visual creation. WAN excels at film style composition, emotional lighting, artistic direction, and narrative driven scene generation.\",\"image-models-compare-wan-card-best-for\":\"Cinematic scenes, visual storytelling, movie style concepts, artistic direction\",\"image-use-cases-title\":\"AI Image Generation Use Cases\",\"image-use-cases-intro-1\":\"AI image generation is transforming how creators, marketers, brands, and businesses produce visual content. With WaveSpeedAI, you can access leading AI image models like GPT Image2, Seedream, Nano Banana 2 \u0026 Pro, FLUX, Qwen Image, and WAN to create high quality visuals for a wide range of creative workflows.\",\"image-use-cases-intro-2\":\"From social media graphics and ecommerce product photography to marketing campaigns and AI art creation, WaveSpeedAI helps you generate professional visuals faster, more affordably, and at scale.\",\"image-use-cases-social-title\":\"AI Images for Social Media Content\",\"image-use-cases-social-p1\":\"Social media teams and content creators use AI image generation to produce eye catching visuals for platforms like Instagram, TikTok, X, YouTube, LinkedIn, and Facebook.\",\"image-use-cases-social-p2\":\"Instead of spending hours designing graphics manually, creators can generate scroll stopping content in seconds using simple prompts.\",\"image-use-cases-social-list-label\":\"Popular social media use cases include:\",\"image-use-cases-social-li-1\":\"Instagram post graphics\",\"image-use-cases-social-li-2\":\"TikTok visual assets\",\"image-use-cases-social-li-3\":\"YouTube thumbnails\",\"image-use-cases-social-li-4\":\"AI generated memes\",\"image-use-cases-social-li-5\":\"Brand campaign visuals\",\"image-use-cases-social-li-6\":\"Influencer content\",\"image-use-cases-social-li-7\":\"AI lifestyle photography\",\"image-use-cases-social-li-8\":\"Seasonal promotional creatives\",\"image-use-cases-social-p3\":\"WaveSpeedAI allows users to quickly test different styles, layouts, and creative directions using multiple AI image models in one workflow. Models like GPT Image2 are ideal for clean commercial visuals, while Seedream and WAN are great for cinematic and lifestyle imagery.\",\"image-use-cases-social-p4\":\"This makes WaveSpeedAI a powerful AI image generator for social media marketing and content production.\",\"image-use-cases-ecom-title\":\"AI Product Photography for Ecommerce\",\"image-use-cases-ecom-p1\":\"AI generated product photography is becoming one of the fastest growing ecommerce workflows. Brands and online sellers can create studio quality product images without expensive photo shoots, props, or editing teams.\",\"image-use-cases-ecom-list-label\":\"With WaveSpeedAI, ecommerce businesses can generate:\",\"image-use-cases-ecom-li-1\":\"AI product photos\",\"image-use-cases-ecom-li-2\":\"Lifestyle product scenes\",\"image-use-cases-ecom-li-3\":\"White background product images\",\"image-use-cases-ecom-li-4\":\"Fashion photography\",\"image-use-cases-ecom-li-5\":\"Beauty and skincare visuals\",\"image-use-cases-ecom-li-6\":\"Food photography\",\"image-use-cases-ecom-li-7\":\"Marketplace listing images\",\"image-use-cases-ecom-li-8\":\"Advertising creatives for Shopify and Amazon\",\"image-use-cases-ecom-p2\":\"Simply upload a reference image or enter a product prompt to create realistic commercial visuals optimized for ecommerce conversion.\",\"image-use-cases-ecom-p3\":\"Seedream and FLUX are especially effective for realistic AI photography, while GPT Image2 works well for clean marketing layouts and branded visuals.\",\"image-use-cases-ecom-p4\":\"For growing ecommerce brands, AI image generation dramatically reduces production time and creative costs while making it easier to test new visual campaigns quickly.\",\"image-use-cases-marketing-title\":\"AI Marketing and Advertising Creatives\",\"image-use-cases-marketing-p1\":\"Marketing teams use AI image generators to create high performing ad creatives, campaign visuals, landing page graphics, and branded content at scale.\",\"image-use-cases-marketing-p2\":\"WaveSpeedAI supports rapid content iteration across multiple styles and image models, helping marketers generate fresh creative assets for paid ads, social campaigns, and promotional content.\",\"image-use-cases-marketing-list-label\":\"Common marketing use cases include:\",\"image-use-cases-marketing-li-1\":\"Facebook and Instagram ads\",\"image-use-cases-marketing-li-2\":\"Performance marketing creatives\",\"image-use-cases-marketing-li-3\":\"AI banner generation\",\"image-use-cases-marketing-li-4\":\"Product launch visuals\",\"image-use-cases-marketing-li-5\":\"Promotional graphics\",\"image-use-cases-marketing-li-6\":\"Branding concepts\",\"image-use-cases-marketing-li-7\":\"Email campaign imagery\",\"image-use-cases-marketing-li-8\":\"AI generated ad variations\",\"image-use-cases-marketing-p3\":\"Because different AI image models excel at different creative tasks, WaveSpeedAI allows teams to compare outputs and select the best model for each campaign.\",\"image-use-cases-marketing-p4\":\"This flexible workflow is especially useful for agencies, startups, and content teams that need fast AI image generation without sacrificing quality.\",\"image-use-cases-creative-title\":\"AI Art, Anime, and Creative Design\",\"image-use-cases-creative-p1\":\"AI image generation is also widely used for artistic creation, concept design, and visual experimentation.\",\"image-use-cases-creative-p2\":\"Artists, designers, game creators, and creative professionals use WaveSpeedAI to generate:\",\"image-use-cases-creative-li-1\":\"AI anime art\",\"image-use-cases-creative-li-2\":\"Character designs\",\"image-use-cases-creative-li-3\":\"Concept art\",\"image-use-cases-creative-li-4\":\"Fantasy environments\",\"image-use-cases-creative-li-5\":\"Cinematic scenes\",\"image-use-cases-creative-li-6\":\"Digital illustrations\",\"image-use-cases-creative-li-7\":\"Storyboard visuals\",\"image-use-cases-creative-li-8\":\"Stylized artwork\",\"image-use-cases-creative-p3\":\"Nano Banana 2 \u0026 Pro are optimized for anime and expressive illustration styles, while WAN and Seedream are ideal for cinematic storytelling and artistic visuals.\",\"image-use-cases-creative-p4\":\"By combining multiple leading AI image models in one platform, WaveSpeedAI gives creators more flexibility than traditional single model tools.\",\"image-use-cases-creative-p5\":\"Whether you are creating commercial visuals, social media content, product photography, or AI generated art, WaveSpeedAI helps you produce high quality AI images faster and more efficiently using the best image generation models available today.\",\"image-faq-1-q\":\"What is the best AI image generator for realistic photos, anime art, and marketing visuals?\",\"image-faq-1-a\":\"WaveSpeedAI gives you access to multiple leading AI image models in one platform, including GPT Image2, Seedream, Nano Banana 2 \u0026 Pro, FLUX, Qwen Image, and WAN. Different models are optimized for different creative tasks such as realistic AI photography, anime art, cinematic scenes, product photography, social media graphics, and marketing creatives. Instead of being limited to a single model, you can compare outputs and choose the best AI image generator for your workflow.\",\"image-faq-2-q\":\"Can I generate AI images for free with WaveSpeedAI?\",\"image-faq-2-a\":\"Yes. New users receive free credits after signup, allowing you to generate AI images without purchasing a subscription or entering a credit card. WaveSpeedAI supports affordable pay-as-you-go pricing starting from just $0.001 per image generation depending on the selected AI model.\",\"image-faq-3-q\":\"Which AI image model should I use?\",\"image-faq-3-a\":\"Each AI image model has different strengths depending on your creative goal. GPT Image2 works well for clean commercial visuals and marketing design, Seedream is optimized for realistic photography and cinematic imagery, Nano Banana 2 \u0026 Pro are ideal for anime and stylized artwork, while FLUX and Qwen Image offer balanced prompt following and versatile image generation. WaveSpeedAI makes it easy to test multiple AI image models in one workflow.\",\"image-faq-4-q\":\"Can I use AI generated images for commercial projects?\",\"image-faq-4-a\":\"Yes. AI generated images created with WaveSpeedAI can be used for commercial workflows including ecommerce, advertising, social media marketing, branding, product photography, YouTube thumbnails, and creative production. Commercial usage may vary depending on the individual AI model license, so we recommend reviewing model-specific terms when needed.\",\"image-faq-5-q\":\"How fast is AI image generation on WaveSpeedAI?\",\"image-faq-5-a\":\"Most AI images are generated within seconds depending on the selected model, resolution, and generation settings. WaveSpeedAI is optimized for low latency AI inference with fast model switching and no cold starts, making it ideal for rapid content creation, creative iteration, and production workflows.\",\"image-faq-6-q\":\"Can I edit or transform existing images with AI?\",\"image-faq-6-a\":\"Yes. WaveSpeedAI supports AI image editing and transformation workflows using models like Qwen Image, WAN, and FLUX. You can upload reference images to restyle visuals, replace backgrounds, generate variations, enhance details, or transform existing images into new creative styles using AI powered image editing tools.\",\"image-faq-7-q\":\"Is WaveSpeedAI a good alternative to Midjourney or Ideogram?\",\"image-faq-7-a\":\"WaveSpeedAI is a flexible alternative to Midjourney and Ideogram because it provides access to multiple AI image models in one platform instead of limiting users to a single generation engine. Users can compare styles, switch models instantly, and generate images optimized for different use cases including realistic photography, anime art, marketing visuals, product images, and cinematic content.\",\"image-faq-8-q\":\"What can I create with an AI image generator?\",\"image-faq-8-a\":\"With WaveSpeedAI, you can create social media graphics, AI product photography, marketing creatives, anime illustrations, cinematic scenes, digital artwork, YouTube thumbnails, ecommerce visuals, concept art, branding assets, and more using advanced AI image generation models.\",\"image-faq-9-q\":\"Which AI model is best for realistic AI images?\",\"image-faq-9-a\":\"$1d\",\"image-model-nano-banana-2-name\":\"Nano Banana 2\",\"image-model-nano-banana-2-desc\":\"Fast, high-quality image generation with excellent prompt adherence.\",\"image-model-nano-banana-pro-name\":\"Nano Banana Pro\",\"image-model-nano-banana-pro-desc\":\"Enhanced version with superior detail and artistic quality.\",\"image-model-nano-banana-name\":\"Nano Banana\",\"image-model-nano-banana-desc\":\"Google's original text-to-image and editing model with photorealistic and stylized output.\",\"image-model-seedream-5-lite-name\":\"Seedream 5 Lite\",\"image-model-seedream-5-lite-desc\":\"ByteDance's lightweight model for quick creative iterations.\",\"image-model-seedream-4-5-name\":\"Seedream 4.5\",\"image-model-seedream-4-5-desc\":\"Powerful general-purpose model with strong composition skills.\",\"image-model-gpt-image-2-name\":\"GPT Image 2\",\"image-model-gpt-image-2-desc\":\"OpenAI's latest image generation model powered by GPT-5 guidance. High-quality text-to-image and image editing with natural language prompts.\",\"image-model-gpt-image-1-5-name\":\"GPT Image 1.5\",\"image-model-gpt-image-1-5-desc\":\"OpenAI's fast text-to-image and image editing model with natural language control, quality presets, and input fidelity options.\",\"image-model-qwen-image-2-0-name\":\"Qwen Image 2.0\",\"image-model-qwen-image-2-0-desc\":\"Alibaba's advanced model with Standard/Pro tiers, improved quality, and better instruction understanding. Up to 2K.\",\"image-model-qwen-image-name\":\"Qwen Image\",\"image-model-qwen-image-desc\":\"Alibaba's model excelling at both text-to-image and image editing.\",\"image-model-wan-2-7-name\":\"WAN 2.7\",\"image-model-wan-2-7-desc\":\"Alibaba's newest model with Standard/Pro tiers, thinking mode for enhanced quality, and up to 4K output. Supports text-to-image and multi-image editing.\",\"image-model-wan-2-6-name\":\"WAN 2.6\",\"image-model-wan-2-6-desc\":\"Alibaba's model with text-to-image and image editing support.\",\"image-model-wan-2-5-name\":\"WAN 2.5\",\"image-model-wan-2-5-desc\":\"Alibaba's text-to-image and image editing model with negative prompt and up to 2 reference images.\",\"image-model-flux-2-klein-name\":\"FLUX 2 Klein\",\"image-model-flux-2-klein-desc\":\"Compact yet capable model for text-to-image and image editing.\",\"image-model-z-image-turbo-name\":\"Z-Image Turbo\",\"image-model-z-image-turbo-desc\":\"Ultra-fast generation optimized for speed without sacrificing quality.\",\"video-page-title\":\"AI Video Generator — Create Stunning Videos with AI\",\"video-page-subtitle\":\"Turn text prompts and images into high-quality videos with the latest AI models. Text-to-video, image-to-video, audio generation — powered by Kling, WAN, Sora, Veo, and more.\",\"video-cta-subtitle\":\"Start generating stunning AI videos for free. No credit card required.\",\"video-feature-1-title\":\"13+ AI Models\",\"video-feature-1-desc\":\"Access Kling, WAN, Seedance, Sora, Veo, Vidu, Hailuo and more — each with unique capabilities.\",\"video-feature-2-title\":\"Image to Video\",\"video-feature-2-desc\":\"Animate any still image into a video. Upload a start frame and let AI bring it to life.\",\"video-feature-3-title\":\"Audio Generation\",\"video-feature-3-desc\":\"Multiple models generate synchronized audio and background music automatically.\",\"video-feature-4-title\":\"Up to 4K \u0026 20s\",\"video-feature-4-desc\":\"Generate videos up to 4K resolution and 20 seconds duration depending on the model.\",\"video-faq-1-q\":\"Is WaveSpeed AI Video Generator free to use?\",\"video-faq-1-a\":\"Yes! You get free credits when you sign up. Video generation costs vary by model, resolution, and duration — starting from just a few cents per clip.\",\"video-faq-2-q\":\"What AI video models are available?\",\"video-faq-2-a\":\"We offer 13+ models including Kling 3.0, Kling O3, WAN 2.7, Seedance 1.5 Pro, Sora 2, Veo 3.1, Vidu Q3, and Hailuo 2.3 — covering text-to-video, image-to-video, and video editing.\",\"video-faq-3-q\":\"What video resolutions and durations are supported?\",\"video-faq-3-a\":\"Depending on the model, you can generate videos from 480p to 4K resolution, with durations ranging from 1 second up to 20 seconds.\",\"video-faq-4-q\":\"Can I generate video from an image?\",\"video-faq-4-a\":\"Yes! All models support image-to-video generation. Upload a start image and the AI will animate it into a video. Some models also support end-frame images.\",\"video-faq-5-q\":\"Do generated videos include audio?\",\"video-faq-5-a\":\"Many models including Seedance 1.5 Pro, Veo 3.1, Kling 3.0, and Vidu Q3 can generate synchronized audio and background music automatically.\",\"video-faq-6-q\":\"How fast is video generation?\",\"video-faq-6-a\":\"Generation time varies by model and duration. Short clips (3–5s) typically complete in 30–120 seconds. Our infrastructure ensures no cold starts and optimal performance.\",\"video-seo-guide-title\":\"How to Generate AI Videos for Free\",\"video-seo-guide-lead\":\"Generate AI Videos Online for Free with WaveSpeedAI\",\"video-seo-guide-intro-1\":\"AI video generation is becoming one of the fastest growing creator workflows in 2026. With WaveSpeedAI, users can generate cinematic AI videos directly from text prompts or reference images without expensive editing software or complex GPU setups.\",\"video-seo-guide-intro-2\":\"New users receive $1 in free credits after signing up, making it easy to try AI video generation for free before scaling to larger projects.\",\"video-seo-guide-intro-3\":\"WaveSpeedAI provides access to leading AI video models including Seedance 2.0, WAN 2.7, Kling 3.0, Vidu Q3, and Veo 3.1 Lite through one unified platform and API. Users can experiment with both text to video and image to video generation using free credits.\",\"video-seo-guide-step1-title\":\"Step 1: Choose an AI Video Model\",\"video-seo-guide-step1-p1\":\"Different models are optimized for different workflows. Seedance 2.0 performs well for cinematic storytelling and smooth motion. WAN 2.7 offers flexible prompt control and high quality image to video generation. Kling 3.0 is known for premium cinematic visuals and realistic motion, while Vidu Q3 and Veo 3.1 Lite are optimized for fast and scalable AI video creation.\",\"video-seo-guide-step2-title\":\"Step 2: Enter a Prompt or Upload an Image\",\"video-seo-guide-step2-p1\":\"Users can create videos from text prompts, animate product photos, generate anime style content, or turn reference images into cinematic clips for TikTok, YouTube Shorts, Instagram Reels, advertising, and AI filmmaking.\",\"video-seo-guide-step2-example-label\":\"Example prompt:\",\"video-seo-guide-step2-example-quote\":\"“A cinematic drone shot flying through a futuristic neon city at night, ultra realistic, dynamic lighting”\",\"video-seo-guide-step3-title\":\"Step 3: Generate and Iterate Quickly\",\"video-seo-guide-step3-p1\":\"WaveSpeedAI is optimized for fast inference, scalable GPU infrastructure, no cold starts, and API based automation. This makes the platform useful for creators, agencies, developers, and marketing teams producing high volumes of AI generated video content.\",\"video-workflow-compare-title\":\"Text to Video vs Image to Video: Which AI Workflow Is Better?\",\"video-workflow-compare-intro-1\":\"AI video generation usually starts with two main workflows: text to video and image to video. Both are powerful, but they are designed for different creative goals.\",\"video-workflow-compare-th-workflow\":\"Workflow\",\"video-workflow-compare-th-best-for\":\"Best For\",\"video-workflow-compare-th-advantage\":\"Main Advantage\",\"video-workflow-compare-row-ttv-name\":\"Text to Video\",\"video-workflow-compare-row-ttv-best-for\":\"Creating new cinematic scenes\",\"video-workflow-compare-row-ttv-advantage\":\"Maximum creative freedom\",\"video-workflow-compare-row-i2v-name\":\"Image to Video\",\"video-workflow-compare-row-i2v-best-for\":\"Animating existing visuals\",\"video-workflow-compare-row-i2v-advantage\":\"Better visual consistency\",\"video-workflow-compare-ttv-title\":\"Text to Video\",\"video-workflow-compare-ttv-p1\":\"Text to video generation creates videos directly from written prompts. Users can describe a scene, camera movement, atmosphere, lighting, or action, and the AI generates a completely new video from scratch.\",\"video-workflow-compare-ttv-p2\":\"This workflow is ideal for cinematic storytelling, fantasy worlds, advertising concepts, sci fi scenes, and creative short films where originality and imagination are important.\",\"video-workflow-compare-ttv-example-label\":\"Example prompt:\",\"video-workflow-compare-ttv-example-quote\":\"“A samurai walking through heavy rain in Tokyo at night, cinematic lighting, slow motion camera”\",\"video-workflow-compare-ttv-p3\":\"Text to video offers more creative flexibility, but character appearance and visual style may vary between generations.\",\"video-workflow-compare-i2v-title\":\"Image to Video\",\"video-workflow-compare-i2v-p1\":\"Image to video generation starts with an existing image and adds motion, camera movement, animation, and cinematic effects. This workflow is better for creators who want more consistent results while preserving a specific subject, character, or visual identity.\",\"video-workflow-compare-i2v-p2\":\"It is commonly used for product videos, anime style animation, AI influencer content, social media campaigns, and branded marketing videos.\",\"video-workflow-compare-i2v-p3\":\"WaveSpeedAI supports image to video generation across advanced models including Seedance 2.0, WAN 2.7, Kling 3.0, Vidu Q3, and Veo 3.1 Lite, allowing users to create cinematic videos from reference images with different levels of realism, motion quality, and creative control.\",\"video-workflow-compare-beginners-title\":\"Which Workflow Should Beginners Use?\",\"video-workflow-compare-beginners-p1\":\"For beginners, image to video is usually easier to control and produces more predictable results. For advanced creators, text to video enables larger cinematic storytelling, world building, and creative experimentation.\",\"video-workflow-compare-hybrid-p1\":\"Many creators now combine both workflows by generating AI images first and then animating them into videos. This hybrid workflow is becoming increasingly popular for AI filmmaking, marketing, anime content, and short form social media videos.\",\"video-best-models-title\":\"Best AI Video Models on WaveSpeedAI in 2026\",\"video-best-models-intro-1\":\"WaveSpeedAI gives creators and developers access to multiple leading AI video models through one platform and one API. Different models are optimized for cinematic storytelling, image to video generation, fast content creation, and scalable AI video workflows.\",\"video-best-models-seedance-title\":\"Seedance 2.0\",\"video-best-models-seedance-p1\":\"Seedance 2.0 is designed for cinematic AI video generation with smooth motion, strong prompt understanding, and native audio visual synchronization. It performs especially well for storytelling, commercial videos, character animation, and social media content where motion quality and scene consistency are important.\",\"video-best-models-wan-title\":\"WAN 2.7\",\"video-best-models-wan-p1\":\"WAN 2.7 focuses on controllable AI video generation with strong image to video quality and flexible editing workflows. The model supports reference images, negative prompts, aspect ratio control, and high resolution output up to 1080p, making it useful for product videos, prompt controlled workflows, and AI video editing.\",\"video-best-models-kling-title\":\"Kling 3.0\",\"video-best-models-kling-p1\":\"Kling 3.0 is known for premium cinematic visuals and realistic motion quality. It supports text to video, image to video, 4K output, and motion control workflows, making it popular for advertising, AI filmmaking, luxury product visuals, and creator focused content.\",\"video-best-models-vidu-title\":\"Vidu Q3\",\"video-best-models-vidu-p1\":\"Vidu Q3 is optimized for fast cinematic video generation with native audio support. The model can generate visuals, dialogue, sound effects, and music together, helping creators produce complete AI videos more efficiently for short films, creator content, and social media clips.\",\"video-best-models-veo-title\":\"Veo 3.1 Lite\",\"video-best-models-veo-p1\":\"Veo 3.1 Lite is Google's scalable AI video model focused on efficient and cost effective video generation. It supports both text to video and image to video workflows while maintaining strong visual quality, making it suitable for marketing videos, social media content, and high volume AI video production.\",\"video-best-models-outro-1\":\"WaveSpeedAI allows users to compare and use all of these advanced AI video models in one place, helping creators choose the best workflow for cinematic videos, marketing content, AI filmmaking, and scalable media generation.\",\"video-model-kling-3-0-name\":\"Kling 3.0\",\"video-model-kling-3-0-desc\":\"Kuaishou's model with Std/Pro tiers, sound generation, and up to 15s video duration.\",\"video-model-kling-o3-name\":\"Kling O3\",\"video-model-kling-o3-desc\":\"Kuaishou's advanced MVL model with Std/Pro tiers, reference-to-video, video editing, multi-prompt shots, and audio generation.\",\"video-model-kling-2-6-name\":\"Kling 2.6\",\"video-model-kling-2-6-desc\":\"Kuaishou's Std/Pro model with cinematic visuals, native audio (Pro), and 5–10s duration.\",\"video-model-wan-2-7-name\":\"WAN 2.7\",\"video-model-wan-2-7-desc\":\"Alibaba's newest model with text-to-video, image-to-video, and video editing. 1080p, up to 15s, first/last frame control, and audio guidance.\",\"video-model-wan-2-6-name\":\"WAN 2.6\",\"video-model-wan-2-6-desc\":\"Alibaba's versatile model supporting text-to-video and image-to-video with audio generation.\",\"video-model-wan-2-5-name\":\"WAN 2.5\",\"video-model-wan-2-5-desc\":\"Alibaba's 480p-1080p text/image-to-video with synced audio, prompt expansion, and flexible durations.\",\"video-model-wan-2-2-spicy-name\":\"WAN 2.2 Spicy\",\"video-model-wan-2-2-spicy-desc\":\"Specialized image-to-video model for animating still images with expressive motion.\",\"video-model-seedance-1-5-pro-name\":\"Seedance 1.5 Pro\",\"video-model-seedance-1-5-pro-desc\":\"ByteDance's cinematic model with camera control, audio generation, and 4–12s duration.\",\"video-model-sora-2-name\":\"Sora 2\",\"video-model-sora-2-desc\":\"OpenAI's video model with Std/Pro tiers, multiple resolutions, and up to 20s duration.\",\"video-model-veo-3-1-name\":\"Veo 3.1\",\"video-model-veo-3-1-desc\":\"Google's model with Fast/Standard modes, native 1080p, synchronized audio, and 4K support.\",\"video-model-vidu-q3-name\":\"Vidu Q3\",\"video-model-vidu-q3-desc\":\"High-fidelity video generation with style control, movement amplitude, and background music.\",\"video-model-hailuo-2-3-name\":\"Hailuo 2.3\",\"video-model-hailuo-2-3-desc\":\"MiniMax's physics-aware model with Standard/Pro tiers, 1080p output, and 2.5x efficiency.\",\"video-model-grok-imagine-name\":\"Grok Imagine\",\"video-model-grok-imagine-desc\":\"xAI's video model with text-to-video and image-to-video, customizable duration and aspect ratio.\",\"video-model-happyhorse-1-0-name\":\"Happy Horse 1.0\",\"video-model-happyhorse-1-0-desc\":\"Alibaba's cinematic video model — smooth camera movement, expressive motion, strong prompt fidelity. 720p / 1080p, 3-15s, text-to-video and image-to-video.\",\"audio-page-title\":\"AI Audio Generator — Text to Speech \u0026 Music\",\"audio-page-subtitle\":\"Generate natural speech in 600+ languages, clone voices from short audio samples, and create original music with cutting-edge AI models — all free to start.\",\"audio-cta-subtitle\":\"Start generating AI audio for free. No credit card required.\",\"audio-feature-1-title\":\"8+ AI Models\",\"audio-feature-1-desc\":\"OmniVoice, ElevenLabs, MiniMax, ACE-Step — each with unique capabilities for speech and music.\",\"audio-feature-2-title\":\"Voice Cloning\",\"audio-feature-2-desc\":\"Clone any voice from a short audio sample with OmniVoice or MiniMax.\",\"audio-feature-3-title\":\"Music Generation\",\"audio-feature-3-desc\":\"Create original songs with lyrics, instrumentals, and custom duration.\",\"audio-feature-4-title\":\"600+ Languages\",\"audio-feature-4-desc\":\"OmniVoice supports 600+ languages. Generate speech with natural pronunciation worldwide.\",\"audio-faq-1-q\":\"Is WaveSpeed AI Audio Generator free to use?\",\"audio-faq-1-a\":\"Yes! You get free credits when you sign up. Audio generation costs vary by model and text length.\",\"audio-faq-2-q\":\"What types of audio can I create?\",\"audio-faq-2-a\":\"You can generate speech (text-to-speech) with multiple voice options, music with lyrics, and instrumental tracks.\",\"audio-faq-3-q\":\"What languages are supported?\",\"audio-faq-3-a\":\"OmniVoice supports 600+ languages. MiniMax Speech 2.6 and 2.5 support 40+ languages. ElevenLabs supports English and many more. ACE-Step supports 50+ languages.\",\"audio-faq-4-q\":\"Can I clone my own voice?\",\"audio-faq-4-a\":\"Yes! OmniVoice Voice Clone lets you clone any voice from a 3–10 second audio sample. MiniMax also supports voice cloning via custom voice IDs.\",\"audio-faq-5-q\":\"How long can generated audio be?\",\"audio-faq-5-a\":\"Speech can be up to 10,000 characters. Music ranges from 5 seconds to 5 minutes depending on the model.\",\"audio-model-omnivoice-tts-name\":\"OmniVoice TTS\",\"audio-model-omnivoice-tts-desc\":\"Massively multilingual zero-shot TTS supporting 600+ languages with auto voice or custom voice descriptions.\",\"audio-model-omnivoice-voice-clone-name\":\"OmniVoice Voice Clone\",\"audio-model-omnivoice-voice-clone-desc\":\"Clone any voice from a short 3–10 second audio sample. Supports 600+ languages with zero-shot cloning.\",\"audio-model-elevenlabs-v3-name\":\"ElevenLabs v3\",\"audio-model-elevenlabs-v3-desc\":\"High-quality text-to-speech with natural pronunciation, voice cloning, and pause control.\",\"audio-model-elevenlabs-multilingual-v2-name\":\"ElevenLabs Multilingual v2\",\"audio-model-elevenlabs-multilingual-v2-desc\":\"Multilingual TTS supporting dozens of languages with natural voice synthesis.\",\"audio-model-minimax-speech-2-6-name\":\"MiniMax Speech 2.6\",\"audio-model-minimax-speech-2-6-desc\":\"Ultra-human voice cloning with Turbo/HD tiers, sub-250ms latency, and 40+ language support.\",\"audio-model-minimax-speech-2-5-name\":\"MiniMax Speech 2.5\",\"audio-model-minimax-speech-2-5-desc\":\"Turbo/HD TTS with enhanced multilingual expressiveness, accurate voice cloning, and 40+ languages.\",\"audio-model-elevenlabs-music-name\":\"ElevenLabs Music\",\"audio-model-elevenlabs-music-desc\":\"Generate original songs and instrumentals from text descriptions, up to 5 minutes.\",\"audio-model-minimax-music-2-5-name\":\"MiniMax Music 2.5\",\"audio-model-minimax-music-2-5-desc\":\"Full-dimensional AI music with high-fidelity audio, humanized vocals, and precise creative control.\",\"audio-model-ace-step-1-5-name\":\"ACE-Step 1.5\",\"audio-model-ace-step-1-5-desc\":\"14B-parameter music generator supporting 50+ languages, up to 4-minute tracks with lyrics.\",\"avatar-page-title\":\"AI Avatar Generator — Create Talking Avatars \u0026 Motion Videos\",\"avatar-page-subtitle\":\"Turn photos into talking avatars, sync lips to any audio, and transfer motion between characters — all powered by cutting-edge AI models.\",\"avatar-cta-subtitle\":\"Start generating stunning AI avatar videos for free. No credit card required.\",\"avatar-feature-1-title\":\"Talking Avatars\",\"avatar-feature-1-desc\":\"Upload a photo and audio to create realistic talking or singing avatar videos with lip-sync.\",\"avatar-feature-2-title\":\"Motion Transfer\",\"avatar-feature-2-desc\":\"Transfer dance, gesture, or action from a reference video to any character image.\",\"avatar-feature-3-title\":\"Character Animation\",\"avatar-feature-3-desc\":\"Animate still images with expressive movement and natural expression replication.\",\"avatar-feature-4-title\":\"Up to 10 Minutes\",\"avatar-feature-4-desc\":\"Generate avatar videos up to 10 minutes long with InfiniteTalk, or 120s with WAN Animate.\",\"avatar-faq-1-q\":\"Is WaveSpeed AI Avatar Generator free to use?\",\"avatar-faq-1-a\":\"Yes! You get free credits when you sign up. Avatar generation costs vary by model, resolution, and duration — starting from just a few cents per clip.\",\"avatar-faq-2-q\":\"What types of avatar videos can I create?\",\"avatar-faq-2-a\":\"You can create talking avatars (photo + audio), lip-synced videos (video + audio), character animations (image + motion video), and motion-controlled videos.\",\"avatar-faq-3-q\":\"What inputs do I need?\",\"avatar-faq-3-a\":\"Each model requires different inputs: InfiniteTalk needs a photo and audio file, WAN Animate needs an image and reference video, and Kling Motion Control needs a character image and motion clip.\",\"avatar-faq-4-q\":\"What resolutions are supported?\",\"avatar-faq-4-a\":\"Most models support 480p and 720p output. The output quality depends on the input resolution and the selected model.\",\"avatar-faq-5-q\":\"How long can the generated videos be?\",\"avatar-faq-5-a\":\"InfiniteTalk supports videos up to 10 minutes. WAN Animate supports up to 120 seconds. Duration varies by model.\",\"avatar-faq-6-q\":\"Can I use my own audio for lip-sync?\",\"avatar-faq-6-a\":\"Yes! InfiniteTalk accepts any audio file — speech, singing, or narration — and generates realistic lip-sync from it.\",\"avatar-model-infinitetalk-name\":\"InfiniteTalk\",\"avatar-model-infinitetalk-desc\":\"Converts one photo + audio into audio-driven talking or singing avatar videos, up to 10 minutes at 720p.\",\"avatar-model-infinitetalk-v2v-name\":\"InfiniteTalk V2V\",\"avatar-model-infinitetalk-v2v-desc\":\"Audio-driven video-to-video lip-sync — takes an existing video and new audio to create realistic talking videos.\",\"avatar-model-wan-2-2-animate-name\":\"WAN 2.2 Animate\",\"avatar-model-wan-2-2-animate-desc\":\"Alibaba's unified character animation \u0026 replacement model, replicating movement and expression up to 720p and 120s.\",\"avatar-model-kling-3-0-motion-control-name\":\"Kling 3.0 Motion Control\",\"avatar-model-kling-3-0-motion-control-desc\":\"Kuaishou's latest Std/Pro motion transfer with shot type control, 3–30s reference clips, and intelligent framing.\",\"avatar-model-kling-2-6-motion-control-name\":\"Kling 2.6 Motion Control\",\"avatar-model-kling-2-6-motion-control-desc\":\"Kuaishou's Std/Pro motion transfer model — animate still images with dance, action, or gesture reference clips.\",\"avatar-model-steady-dancer-name\":\"SteadyDancer\",\"avatar-model-steady-dancer-desc\":\"14B-parameter human image animation framework with first-frame preservation, identity consistency, and temporal coherence for realistic dance videos.\",\"avatar-model-face-swapper-name\":\"Face Swapper\",\"avatar-model-face-swapper-desc\":\"Instantly swap faces in photos or videos with no watermark. Supports multi-face targeting and multiple output formats.\",\"three-d-page-title\":\"AI 3D Generator — Image, Text \u0026 Sketch to 3D\",\"three-d-page-subtitle\":\"Generate production-ready 3D models from images, text, or sketches with cutting-edge AI. PBR materials, clean topology, and multiple output formats — all free to start.\",\"three-d-cta-subtitle\":\"Start generating 3D models for free. No credit card required.\",\"three-d-feature-1-title\":\"9 AI Models\",\"three-d-feature-1-desc\":\"Tripo3D, Hunyuan3D, Hyper3D Rodin — each optimized for different 3D generation needs.\",\"three-d-feature-2-title\":\"Multiple Inputs\",\"three-d-feature-2-desc\":\"Generate from photos, multi-view images, text prompts, or hand-drawn sketches.\",\"three-d-feature-3-title\":\"PBR Materials\",\"three-d-feature-3-desc\":\"Production-ready textures for Unity, Unreal, Blender, and other 3D applications.\",\"three-d-feature-4-title\":\"Live 3D Preview\",\"three-d-feature-4-desc\":\"Interactive 3D viewer with orbit controls — inspect your models right in the browser.\",\"three-d-faq-1-q\":\"Is WaveSpeed AI 3D Generator free to use?\",\"three-d-faq-1-a\":\"Yes! You get free credits when you sign up. 3D generation costs vary by model and complexity.\",\"three-d-faq-2-q\":\"What input types are supported?\",\"three-d-faq-2-a\":\"You can generate 3D models from a single image, multiple view images (front/back/left/right), text descriptions, or hand-drawn sketches depending on the model.\",\"three-d-faq-3-q\":\"What 3D output formats are available?\",\"three-d-faq-3-a\":\"Most models output GLB (GLTF binary). Hyper3D Rodin also supports FBX, OBJ, STL, and USDZ formats.\",\"three-d-faq-4-q\":\"Can I preview 3D models in the browser?\",\"three-d-faq-4-a\":\"Yes! GLB outputs are rendered with an interactive 3D viewer — rotate, zoom, and inspect your models directly in the gallery.\",\"three-d-faq-5-q\":\"What are PBR materials?\",\"three-d-faq-5-a\":\"PBR (Physically-Based Rendering) materials include albedo, metallic, roughness, and normal maps for realistic rendering in game engines and 3D applications.\",\"three-d-model-tripo3d-image-to-3d-name\":\"Tripo3D 2.5 Image-to-3D\",\"three-d-model-tripo3d-image-to-3d-desc\":\"Convert a single image into high-quality 3D assets with clean geometry and textures.\",\"three-d-model-tripo3d-multiview-to-3d-name\":\"Tripo3D 2.5 Multiview-to-3D\",\"three-d-model-tripo3d-multiview-to-3d-desc\":\"Create 3D models from 4 view images (front, back, left, right) for more accurate reconstruction.\",\"three-d-model-hunyuan3d-3-1-image-rapid-name\":\"Hunyuan3D 3.1 Image-to-3D Rapid\",\"three-d-model-hunyuan3d-3-1-image-rapid-desc\":\"Fast image-to-3D generation from Tencent, quickly converting 2D images into 3D models.\",\"three-d-model-hunyuan3d-3-1-text-rapid-name\":\"Hunyuan3D 3.1 Text-to-3D Rapid\",\"three-d-model-hunyuan3d-3-1-text-rapid-desc\":\"Fast text-to-3D generation, creating 3D models from text descriptions in seconds.\",\"three-d-model-hunyuan3d-3-image-name\":\"Hunyuan3D 3 Image-to-3D\",\"three-d-model-hunyuan3d-3-image-desc\":\"Ultra-high-resolution 3D with PBR textures, multi-view input, and configurable mesh topology.\",\"three-d-model-hunyuan3d-3-sketch-name\":\"Hunyuan3D 3 Sketch-to-3D\",\"three-d-model-hunyuan3d-3-sketch-desc\":\"Convert hand-drawn sketches and concept art into detailed 3D models with textures.\",\"three-d-model-hunyuan3d-3-text-name\":\"Hunyuan3D 3 Text-to-3D\",\"three-d-model-hunyuan3d-3-text-desc\":\"Generate fully-textured 3D models from text with PBR materials, ready for Unity/Unreal/Blender.\",\"three-d-model-meshy-6-image-name\":\"Meshy 6 Image-to-3D\",\"three-d-model-meshy-6-image-desc\":\"High-quality image-to-3D with accurate geometry, PBR materials, symmetry control, and remeshing.\",\"three-d-model-meshy-6-text-name\":\"Meshy 6 Text-to-3D\",\"three-d-model-meshy-6-text-desc\":\"Generate 3D models from text with realistic or sculpture art styles, prompt expansion, and PBR support.\",\"three-d-model-hyper3d-rodin-2-image-name\":\"Hyper3D Rodin 2 Image-to-3D\",\"three-d-model-hyper3d-rodin-2-image-desc\":\"Production-ready 3D from images with clean topology, UVs, and textures. Up to 5 input images.\",\"three-d-model-hyper3d-rodin-2-text-name\":\"Hyper3D Rodin 2 Text-to-3D\",\"three-d-model-hyper3d-rodin-2-text-desc\":\"Generate production-ready 3D assets from text prompts with clean meshes and PBR textures.\",\"click-to-load3-d\":\"Click to load 3D model\",\"why-choose-heading\":\"Why Choose WaveSpeedAI\",\"supported-models-heading\":\"Supported AI Models\",\"faq-heading\":\"Frequently Asked Questions\",\"explore-models-card-title\":\"Explore 1,000+ AI Models\",\"explore-models-card-desc\":\"Browse our full catalog of state-of-the-art AI models — image, video, 3D, audio, LLM, and more.\",\"build-api-card-title\":\"Build with the API\",\"build-api-card-desc\":\"Integrate AI into your own apps. RESTful API with client libraries — no cold starts, pay per use.\",\"cta-heading-default\":\"Ready to Create?\",\"my-generations\":\"My Generations\",\"examples\":\"Examples\",\"show-history\":\"Show history\",\"hide-history\":\"Hide history\",\"no-examples-available\":\"No examples available for this model\",\"loading-generations\":\"Loading your generations...\",\"more\":\"More\",\"outputs-stored7-days\":\"Outputs are stored for 7 days.\",\"data-retention-policy\":\"Data Retention Policy\",\"empty-title-default\":\"No generations yet\",\"empty-description-default\":\"Enter a prompt and click Generate to create your first generation\",\"sign-in-to-start-generating\":\"Sign in to start generating\",\"create-free-acc